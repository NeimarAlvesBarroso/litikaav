---

const pathname = Astro.url.pathname;

---

<header class="header">

  <div class="inner">

    <!-- LOGO -->
    <a href="/" class="logo">
      LÍTIKA AV
    </a>

    <!-- NAV DESKTOP -->
    <nav class="nav">
      <a href="/" class={pathname === "/" ? "active" : ""}>home</a>
      <a href="/sobre" class={pathname === "/sobre" ? "active" : ""}>sobre</a>
      <a href="/projetos" class={pathname === "/projetos" ? "active" : ""}>projetos</a>
      <a href="/contato" class={pathname === "/contato" ? "active" : ""}>contato</a>
    </nav>

    <!-- BOTÃO MOBILE -->
    <button class="menu-toggle" aria-label="Abrir menu" onclick="toggleMenu()">
      ☰
    </button>

  </div>

  <!-- MENU MOBILE -->
  <div class="mobile-menu" id="mobileMenu">
    <a href="/">home</a>
    <a href="/sobre">sobre</a>
    <a href="/projetos">projetos</a>
    <a href="/contato">contato</a>
  </div>

</header>

<script>
  function toggleMenu() {
    const menu = document.getElementById('mobileMenu');
    menu.classList.toggle('active');
  }

  // fechar ao clicar fora
  document.addEventListener('click', (e) => {
    const menu = document.getElementById('mobileMenu');
    const toggle = document.querySelector('.menu-toggle');

    if (!menu.contains(e.target) && !toggle.contains(e.target)) {
      menu.classList.remove('active');
    }
  });
</script>

<style>

/* HEADER BASE */
.header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 70px;

  z-index: 999;

  /* CAMADA DINÂMICA (funciona sobre vídeo) */
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,0.8),
    rgba(0,0,0,0.4),
    transparent
  );

  backdrop-filter: blur(6px);
}

/* CONTAINER */
.inner {
  max-width: 1200px;
  margin: 0 auto;
  height: 100%;

  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 0 1.5rem;
}

/* LOGO */
.logo {
  font-size: 0.85rem;
  letter-spacing: 4px;
  color: white;
  text-decoration: none;

  opacity: 0.85;
  transition: 0.3s;
}

.logo:hover {
  opacity: 1;
}

/* NAV */
.nav {
  display: flex;
  gap: 2rem;
}

/* LINKS */
.nav a {
  position: relative;

  text-decoration: none;
  color: rgba(255,255,255,0.6);

  font-size: 0.8rem;
  letter-spacing: 2px;

  transition: 0.3s;
}

/* HOVER */
.nav a:hover {
  color: white;
}

/* UNDERLINE SUAVE */
.nav a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -4px;

  width: 0%;
  height: 1px;

  background: white;
  transition: 0.3s;
}

.nav a:hover::after {
  width: 100%;
}

/* LINK ATIVO */
.nav a.active {
  color: white;
}

.nav a.active::after {
  width: 100%;
}

/* BOTÃO MOBILE */
.menu-toggle {
  display: none;
  background: none;
  border: none;

  font-size: 1.4rem;
  color: white;
  cursor: pointer;
}

/* MENU MOBILE */
.mobile-menu {
  position: absolute;
  top: 70px;
  left: 0;
  width: 100%;

  background: rgba(0,0,0,0.95);

  display: flex;
  flex-direction: column;
  align-items: center;

  max-height: 0;
  overflow: hidden;

  transition: max-height 0.4s ease;
}

/* LINKS MOBILE */
.mobile-menu a {
  padding: 1.2rem;
  text-decoration: none;
  color: #aaa;
  width: 100%;
  text-align: center;

  letter-spacing: 2px;
  font-size: 0.85rem;
}

.mobile-menu a:hover {
  color: white;
}

/* ATIVO */
.mobile-menu.active {
  max-height: 400px;
}

/* RESPONSIVO */
@media (max-width: 768px) {

  .nav {
    display: none;
  }

  .menu-toggle {
    display: block;
  }

}

</style>