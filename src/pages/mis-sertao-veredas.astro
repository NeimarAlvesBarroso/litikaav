---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="MIS Sertão Veredas — Litika AV">

<main class="campo">

  <!-- FUNDO VÍDEO -->
  <div class="bg-video">

    <iframe
      src="https://www.facebook.com/plugins/video.php?href=https://www.facebook.com/reel/340982743118955/&show_text=false&autoplay=true&mute=1"
      frameborder="0"
      allowfullscreen
      allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share">
    </iframe>

  </div>

  <!-- OVERLAY -->
  <div class="overlay"></div>

  <!-- PLAYER -->
  <div class="player-cinema">

    <iframe
      src="https://www.youtube.com/embed/XYsjdyzSYK8?autoplay=1&mute=1&controls=1&loop=1&playlist=XYsjdyzSYK8"
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen>
    </iframe>

  </div>

  <!-- HERO -->
  <section class="hero">

    <span class="assinatura">
      rede missa • arqueologia audiovisual • sertão mineiro
    </span>

    <h1>MIS SERTÃO VEREDAS</h1>

    <div class="linha"></div>

    <p class="manifesto">
      museu da imagem e do som de cordisburgo •
      joão guimarães rosa • peter lund • gruta de maquiné •
      arqueologia • paleontologia • memória audiovisual
    </p>

  </section>

  <!-- INTRO -->
  <section class="intro">

    <div class="texto">

      <h2>
        O SEGUNDO PROTÓTIPO DA ARQUITETURA MISSA
      </h2>

      <p>
        O MIS Sertão Veredas é um núcleo experimental da arquitetura MISSA,
        desenvolvido em Cordisburgo,
        cidade natal de João Guimarães Rosa,
        território central da memória sertaneja brasileira.
      </p>

      <p>
        O projeto nasce como expansão do ecossistema audiovisual vetorialético,
        articulando cinema, arqueologia,
        literatura, paleontologia,
        patrimônio natural e documentação territorial.
      </p>

      <p>
        A pesquisa inclui registros fotográficos,
        documentário original
        e levantamento visual contínuo do território,
        compreendido como campo ativo de memória cultural.
      </p>

      <div class="camadas">

        <span>documentário</span>
        <span>arqueologia visual</span>
        <span>sertão mineiro</span>
        <span>gruta de maquiné</span>
        <span>memória territorial</span>
        <span>fotografia documental</span>

      </div>

    </div>

    <!-- PAINEL -->
    <div class="painel">

      <div class="janela">

        <span>território</span>

        <strong>
          cordisburgo • minas gerais
        </strong>

      </div>

      <div class="janela">

        <span>estrutura</span>

        <strong>
          museu da imagem e do som experimental
        </strong>

      </div>

      <div class="janela">

        <span>campo</span>

        <strong>
          arqueologia • paleontologia • audiovisual
        </strong>

      </div>

    </div>

  </section>

  <!-- GRID -->
  <section class="grid-conceitos">

    <!-- ROSA -->
    <div class="card">

      <div class="icone">✦</div>

      <h3>JOÃO GUIMARÃES ROSA</h3>

      <p>
        O território do MIS Sertão Veredas
        é atravessado pela presença literária
        e filosófica de João Guimarães Rosa,
        cuja obra transformou o sertão
        em estrutura universal de linguagem.
      </p>

    </div>

    <!-- PETER LUND -->
    <div class="card">

      <div class="icone">◉</div>

      <h3>PETER LUND</h3>

      <p>
        Cordisburgo integra o campo histórico das pesquisas
        do naturalista dinamarquês Peter Lund,
        pioneiro da paleontologia e arqueologia científica no Brasil.
      </p>

      <p>
        Seus estudos levaram à descoberta
        de alguns dos fósseis humanos mais antigos das Américas.
      </p>

    </div>

    <!-- MAQUINÉ -->
    <div class="card">

      <div class="icone">≈</div>

      <h3>GRUTA DE MAQUINÉ</h3>

      <p>
        Um dos mais importantes sítios geológicos
        e arqueológicos do Brasil,
        articulando cavernas calcárias,
        registros paleontológicos
        e patrimônio científico internacional.
      </p>

    </div>

    <!-- MISSA -->
    <div class="card">

      <div class="icone">⌘</div>

      <h3>ARQUITETURA MISSA</h3>

      <p>
        O projeto integra a plataforma MISSA,
        ecossistema de museologia audiovisual
        voltado à implantação de museus digitais
        em cidades do interior.
      </p>

    </div>

    <!-- EDUCAÇÃO -->
    <div class="card">

      <div class="icone">∞</div>

      <h3>EDUCAÇÃO CIENTÍFICA</h3>

      <p>
        O MIS Sertão Veredas propõe formação territorial
        em fotografia, cinema,
        documentação cultural,
        arqueologia visual
        e memória científica.
      </p>

    </div>

    <!-- INVESTIMENTO -->
    <div class="card">

      <div class="icone">▣</div>

      <h3>ATIVO CULTURAL</h3>

      <p>
        O projeto encontra-se em processo de expansão,
        aberto a investidores,
        universidades,
        instituições culturais
        e programas internacionais de patrimônio.
      </p>

    </div>

  </section>

  <!-- FLUXO -->
  <section class="fluxo">

    <div class="box">

      <h2>
        O SERTÃO COMO INFRAESTRUTURA CULTURAL
      </h2>

      <p>
        O MIS Sertão Veredas compreende o território
        não apenas como paisagem,
        mas como sistema de memória,
        linguagem e inteligência geológica.
      </p>

      <p>
        Cinema, arqueologia,
        fotografia e literatura
        tornam-se instrumentos de reorganização territorial,
        educação científica
        e ativação econômica baseada em cultura e conhecimento.
      </p>

    </div>

  </section>

  <!-- LINKS -->
  <section class="links">

    <a
      href="https://www.facebook.com/misertaoveredas"
      target="_blank"
      class="link-box"
    >
      facebook oficial
    </a>

    <a
      href="/missa"
      class="link-box"
    >
      plataforma missa
    </a>

    <a
      href="/mic"
      class="link-box"
    >
      museu da ilustração científica
    </a>

  </section>

  <!-- GALERIA -->
  <section class="galeria">

    <div class="titulo-area">

      <h2>CAMPO VISUAL</h2>

      <p>
        registros do sertão • memória • geologia • território
      </p>

    </div>

    <div class="grid-imagens">
      <img src="/imagens/mis-sertao-veredas/veredas1.jpg" alt="MIS Sertão Veredas" />
      <img src="/imagens/mis-sertao-veredas/maquine.jpg" alt="MIS Sertão Veredas" />
      <img src="/imagens/mis-sertao-veredas/rosa.jpg" alt="MIS Sertão Veredas" />
      <img src="/imagens/mis-sertao-veredas/veredas2.jpg" alt="MIS Sertão Veredas" />
      <img src="/imagens/mis-sertao-veredas/neimar.jpg" alt="MIS Sertão Veredas" />
      <img src="/imagens/mis-sertao-veredas/neimar1.jpg" alt="MIS Sertão Veredas" />
         <img src="/imagens/mis-sertao-veredas/veredas4.jpg" alt="MIS Sertão Veredas" />
      <img src="/imagens/mis-sertao-veredas/veredas6.jpg" alt="MIS Sertão Veredas" />
      
    </div>

  </section>

  <!-- RODAPÉ -->
  <footer class="rodape">

    <a href="javascript:history.back()" class="voltar">
      ← voltar
    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV LTDA.
      </span>

      <p>
        audiovisual • arqueologia visual • vetorialética • memória territorial
      </p>

    </div>

  </footer>

</main>

</BaseLayout>

<style>

/* BASE */

.campo{
  position:relative;
  min-height:100vh;
  overflow:hidden;
  background:black;
  color:white;
  padding-bottom:8rem;
}

/* BG VIDEO */

.bg-video{
  position:fixed;
  inset:0;
  z-index:-4;
  overflow:hidden;
}

.bg-video iframe{
  width:100vw;
  height:100vh;
  object-fit:cover;
  opacity:0.18;
  pointer-events:none;
}

/* OVERLAY */

.overlay{
  position:fixed;
  inset:0;
  z-index:-3;

  background:
    radial-gradient(circle at center,
    rgba(140,90,20,0.18),
    rgba(0,0,0,0.94));
}

/* PLAYER */

.player-cinema{
  position:fixed;
  top:90px;
  left:20px;

  width:240px;
  height:135px;

  z-index:50;

  overflow:hidden;

  border-radius:16px;

  border:1px solid rgba(255,255,255,0.08);

  background:rgba(0,0,0,0.55);

  backdrop-filter:blur(12px);
}

.player-cinema iframe{
  width:100%;
  height:100%;
}

/* HERO */

.hero{
  min-height:100vh;

  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;

  text-align:center;

  padding:2rem;
}

.assinatura{
  color:#d4b46d;

  letter-spacing:4px;

  font-size:0.7rem;

  text-transform:uppercase;
}

.hero h1{
  font-size:clamp(3rem,8vw,7rem);

  margin:1.5rem 0;

  letter-spacing:8px;

  color:#f5e6c8;

  text-shadow:
    0 0 40px rgba(214,185,107,0.18);
}

.linha{
  width:220px;
  height:1px;

  margin:1.5rem 0;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(214,185,107,0.8),
      transparent
    );
}

.manifesto{
  max-width:900px;

  color:#b9ab8d;

  line-height:1.9;

  letter-spacing:1px;
}

/* INTRO */

.intro{
  max-width:1300px;

  margin:0 auto;

  display:grid;
  grid-template-columns:1.2fr 0.8fr;

  gap:2rem;

  padding:0 8%;
}

.texto,
.janela,
.card,
.box,
.link-box{
  background:
    linear-gradient(
      145deg,
      rgba(25,18,10,0.7),
      rgba(5,5,5,0.92)
    );

  border:1px solid rgba(255,255,255,0.05);

  backdrop-filter:blur(14px);

  border-radius:24px;
}

.texto{
  padding:2.5rem;
}

.texto h2{
  color:#f5e6c8;

  margin-bottom:1.5rem;

  letter-spacing:3px;
}

.texto p{
  color:#b8aa8d;

  line-height:1.9;

  margin-bottom:1.3rem;
}

/* CAMADAS */

.camadas{
  display:flex;
  flex-wrap:wrap;
  gap:1rem;

  margin-top:2rem;
}

.camadas span{
  padding:0.8rem 1.2rem;

  border-radius:999px;

  background:
    rgba(214,185,107,0.08);

  border:
    1px solid rgba(214,185,107,0.15);

  color:#e4c88b;

  font-size:0.75rem;

  letter-spacing:1px;
}

/* PAINEL */

.painel{
  display:flex;
  flex-direction:column;
  gap:1.5rem;
}

.janela{
  padding:1.7rem;
}

.janela span{
  display:block;

  color:#9c8454;

  margin-bottom:0.7rem;

  text-transform:uppercase;

  font-size:0.7rem;

  letter-spacing:2px;
}

.janela strong{
  color:#f5e6c8;

  line-height:1.7;
}

/* GRID */

.grid-conceitos{
  max-width:1400px;

  margin:7rem auto 0;

  padding:0 8%;

  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(280px,1fr));

  gap:2rem;
}

/* CARD */

.card{
  padding:2rem;

  transition:0.45s;

  position:relative;

  overflow:hidden;
}

.card::before{
  content:"";

  position:absolute;
  inset:0;

  background:
    radial-gradient(circle at top left,
    rgba(214,185,107,0.12),
    transparent);

  opacity:0;

  transition:0.5s;
}

.card:hover::before{
  opacity:1;
}

.card:hover{
  transform:
    translateY(-10px)
    scale(1.02);

  border-color:#d6b96b;

  box-shadow:
    0 0 40px rgba(214,185,107,0.12);
}

.icone{
  font-size:2.4rem;

  color:#d6b96b;

  margin-bottom:1.5rem;
}

.card h3{
  color:#f5e6c8;

  margin-bottom:1rem;

  letter-spacing:2px;
}

.card p{
  color:#b8aa8d;

  line-height:1.8;

  margin-bottom:1rem;
}

/* FLUXO */

.fluxo{
  max-width:1100px;

  margin:8rem auto 0;

  padding:0 8%;
}

.box{
  padding:3rem;

  text-align:center;
}

.box h2{
  color:#f5e6c8;

  letter-spacing:4px;

  margin-bottom:2rem;
}

.box p{
  color:#b9ab8d;

  line-height:1.9;

  max-width:850px;

  margin:0 auto 1.5rem;
}

/* LINKS */

.links{
  margin-top:5rem;

  display:flex;
  justify-content:center;
  flex-wrap:wrap;

  gap:1.5rem;

  padding:0 8%;
}

.link-box{
  padding:1rem 1.6rem;

  text-decoration:none;

  color:#d6b96b;

  letter-spacing:2px;

  transition:0.35s;
}

.link-box:hover{
  transform:translateY(-4px);

  border-color:#d6b96b;

  background:
    rgba(214,185,107,0.08);
}

/* GALERIA */

.galeria{
  margin-top:7rem;

  padding:0 8%;
}

.titulo-area{
  text-align:center;

  margin-bottom:3rem;
}

.titulo-area h2{
  color:#f5e6c8;

  letter-spacing:4px;

  margin-bottom:1rem;
}

.titulo-area p{
  color:#8f7a53;
}

.grid-imagens{
  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(260px,1fr));

  gap:1.2rem;
}

.grid-imagens img{
  width:100%;
  height:260px;

  object-fit:cover;

  border-radius:18px;

  filter:
    grayscale(100%)
    brightness(0.7);

  transition:0.6s;

  border:1px solid rgba(255,255,255,0.05);
}

.grid-imagens img:hover{
  transform:scale(1.03);

  filter:
    grayscale(0%)
    brightness(1);

  border-color:#d6b96b;
}

/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:7rem;
  padding-top:3rem;

  display:flex;
  flex-direction:column;
  align-items:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

.voltar{
  text-decoration:none;

  color:#d6b96b;

  border:
    1px solid rgba(214,185,107,0.2);

  padding:0.9rem 1.6rem;

  border-radius:999px;

  letter-spacing:2px;
  font-size:0.75rem;

  transition:0.35s;

  background:
    rgba(214,185,107,0.05);
}

.voltar:hover{
  background:#d6b96b;
  color:black;

  transform:translateY(-3px);
}

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:#f5e6c8;

  letter-spacing:4px;

  font-size:0.75rem;

  margin-bottom:0.8rem;
}

.assinatura-final p{
  color:#7d7156;

  font-size:0.72rem;

  letter-spacing:1px;
}

/* RESPONSIVO */

@media(max-width:900px){

  .intro{
    grid-template-columns:1fr;
  }

}

@media(max-width:700px){

  .player-cinema{
    width:180px;
    height:100px;
  }

}

@media(max-width:500px){

  .player-cinema{
    position:relative;

    top:0;
    left:0;

    margin:1rem auto 2rem;
  }

  .hero h1{
    letter-spacing:4px;
  }

}

</style>