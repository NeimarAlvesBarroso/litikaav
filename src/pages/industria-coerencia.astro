---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Indústria da Coerência — Litika AV">

<main class="industria">
<main class="campo">

  <!-- BOTÃO FLUTUANTE -->
  <a href="javascript:history.back()" class="voltar-flutuante">
    ← voltar
  </a>

  <!-- FUNDO RESSONANTE -->
  <div class="bg"></div>
  <div class="noise"></div>

  <!-- PLAYER -->
  <div class="player-radio">
    <iframe
      src="https://www.youtube.com/embed/2n3XGGI0Uns?autoplay=1&mute=1&controls=1&loop=1&playlist=2n3XGGI0Uns"
      title="Rádio Vetorialética"
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen
    ></iframe>
  </div>

  <!-- HERO -->
  <section class="hero">

    <span class="assinatura">
      tecnologias vetorialéticas emergentes
    </span>

    <h1>INDÚSTRIA DA COERÊNCIA</h1>

    <div class="linha"></div>

    <p class="manifesto">
      estruturas contínuas • inteligência ressonante • engenharia simbiótica •
      computação viva • reorganização material do século XXI
    </p>

  </section>

  <!-- INTRO -->
  <section class="intro">

    <div class="texto">

      <h2>
        UMA NOVA MATRIZ INDUSTRIAL
      </h2>

      <p>
        A Indústria da Coerência é um núcleo experimental da Vetorialética
        voltado ao desenvolvimento de tecnologias estruturadas por campos
        contínuos, organização ressonante e inteligência distribuída.
      </p>

      <p>
        O projeto articula conceitos de robótica, semicondutores,
        computação viva, sistemas atmosféricos, motores,
        comunicação submarina e inteligência artificial vetorialética.
      </p>

      <p>
        Os estudos apresentados funcionam como ativos conceituais,
        arquiteturas tecnológicas emergentes e propostas de pesquisa
        abertas a universidades, investidores, laboratórios,
        fundos estratégicos e desenvolvimento industrial.
      </p>

    </div>

    <div class="painel">

      <div class="janela">
        <span>campo</span>
        <strong>
          tecnologias contínuas e sistemas ressonantes
        </strong>
      </div>

      <div class="janela">
        <span>modelo</span>
        <strong>
          pesquisa vetorialética aplicada
        </strong>
      </div>

      <div class="janela">
        <span>objetivo</span>
        <strong>
          transformar teoria em infraestrutura tecnológica
        </strong>
      </div>

    </div>

  </section>

  <!-- GRID TECNOLOGIAS -->
  <section class="grid-tech">

    <!-- ROBÓTICA -->
    <a
      href="https://www.academia.edu/130339336/ROB%C3%93TICA_VETORIAL%C3%89TICA_Corpos_Simbi%C3%B3ticos_e_Intelig%C3%AAncias_Ressonantes_no_Campo_Cont%C3%ADnuo"
      target="_blank"
      class="card"
    >
      <div class="icone">◎</div>

      <h3>ROBÓTICA VETORIALÉTICA</h3>

      <p>
        corpos simbióticos, inteligência ressonante
        e estruturas contínuas de interação.
      </p>

      <span>acessar estudo →</span>
    </a>

    <!-- GRAFENO -->
    <a
      href="https://www.academia.edu/143131985/Grafeno_Computa%C3%A7%C3%A3o_Viva_e_Estruturas_Conscientes"
      target="_blank"
      class="card"
    >
      <div class="icone">⬡</div>

      <h3>GRAFENO COMPUTAÇÃO VIVA</h3>

      <p>
        estruturas conscientes, computação material
        e inteligência distribuída em grafeno.
      </p>

      <span>acessar estudo →</span>
    </a>

    <!-- DRONE -->
    <a
      href="https://www.academia.edu/142988807/Drone_Reator_de_Chuva"
      target="_blank"
      class="card"
    >
      <div class="icone">◉</div>

      <h3>DRONE REATOR DE CHUVA</h3>

      <p>
        modulação atmosférica,
        resfriamento climático e engenharia hídrica.
      </p>

      <span>acessar estudo →</span>
    </a>

    <!-- MINERAÇÃO -->
    <a
      href="https://www.academia.edu/142988807/Drone_Reator_de_Chuva"
      target="_blank"
      class="card"
    >
      <div class="icone">⬢</div>

      <h3>MINERAÇÃO VETORIALÉTICA</h3>

      <p>
        reorganização mineral,
        impacto reduzido e geologia inteligente.
      </p>

      <span>acessar estudo →</span>
    </a>

    <!-- IA -->
    <a
      href="https://www.academia.edu/144692992/Intelig%C3%AAncia_Artificial_Vetorial%C3%A9tica_IAV_"
      target="_blank"
      class="card"
    >
      <div class="icone">◌</div>

      <h3>IAV</h3>

      <p>
        inteligência artificial vetorialética,
        coerência simbiótica e aprendizado contínuo.
      </p>

      <span>acessar estudo →</span>
    </a>

    <!-- SUBMARINO -->
    <a
      href="https://www.academia.edu/142925899/Infraestrutura_Vetorial%C3%A9tica_para_Comunica%C3%A7%C3%A3o_Submarina_RAVeS_CONCEITOS_PRELIMINARES"
      target="_blank"
      class="card"
    >
      <div class="icone">≈</div>

      <h3>RAVeS</h3>

      <p>
        infraestrutura vetorialética
        para comunicação submarina.
      </p>

      <span>acessar estudo →</span>
    </a>

    <!-- MOTORES -->
    <a
      href="https://www.academia.edu/144901696/Motores_Vetorial%C3%A9ticos_4_Estudos"
      target="_blank"
      class="card"
    >
      <div class="icone">✦</div>

      <h3>MOTORES VETORIALÉTICOS</h3>

      <p>
        dinâmica contínua,
        fluxo coerente e propulsão ressonante.
      </p>

      <span>acessar estudo →</span>
    </a>

    <!-- SEMICONDUTOR -->
    <a
      href="https://www.academia.edu/145819553/_MANUAL_TE%C3%93RICO_T%C3%89CNICO_DE_FABRICA%C3%87%C3%83O_DO_SEMICONDUTOR_VETORIAL%C3%89TICO_Arquitetura_de_Campo_Geometria_de_Decis%C3%A3o_e_%C3%89tica_Industrial_para_o_S%C3%A9culo_XXI"
      target="_blank"
      class="card"
    >
      <div class="icone">▣</div>

      <h3>SEMICONDUTOR VETORIALÉTICO</h3>

      <p>
        arquitetura de campo,
        geometria decisória e ética industrial.
      </p>

      <span>acessar estudo →</span>
    </a>

    <!-- DESKTOP -->
    <a
      href="https://www.academia.edu/146041223/Estrutura_Te%C3%B3rica_e_de_Implementa%C3%A7%C3%A3o_do_Desktop_Vetorial%C3%A9tico"
      target="_blank"
      class="card"
    >
      <div class="icone">⌘</div>

      <h3>DESKTOP VETORIALÉTICO</h3>

      <p>
        ambiente computacional contínuo,
        inteligência operacional e UX ressonante.
      </p>

      <span>acessar estudo →</span>
    </a>

    <!-- INTERNET -->
    <a
      href="https://www.academia.edu/164963005/Internet_das_Presen%C3%A7as_Modelo_Vetorial%C3%A9tico_do_Colapso_Simbi%C3%B3tico"
      target="_blank"
      class="card"
    >
      <div class="icone">∞</div>

      <h3>INTERNET DAS PRESENÇAS</h3>

      <p>
        comunicação simbiótica,
        presença distribuída e redes contínuas.
      </p>

      <span>acessar estudo →</span>
    </a>

  </section>

  <!-- MANIFESTO -->
  <section class="manifesto-final">

    <div class="box">

      <h2>
        TEORIA → PROTÓTIPO → INFRAESTRUTURA
      </h2>

      <p>
        A Indústria da Coerência propõe uma transição
        entre pesquisa conceitual e aplicação material,
        organizando tecnologias emergentes
        como ecossistemas vivos de inteligência.
      </p>

      <p>
        O objetivo estratégico é construir uma nova engenharia
        baseada em coerência energética, integração simbiótica,
        computação contínua e reorganização vetorial do real.
      </p>

    </div>

  </section>

  <!-- RODAPÉ -->
  <footer class="rodape">

    <a href="javascript:history.back()" class="voltar">
      ← voltar
    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV
      </span>

      <p>
        vetorialética • engenharia da coerência • inteligência contínua
      </p>

    </div>

  </footer>

</main>

</BaseLayout>

<style>

/* BASE */

.industria{
  position:relative;
  min-height:100vh;
  overflow:hidden;
  background:black;
  color:white;
  padding:0 0 8rem;
}

/* BG */

.bg{
  position:fixed;
  inset:0;
  z-index:-3;

  background:
    radial-gradient(circle at top,
    rgba(60,90,180,0.18),
    rgba(0,0,0,0.96)),
    linear-gradient(180deg,#02040a,#000);
}

.noise{
  position:fixed;
  inset:0;
  z-index:-2;

  opacity:0.06;

  background-image:
    radial-gradient(#ffffff 0.5px, transparent 0.5px);

  background-size:4px 4px;
}

/* PLAYER */

.player-radio{
  position:fixed;
  top:90px;
  left:20px;

  width:240px;
  height:135px;

  z-index:50;

  overflow:hidden;

  border-radius:16px;

  border:1px solid rgba(255,255,255,0.08);

  background:rgba(0,0,0,0.55);

  backdrop-filter:blur(12px);
}

.player-radio iframe{
  width:100%;
  height:100%;
}

/* HERO */

.hero{
  min-height:100vh;

  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;

  text-align:center;

  padding:2rem;
}

.assinatura{
  color:#82a8ff;
  letter-spacing:4px;
  font-size:0.7rem;
  text-transform:uppercase;
}

.hero h1{
  font-size:clamp(3rem,8vw,7rem);

  margin:1.5rem 0;

  letter-spacing:8px;

  color:white;

  text-shadow:
    0 0 30px rgba(120,160,255,0.3);
}

.linha{
  width:220px;
  height:1px;

  margin:1.5rem 0;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(130,168,255,0.8),
      transparent
    );
}

.manifesto{
  max-width:850px;

  color:#9da8c7;

  line-height:1.9;

  letter-spacing:1px;
}

/* INTRO */

.intro{
  max-width:1300px;

  margin:0 auto;

  display:grid;
  grid-template-columns:1.2fr 0.8fr;

  gap:2rem;

  padding:0 8%;
}

.texto,
.janela,
.card,
.box{
  background:
    linear-gradient(
      145deg,
      rgba(18,24,40,0.72),
      rgba(4,4,8,0.95)
    );

  border:1px solid rgba(255,255,255,0.05);

  backdrop-filter:blur(14px);

  border-radius:24px;
}

.texto{
  padding:2.5rem;
}

.texto h2{
  color:white;
  margin-bottom:1.5rem;
  letter-spacing:3px;
}

.texto p{
  color:#b2bdd8;
  line-height:1.9;
  margin-bottom:1.3rem;
}

/* PAINEL */

.painel{
  display:flex;
  flex-direction:column;
  gap:1.5rem;
}

.janela{
  padding:1.7rem;
}

.janela span{
  display:block;

  color:#6f87ba;

  margin-bottom:0.7rem;

  text-transform:uppercase;

  font-size:0.7rem;

  letter-spacing:2px;
}

.janela strong{
  color:white;
  line-height:1.7;
}

/* GRID */

.grid-tech{
  max-width:1400px;

  margin:7rem auto 0;

  padding:0 8%;

  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(280px,1fr));

  gap:2rem;
}

/* CARD */

.card{
  position:relative;

  overflow:hidden;

  padding:2rem;

  text-decoration:none;

  transition:0.45s;
}

.card::before{
  content:"";

  position:absolute;
  inset:0;

  background:
    radial-gradient(circle at top left,
    rgba(120,160,255,0.12),
    transparent);

  opacity:0;

  transition:0.5s;
}

.card:hover::before{
  opacity:1;
}

.card:hover{
  transform:
    translateY(-10px)
    scale(1.02);

  border-color:#82a8ff;

  box-shadow:
    0 0 40px rgba(120,160,255,0.12);
}

.icone{
  font-size:2.5rem;

  color:#82a8ff;

  margin-bottom:1.5rem;
}

.card h3{
  color:white;

  margin-bottom:1rem;

  letter-spacing:2px;

  line-height:1.4;
}

.card p{
  color:#b3bdd3;

  line-height:1.8;

  margin-bottom:2rem;
}

.card span{
  color:#82a8ff;

  font-size:0.8rem;

  letter-spacing:2px;
}

/* MANIFESTO */

.manifesto-final{
  max-width:1100px;

  margin:8rem auto 0;

  padding:0 8%;
}

.box{
  padding:3rem;
  text-align:center;
}

.box h2{
  color:white;

  letter-spacing:4px;

  margin-bottom:2rem;
}

.box p{
  color:#b5c0da;

  line-height:1.9;

  max-width:850px;

  margin:0 auto 1.5rem;
}

/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:7rem;
  padding-top:3rem;

  display:flex;
  flex-direction:column;
  align-items:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

.voltar{
  text-decoration:none;

  color:#82a8ff;

  border:
    1px solid rgba(130,168,255,0.2);

  padding:0.9rem 1.6rem;

  border-radius:999px;

  letter-spacing:2px;
  font-size:0.75rem;

  transition:0.35s;

  background:
    rgba(130,168,255,0.05);
}

.voltar:hover{
  background:#82a8ff;
  color:black;

  transform:translateY(-3px);
}

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:white;

  letter-spacing:4px;

  font-size:0.75rem;

  margin-bottom:0.8rem;
}

.assinatura-final p{
  color:#6d7ba3;

  font-size:0.72rem;

  letter-spacing:1px;
}

/* RESPONSIVO */

@media(max-width:900px){

  .intro{
    grid-template-columns:1fr;
  }

}

@media(max-width:700px){

  .player-radio{
    width:180px;
    height:100px;
  }

}

@media(max-width:500px){

  .player-radio{
    position:relative;

    top:0;
    left:0;

    margin:1rem auto 2rem;
  }

  .hero h1{
    letter-spacing:4px;
  }

}
/* BOTÃO VOLTAR FLUTUANTE */

.voltar-flutuante{
  position:fixed;

  top:92px;
  right:24px;

  z-index:120;

  text-decoration:none;

  color:#d6b96b;

  font-size:0.74rem;
  letter-spacing:2px;
  text-transform:uppercase;

  padding:0.85rem 1.3rem;

  border-radius:999px;

  background:
    rgba(0,0,0,0.55);

  border:
    1px solid rgba(214,185,107,0.22);

  backdrop-filter:blur(12px);

  box-shadow:
    0 0 25px rgba(214,185,107,0.08);

  transition:0.35s ease;
}

/* HOVER */

.voltar-flutuante:hover{

  background:#d6b96b;
  color:black;

  transform:
    translateY(-2px)
    scale(1.03);

  box-shadow:
    0 0 35px rgba(214,185,107,0.25);
}

/* MOBILE */

@media(max-width:700px){

  .voltar-flutuante{
    top:200px;
    right:14px;

    font-size:0.68rem;

    padding:0.7rem 1rem;
  }

}

@media(max-width:500px){

  .voltar-flutuante{

    position:relative;

    top:0;
    right:0;

    margin-bottom:2rem;

    align-self:center;
  }

}
</style>