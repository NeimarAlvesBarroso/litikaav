---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Resfriamento Urbano — Litika AV">

<main class="clima">

  <!-- BOTÃO FLUTUANTE -->
  <a href="javascript:history.back()" class="voltar-flutuante">
    ← voltar
  </a>

  <!-- FUNDO -->
  <div class="bg"></div>
  <div class="aurora"></div>
  <div class="noise"></div>

  <!-- PLAYER -->
  <div class="player-radio">
    <iframe
      src="https://www.youtube.com/embed/2n3XGGI0Uns?autoplay=1&mute=1&controls=1&loop=1&playlist=2n3XGGI0Uns"
      title="Rádio Vetorialética"
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen
    ></iframe>
  </div>

  <!-- HERO -->
  <section class="hero">

    <span class="assinatura">
      engenharia climática vetorialética
    </span>

    <h1>RESFRIAMENTO URBANO</h1>

    <div class="linha"></div>

    <p class="manifesto">
      biomas • chuva • coerência atmosférica • monitoramento climático •
      resfriamento territorial • combate às mega ilhas de calor
    </p>

  </section>

  <!-- INTRO -->
  <section class="intro">

    <div class="texto">

      <h2>
        DIAGNÓSTICO VETORIALÉTICO DAS MEGA ILHAS DE CALOR
      </h2>

      <p>
        A Vetorialética compreende as grandes cidades contemporâneas
        como estruturas entrópicas capazes de alterar profundamente
        os fluxos atmosféricos, hidrológicos e energéticos dos biomas.
      </p>

      <p>
        Mega superfícies de concreto, asfaltamento extremo,
        verticalização desordenada, ausência de arborização,
        impermeabilização do solo e concentração energética
        criam campos térmicos artificiais que competem diretamente
        com os ciclos naturais de evapotranspiração.
      </p>

      <p>
        Na leitura vetorialética, essas estruturas funcionam como:
      </p>

      <div class="camadas">

        <span>reatores entrópicos</span>
        <span>zonas de ruptura hídrica</span>
        <span>desorganizadores atmosféricos</span>
        <span>campos de calor artificial</span>
        <span>bloqueadores de chuva</span>

      </div>

    </div>

    <div class="painel">

      <div class="janela">
        <span>foco</span>

        <strong>
          resfriamento urbano em escala territorial
        </strong>
      </div>

      <div class="janela">
        <span>objetivo</span>

        <strong>
          devolver coerência climática aos biomas
        </strong>
      </div>

      <div class="janela">
        <span>modelo</span>

        <strong>
          engenharia ambiental vetorialética
        </strong>
      </div>

    </div>

  </section>

  <!-- GRID -->
  <section class="grid-tech">

    <!-- BIOMAS -->
    <div class="card">

      <div class="icone">◉</div>

      <h3>BOMBAS BIÓTICAS</h3>

      <p>
        Os biomas funcionam como estruturas climáticas vivas,
        organizando umidade, temperatura e formação de chuva
        através da evapotranspiração vegetal.
      </p>

      <p>
        O desmatamento e o superaquecimento urbano
        interferem nesses fluxos de coerência atmosférica.
      </p>

    </div>

    <!-- MONITORAMENTO -->
    <div class="card">

      <div class="icone">▣</div>

      <h3>MONITORAMENTO CLIMÁTICO</h3>

      <p>
        Desenvolvimento de plataformas ambientais
        para leitura térmica territorial,
        sensores urbanos e análise vetorial de calor.
      </p>

      <p>
        Integração de satélites, drones,
        IA vetorialética e sistemas climáticos locais.
      </p>

    </div>

    <!-- ENGENHARIA -->
    <div class="card">

      <div class="icone">≈</div>

      <h3>ENGENHARIA CLIMÁTICA</h3>

      <p>
        Infraestruturas de resfriamento urbano,
        corredores vegetais,
        espelhos d’água,
        telhados frios e reorganização térmica.
      </p>

      <p>
        A cidade deixa de operar contra o clima
        e passa a atuar como organismo regulador.
      </p>

    </div>

    <!-- DRONES -->
    <div class="card">

      <div class="icone">✦</div>

      <h3>DRONES ATMOSFÉRICOS</h3>

      <p>
        Tecnologias experimentais de modulação climática
        e nucleação atmosférica associadas
        ao conceito de Drone Reator de Chuva.
      </p>

      <p>
        Sistemas pensados para mitigação térmica,
        regeneração hídrica e suporte bioclimático.
      </p>

    </div>

    <!-- CIDADES -->
    <div class="card">

      <div class="icone">⌘</div>

      <h3>NOVA ECONOMIA URBANA</h3>

      <p>
        O resfriamento urbano é tratado
        como infraestrutura estratégica,
        geradora de emprego,
        pesquisa, inovação e crédito climático.
      </p>

      <p>
        Pequenas cidades podem tornar-se
        laboratórios globais de regeneração ambiental.
      </p>

    </div>

    <!-- INVESTIMENTO -->
    <div class="card">

      <div class="icone">∞</div>

      <h3>FUNDOS ESTRATÉGICOS</h3>

      <p>
        Projetos voltados a fundos climáticos,
        bancos multilaterais,
        programas de carbono,
        universidades e cidades inteligentes.
      </p>

      <p>
        O objetivo é transformar resfriamento urbano
        em política pública planetária.
      </p>

    </div>

  </section>

  <!-- EIXOS -->
  <section class="eixos">

    <div class="titulo">

      <h2>
        EIXOS OPERACIONAIS
      </h2>

      <p>
        estruturas integradas para reorganização climática
      </p>

    </div>

    <div class="eixos-grid">

      <div class="eixo">
        <span>01</span>
        <h3>MAPEAMENTO TÉRMICO</h3>

        <p>
          leitura contínua das ilhas de calor urbanas.
        </p>
      </div>

      <div class="eixo">
        <span>02</span>
        <h3>ARBORIZAÇÃO ESTRATÉGICA</h3>

        <p>
          corredores verdes e reorganização bioclimática.
        </p>
      </div>

      <div class="eixo">
        <span>03</span>
        <h3>TECNOLOGIAS HÍDRICAS</h3>

        <p>
          retenção, infiltração e regeneração das águas.
        </p>
      </div>

      <div class="eixo">
        <span>04</span>
        <h3>IA CLIMÁTICA</h3>

        <p>
          inteligência vetorial aplicada ao clima urbano.
        </p>
      </div>

      <div class="eixo">
        <span>05</span>
        <h3>POLÍTICAS PÚBLICAS</h3>

        <p>
          planejamento climático e governança territorial.
        </p>
      </div>

      <div class="eixo">
        <span>06</span>
        <h3>CIDADES LABORATÓRIO</h3>

        <p>
          implementação experimental em municípios.
        </p>
      </div>

    </div>

  </section>

  <!-- MANIFESTO -->
  <section class="manifesto-final">

    <div class="box">

      <h2>
        DESARMAR OS REATORES ENTRÓPICOS
      </h2>

      <p>
        O século XXI exigirá uma nova engenharia territorial.
        O problema climático não é apenas energético.
        É estrutural, urbano, atmosférico e civilizacional.
      </p>

      <p>
        O resfriamento urbano vetorialético propõe
        reorganizar cidades como sistemas vivos,
        capazes de cooperar com os biomas,
        restaurar fluxos de chuva
        e reduzir colapsos térmicos extremos.
      </p>

      <p>
        Não se trata apenas de sustentabilidade.
        Trata-se de coerência planetária.
      </p>

    </div>

  </section>

  <!-- LINKS -->
  <section class="links">

    <a
      href="/industria-coerencia"
      class="link-box"
    >
      indústria da coerência
    </a>

    <a
      href="/ia-vetorialetica"
      class="link-box"
    >
      ia vetorialética
    </a>

    <a
      href="/pesquisa-vetorialetica"
      class="link-box"
    >
      portal vetorialética
    </a>

  </section>

  <!-- RODAPÉ -->
  <footer class="rodape">

    <a href="javascript:history.back()" class="voltar">
      ← voltar
    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV
      </span>

      <p>
        engenharia climática • vetorialética • regeneração territorial
      </p>

    </div>

  </footer>

</main>

</BaseLayout>

<style>

/* BASE */

.clima{
  position:relative;
  min-height:100vh;
  overflow:hidden;
  background:black;
  color:white;
  padding-bottom:8rem;
}

/* BG */

.bg{
  position:fixed;
  inset:0;
  z-index:-4;

  background:
    radial-gradient(circle at top,
    rgba(0,120,255,0.12),
    rgba(0,0,0,0.95)),
    linear-gradient(180deg,#020408,#000);
}

.aurora{
  position:fixed;
  inset:0;
  z-index:-3;

  background:
    radial-gradient(circle at 20% 20%,
    rgba(0,180,255,0.08),
    transparent 40%),

    radial-gradient(circle at 80% 40%,
    rgba(0,255,180,0.05),
    transparent 35%);
}

.noise{
  position:fixed;
  inset:0;
  z-index:-2;

  opacity:0.04;

  background-image:
    radial-gradient(#fff 0.5px, transparent 0.5px);

  background-size:4px 4px;
}

/* PLAYER */

.player-radio{
  position:fixed;
  top:90px;
  left:20px;

  width:240px;
  height:135px;

  z-index:50;

  overflow:hidden;

  border-radius:16px;

  border:1px solid rgba(255,255,255,0.08);

  background:rgba(0,0,0,0.55);

  backdrop-filter:blur(12px);
}

.player-radio iframe{
  width:100%;
  height:100%;
}

/* HERO */

.hero{
  min-height:100vh;

  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;

  text-align:center;

  padding:2rem;
}

.assinatura{
  color:#6cd6ff;

  letter-spacing:4px;

  font-size:0.7rem;

  text-transform:uppercase;
}

.hero h1{
  font-size:clamp(3rem,8vw,7rem);

  margin:1.5rem 0;

  letter-spacing:8px;

  color:white;

  text-shadow:
    0 0 30px rgba(0,180,255,0.2);
}

.linha{
  width:220px;
  height:1px;

  margin:1.5rem 0;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(0,200,255,0.8),
      transparent
    );
}

.manifesto{
  max-width:850px;

  color:#9bc3d3;

  line-height:1.9;

  letter-spacing:1px;
}

/* INTRO */

.intro{
  max-width:1300px;

  margin:0 auto;

  display:grid;
  grid-template-columns:1.2fr 0.8fr;

  gap:2rem;

  padding:0 8%;
}

.texto,
.janela,
.card,
.box,
.eixo,
.link-box{
  background:
    linear-gradient(
      145deg,
      rgba(10,20,30,0.7),
      rgba(3,5,8,0.92)
    );

  border:1px solid rgba(255,255,255,0.05);

  backdrop-filter:blur(14px);

  border-radius:24px;
}

.texto{
  padding:2.5rem;
}

.texto h2{
  color:white;

  margin-bottom:1.5rem;

  letter-spacing:3px;
}

.texto p{
  color:#b3cad4;

  line-height:1.9;

  margin-bottom:1.3rem;
}

/* CAMADAS */

.camadas{
  display:flex;
  flex-wrap:wrap;
  gap:1rem;

  margin-top:2rem;
}

.camadas span{
  padding:0.8rem 1.2rem;

  border-radius:999px;

  background:
    rgba(0,180,255,0.08);

  border:
    1px solid rgba(0,180,255,0.15);

  color:#89dfff;

  font-size:0.75rem;

  letter-spacing:1px;
}

/* PAINEL */

.painel{
  display:flex;
  flex-direction:column;
  gap:1.5rem;
}

.janela{
  padding:1.7rem;
}

.janela span{
  display:block;

  color:#6abbd6;

  margin-bottom:0.7rem;

  text-transform:uppercase;

  font-size:0.7rem;

  letter-spacing:2px;
}

.janela strong{
  color:white;

  line-height:1.7;
}

/* GRID */

.grid-tech{
  max-width:1400px;

  margin:7rem auto 0;

  padding:0 8%;

  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(280px,1fr));

  gap:2rem;
}

/* CARD */

.card{
  padding:2rem;

  transition:0.45s;

  position:relative;

  overflow:hidden;
}

.card::before{
  content:"";

  position:absolute;
  inset:0;

  background:
    radial-gradient(circle at top left,
    rgba(0,180,255,0.12),
    transparent);

  opacity:0;

  transition:0.5s;
}

.card:hover::before{
  opacity:1;
}

.card:hover{
  transform:
    translateY(-10px)
    scale(1.02);

  border-color:#6cd6ff;

  box-shadow:
    0 0 40px rgba(0,180,255,0.12);
}

.icone{
  font-size:2.5rem;

  color:#6cd6ff;

  margin-bottom:1.5rem;
}

.card h3{
  color:white;

  margin-bottom:1rem;

  letter-spacing:2px;
}

.card p{
  color:#b7cad8;

  line-height:1.8;

  margin-bottom:1rem;
}

/* EIXOS */

.eixos{
  max-width:1400px;

  margin:7rem auto 0;

  padding:0 8%;
}

.titulo{
  text-align:center;

  margin-bottom:3rem;
}

.titulo h2{
  color:white;

  letter-spacing:5px;

  margin-bottom:1rem;
}

.titulo p{
  color:#7faab8;
}

.eixos-grid{
  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(240px,1fr));

  gap:1.5rem;
}

.eixo{
  padding:2rem;
}

.eixo span{
  color:#6cd6ff;

  font-size:0.8rem;

  letter-spacing:2px;
}

.eixo h3{
  margin:1rem 0;

  color:white;

  line-height:1.4;
}

.eixo p{
  color:#b3cad4;

  line-height:1.7;
}

/* MANIFESTO */

.manifesto-final{
  max-width:1100px;

  margin:8rem auto 0;

  padding:0 8%;
}

.box{
  padding:3rem;

  text-align:center;
}

.box h2{
  color:white;

  letter-spacing:4px;

  margin-bottom:2rem;
}

.box p{
  color:#b6d0da;

  line-height:1.9;

  max-width:850px;

  margin:0 auto 1.5rem;
}

/* LINKS */

.links{
  margin-top:5rem;

  display:flex;
  justify-content:center;
  flex-wrap:wrap;

  gap:1.5rem;

  padding:0 8%;
}

.link-box{
  padding:1rem 1.6rem;

  text-decoration:none;

  color:#6cd6ff;

  letter-spacing:2px;

  transition:0.35s;
}

.link-box:hover{
  transform:translateY(-4px);

  border-color:#6cd6ff;

  background:
    rgba(0,180,255,0.08);
}

/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:7rem;
  padding-top:3rem;

  display:flex;
  flex-direction:column;
  align-items:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

.voltar{
  text-decoration:none;

  color:#6cd6ff;

  border:
    1px solid rgba(0,180,255,0.2);

  padding:0.9rem 1.6rem;

  border-radius:999px;

  letter-spacing:2px;
  font-size:0.75rem;

  transition:0.35s;

  background:
    rgba(0,180,255,0.05);
}

.voltar:hover{
  background:#6cd6ff;
  color:black;

  transform:translateY(-3px);
}

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:white;

  letter-spacing:4px;

  font-size:0.75rem;

  margin-bottom:0.8rem;
}

.assinatura-final p{
  color:#6f9baa;

  font-size:0.72rem;

  letter-spacing:1px;
}

/* RESPONSIVO */

@media(max-width:900px){

  .intro{
    grid-template-columns:1fr;
  }

}

@media(max-width:700px){

  .player-radio{
    width:180px;
    height:100px;
  }

}

@media(max-width:500px){

  .player-radio{
    position:relative;

    top:0;
    left:0;

    margin:1rem auto 2rem;
  }

  .hero h1{
    letter-spacing:4px;
  }

}
/* BOTÃO VOLTAR FLUTUANTE */

.voltar-flutuante{
  position:fixed;

  top:92px;
  right:24px;

  z-index:120;

  text-decoration:none;

  color:#d6b96b;

  font-size:0.74rem;
  letter-spacing:2px;
  text-transform:uppercase;

  padding:0.85rem 1.3rem;

  border-radius:999px;

  background:
    rgba(0,0,0,0.55);

  border:
    1px solid rgba(214,185,107,0.22);

  backdrop-filter:blur(12px);

  box-shadow:
    0 0 25px rgba(214,185,107,0.08);

  transition:0.35s ease;
}

/* HOVER */

.voltar-flutuante:hover{

  background:#d6b96b;
  color:black;

  transform:
    translateY(-2px)
    scale(1.03);

  box-shadow:
    0 0 35px rgba(214,185,107,0.25);
}

/* MOBILE */

@media(max-width:700px){

  .voltar-flutuante{
    top:200px;
    right:14px;

    font-size:0.68rem;

    padding:0.7rem 1rem;
  }

}

@media(max-width:500px){

  .voltar-flutuante{

    position:relative;

    top:0;
    right:0;

    margin-bottom:2rem;

    align-self:center;
  }

}
</style>