---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="MIS Sabinópolis — Lítika AV">

<main class="campo">

  <!-- GRID VETORIAL -->
  <div class="grid-vetor"></div>

  <!-- PLAYER -->
  <div class="player-cinema">
    <iframe
      src="https://www.youtube.com/embed/XYsjdyzSYK8?autoplay=1&mute=1&controls=1&loop=1&playlist=XYsjdyzSYK8"
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen>
    </iframe>
  </div>

  <!-- HERO -->
  <section class="hero-flow">

    <div class="hero-overlay"></div>

    <div class="hero-content">

      <span class="assinatura">
        núcleo experimental MISSA
      </span>

      <h1>MIS SABINÓPOLIS</h1>

      <div class="linha"></div>

      <p class="sub">
        memória territorial • arqueologia visual •
        inteligência comunitária • audiovisual contínuo
      </p>

    </div>

  </section>

  <!-- MANIFESTO -->
  <section class="manifesto">

    <p>
      O MIS Sabinópolis não é apenas um museu.
      É um sistema de reorganização territorial
      baseado em memória, imagem, juventude,
      arqueologia, fotografia e inteligência coletiva.
    </p>

  </section>

  <!-- DADOS -->
  <section class="dados">

    <div class="dado">

      <span>produção audiovisual</span>

      <strong>12 documentários</strong>

    </div>

    <div class="dado">

      <span>acervo fotográfico</span>

      <strong>+1200 imagens</strong>

    </div>

    <div class="dado">

      <span>campo arqueológico</span>

      <strong>território em expansão</strong>

    </div>

    <div class="dado">

      <span>status</span>

      <strong>ativo estratégico em desenvolvimento</strong>

    </div>

  </section>

  <!-- TEXTO -->
  <section class="texto">

    <div class="bloco-texto">

      <h2>ARQUITETURA DE MEMÓRIA</h2>

      <p>
        Desenvolvido desde 2017,
        o MIS Sabinópolis atua como laboratório vivo
        da arquitetura MISSA,
        consolidando metodologias de memória,
        documentação territorial
        e inteligência cultural aplicada.
      </p>

      <p>
        O projeto organiza produção audiovisual,
        arqueologia urbana,
        fotografia documental,
        educação visual
        e formação cultural comunitária
        como infraestrutura de ativação local.
      </p>

      <p>
        O sistema opera como ativo vetorial
        voltado à implantação de ecossistemas culturais
        em pequenas cidades,
        integrando ciência,
        memória,
        audiovisual
        e economia criativa.
      </p>

    </div>

  </section>

  <!-- ATIVAÇÃO -->
  <section class="ativacao">

    <div class="pulso"></div>

    <h2>
      TERRITÓRIO EM ATIVAÇÃO
    </h2>

    <p>
      audiovisual • educação • arqueologia •
      juventude • memória • ciência • economia criativa
    </p>

  </section>

  <!-- LINKS -->
  <section class="links">

    <a
      href="https://www.facebook.com/mis.sabinopolis"
      target="_blank">

      facebook

    </a>

    <a
      href="https://www.youtube.com/channel/UC52gEsTAwkLZGjL0Ce-RTnQ"
      target="_blank">

      youtube

    </a>

    <a href="/missa">
      plataforma missa
    </a>

  </section>

  <!-- GALERIA -->
  <section class="galeria">

    <div class="titulo-galeria">

      <h2>CAMPO VISUAL</h2>

      <p>
        fragmentos de território • documentação • fluxo visual
      </p>

    </div>

    <div class="grid">

      <img src="/imagens/mis1.jpg" alt="MIS Sabinópolis" />
      <img src="/imagens/mis2.jpg" alt="MIS Sabinópolis" />
      <img src="/imagens/mis3.jpg" alt="MIS Sabinópolis" />
      <img src="/imagens/mis4.jpg" alt="MIS Sabinópolis" />
      <img src="/imagens/mis5.jpg" alt="MIS Sabinópolis" />
      <img src="/imagens/mis6.jpg" alt="MIS Sabinópolis" />
      <img src="/imagens/mis7.jpg" alt="MIS Sabinópolis" />
      <img src="/imagens/mis8.jpg" alt="MIS Sabinópolis" />
      <img src="/imagens/mis9.jpg" alt="MIS Sabinópolis" />
      <img src="/imagens/mis10.jpg" alt="MIS Sabinópolis" />
      <img src="/imagens/mis11.jpg" alt="MIS Sabinópolis" />
      <img src="/imagens/mis12.jpg" alt="MIS Sabinópolis" />

    </div>

  </section>

  <!-- RODAPÉ -->
  <footer class="rodape">

    <a href="javascript:history.back()" class="voltar">
      ← voltar
    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV LTDA.
      </span>

      <p>
        engenharia cultural • audiovisual • vetorialética • arqueologia visual
      </p>

    </div>

  </footer>

</main>

</BaseLayout>

<style>

html{
  scroll-behavior:smooth;
}

body{
  cursor:crosshair;
}

/* BASE */

.campo{
  position:relative;

  overflow:hidden;

  min-height:100vh;

  padding-bottom:8rem;

  background:
    radial-gradient(circle at top,
    rgba(40,25,10,0.55),
    rgba(0,0,0,0.96));

  color:white;
}

/* GRID VETORIAL */

.grid-vetor{
  position:fixed;
  inset:0;

  pointer-events:none;

  opacity:0.22;

  background-image:
    linear-gradient(
      rgba(255,255,255,0.03) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,0.03) 1px,
      transparent 1px
    );

  background-size:80px 80px;

  z-index:-3;
}

/* PLAYER */

.player-cinema{
  position:fixed;

  top:90px;
  right:20px;

  width:260px;
  height:150px;

  z-index:50;

  overflow:hidden;

  border-radius:18px;

  border:
    1px solid rgba(255,255,255,0.08);

  background:
    rgba(0,0,0,0.6);

  backdrop-filter:blur(10px);

  transition:0.4s;
}

.player-cinema:hover{
  transform:scale(1.03);
}

.player-cinema iframe{
  width:100%;
  height:100%;
  border:none;
}

/* HERO */

.hero-flow{
  min-height:100vh;

  display:flex;
  align-items:center;
  justify-content:center;

  position:relative;

  text-align:center;

  padding:2rem;
}

.hero-overlay{
  position:absolute;
  inset:0;

  background:
    radial-gradient(circle,
    rgba(214,185,107,0.08),
    transparent 60%);
}

.hero-content{
  position:relative;
  z-index:2;
}

.assinatura{
  display:block;

  color:#d6b96b;

  letter-spacing:5px;

  font-size:0.72rem;

  text-transform:uppercase;

  margin-bottom:1rem;
}

.hero-flow h1{
  font-size:clamp(3rem,8vw,7rem);

  letter-spacing:12px;

  color:#f5e6c8;

  margin:0;

  text-shadow:
    0 0 30px rgba(214,185,107,0.2);
}

.linha{
  width:180px;
  height:1px;

  margin:2rem auto;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(214,185,107,0.9),
      transparent
    );
}

.sub{
  max-width:700px;

  margin:0 auto;

  color:#9f8d6a;

  line-height:1.8;

  letter-spacing:2px;
}

/* MANIFESTO */

.manifesto{
  max-width:900px;

  margin:-4rem auto 6rem;

  padding:0 2rem;

  text-align:center;
}

.manifesto p{
  font-size:1.3rem;

  line-height:2;

  color:#d8c194;
}

/* DADOS */

.dados{
  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(220px,1fr));

  gap:1.5rem;

  max-width:1200px;

  margin:0 auto;

  padding:0 2rem;
}

.dado{
  position:relative;

  overflow:hidden;

  padding:2rem;

  border-radius:28px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,0.05),
      rgba(255,255,255,0.01)
    );

  border:
    1px solid rgba(255,255,255,0.08);

  backdrop-filter:blur(18px);

  transition:0.5s;
}

.dado::before{
  content:"";

  position:absolute;

  width:240px;
  height:240px;

  top:-80px;
  left:-80px;

  background:
    radial-gradient(
      circle,
      rgba(214,185,107,0.12),
      transparent 70%
    );

  animation:orbitar 12s linear infinite;
}

.dado:hover{
  transform:translateY(-8px);

  border-color:#d6b96b;
}

.dado span{
  display:block;

  color:#9f8d6a;

  margin-bottom:1rem;

  text-transform:uppercase;

  font-size:0.72rem;

  letter-spacing:2px;
}

.dado strong{
  color:#f5e6c8;

  font-size:1.05rem;

  line-height:1.6;
}

/* TEXTO */

.texto{
  max-width:1000px;

  margin:7rem auto 0;

  padding:0 2rem;
}

.bloco-texto{
  padding:3rem;

  border-radius:30px;

  background:
    linear-gradient(
      145deg,
      rgba(25,18,10,0.75),
      rgba(5,5,5,0.9)
    );

  border:
    1px solid rgba(255,255,255,0.06);

  backdrop-filter:blur(14px);
}

.bloco-texto h2{
  color:#f5e6c8;

  letter-spacing:4px;

  margin-bottom:2rem;
}

.bloco-texto p{
  color:#b7ab90;

  line-height:2;

  margin-bottom:1.5rem;
}

/* ATIVAÇÃO */

.ativacao{
  position:relative;

  text-align:center;

  margin:7rem auto;

  padding:5rem 2rem;

  overflow:hidden;
}

.pulso{
  position:absolute;

  width:320px;
  height:320px;

  left:50%;
  top:50%;

  transform:translate(-50%,-50%);

  border-radius:50%;

  background:
    radial-gradient(
      circle,
      rgba(214,185,107,0.18),
      transparent 70%
    );

  animation:pulsar 5s ease infinite;
}

.ativacao h2{
  position:relative;

  z-index:2;

  color:#f5e6c8;

  letter-spacing:6px;

  margin-bottom:1.5rem;
}

.ativacao p{
  position:relative;

  z-index:2;

  color:#b7ab90;

  letter-spacing:2px;

  line-height:1.8;
}

/* LINKS */

.links{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;

  gap:1rem;

  margin-bottom:6rem;
}

.links a{
  text-decoration:none;

  color:#d6b96b;

  padding:1rem 1.6rem;

  border-radius:999px;

  border:
    1px solid rgba(214,185,107,0.2);

  background:
    rgba(214,185,107,0.04);

  transition:0.4s;
}

.links a:hover{
  background:#d6b96b;
  color:black;

  transform:translateY(-4px);
}

/* GALERIA */

.galeria{
  max-width:1400px;

  margin:0 auto;

  padding:0 2rem;
}

.titulo-galeria{
  text-align:center;

  margin-bottom:3rem;
}

.titulo-galeria h2{
  color:#f5e6c8;

  letter-spacing:5px;

  margin-bottom:1rem;
}

.titulo-galeria p{
  color:#8f7a53;
}

/* MASONRY */

.grid{
  columns:4 220px;
  column-gap:1rem;
}

.grid img{
  width:100%;

  margin-bottom:1rem;

  border-radius:18px;

  break-inside:avoid;

  filter:
    grayscale(100%)
    brightness(0.72);

  transition:0.7s;

  border:
    1px solid rgba(255,255,255,0.06);
}

.grid img:hover{
  filter:
    grayscale(0%)
    brightness(1);

  transform:
    scale(1.02);

  box-shadow:
    0 0 40px rgba(214,185,107,0.18);
}

/* RODAPÉ */

.rodape{
  margin-top:7rem;

  padding-top:4rem;

  display:flex;
  flex-direction:column;
  align-items:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

.voltar{
  text-decoration:none;

  color:#d6b96b;

  padding:1rem 1.8rem;

  border-radius:999px;

  border:
    1px solid rgba(214,185,107,0.18);

  background:
    rgba(214,185,107,0.05);

  letter-spacing:2px;

  transition:0.4s;
}

.voltar:hover{
  background:#d6b96b;
  color:black;

  transform:translateY(-3px);
}

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:#f5e6c8;

  letter-spacing:4px;

  margin-bottom:0.8rem;

  font-size:0.75rem;
}

.assinatura-final p{
  color:#7d7156;

  font-size:0.72rem;

  letter-spacing:1px;
}

/* ANIMAÇÕES */

@keyframes orbitar{

  0%{
    transform:rotate(0deg);
  }

  100%{
    transform:rotate(360deg);
  }

}

@keyframes pulsar{

  0%{
    transform:
      translate(-50%,-50%)
      scale(0.9);

    opacity:0.5;
  }

  50%{
    transform:
      translate(-50%,-50%)
      scale(1.1);

    opacity:1;
  }

  100%{
    transform:
      translate(-50%,-50%)
      scale(0.9);

    opacity:0.5;
  }

}

/* RESPONSIVO */

@media(max-width:900px){

  .player-cinema{
    width:200px;
    height:110px;
  }

}

@media(max-width:700px){

  .hero-flow h1{
    letter-spacing:4px;
  }

  .manifesto p{
    font-size:1.05rem;
  }

}

@media(max-width:500px){

  .player-cinema{
    position:relative;

    top:0;
    right:0;

    margin:2rem auto;
  }

  .bloco-texto{
    padding:2rem;
  }

}

</style>