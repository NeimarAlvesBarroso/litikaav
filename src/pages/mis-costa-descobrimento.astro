---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="MIS Costa do Descobrimento — Litika AV">

<main class="campo">

  <!-- PLAYER / FUNDO -->
<div class="player-cinema">
  <iframe
    src="https://www.youtube.com/embed/lm9_duDKESc?autoplay=1&mute=1&controls=1&loop=1&playlist=lm9_duDKESc"
    frameborder="0"
    allow="autoplay; encrypted-media"
    allowfullscreen>
  </iframe>
</div>

  <!-- BG RESSONANTE -->
  <div class="bg"></div>
  <div class="overlay"></div>

  <!-- HERO -->
  <section class="hero">

    <span class="assinatura">
      ecossistema missa · arqueologia visual · litoral ancestral
    </span>

    <h1>
      MIS COSTA DO DESCOBRIMENTO
    </h1>

    <div class="linha"></div>

    <p class="manifesto">
      museu da imagem e do som de porto seguro •
      cartografia arqueológica • paleoembarcações •
      território do primeiro contato
    </p>

  </section>

  <!-- INTRO -->
  <section class="intro">

    <div class="texto">

      <h2>
        O TERRITÓRIO MAIS SIMBÓLICO DO BRASIL
      </h2>

      <p>
        O MIS Costa do Descobrimento nasce como núcleo avançado
        do ecossistema MISSA, voltado à documentação,
        preservação e ativação da memória arqueológica,
        visual e territorial do litoral sul da Bahia.
      </p>

      <p>
        Desenvolvido a partir de expedições independentes
        de pesquisa audiovisual e arqueologia visual,
        o projeto investiga o território histórico
        do primeiro contato entre povos originários
        e colonizadores europeus.
      </p>

      <p>
        As pesquisas já resultaram na identificação
        de paleoembarcações monumentais em Caraíva
        e traçados territoriais de grande escala
        na região de Porto Seguro.
      </p>

    </div>

    <div class="painel">

      <div class="janela">
        <span>território</span>
        <strong>
          costa do descobrimento · extremo sul da bahia
        </strong>
      </div>

      <div class="janela">
        <span>estrutura</span>
        <strong>
          museologia audiovisual · arqueologia visual · documentação territorial
        </strong>
      </div>

      <div class="janela">
        <span>status</span>
        <strong>
          pesquisa ativa · expansão curatorial · busca de investidores
        </strong>
      </div>

    </div>

  </section>

  <!-- ACHADOS -->
  <section class="achados">

    <div class="titulo-area">

      <h2>
        ACHADOS ESTRATÉGICOS
      </h2>

      <p>
        estruturas arqueológicas e paleoindicadores identificados durante as expedições
      </p>

    </div>

    <div class="grid-achados">

      <!-- PALEO -->
      <a
        href="https://www.academia.edu/108952490/Concurso_Premio_Pierre_Vergerde_Fotografia_PaleoembarcacoesdeCaraiva_TracadosMonumentaisCostadoDescobrimento"
        target="_blank"
        class="card-achado"
      >

        <div class="numero">01</div>

        <h3>
          PALEOEMBARCAÇÕES DE CARAÍVA
        </h3>

        <p>
          Estruturas identificadas no litoral de Caraíva
          indicam possíveis paleoembarcações
          associadas a paleoindicadores estimados
          em aproximadamente 20 mil anos.
        </p>

        <span class="link">
          acessar ensaio arqueológico →
        </span>

      </a>

      <!-- TRAÇADOS -->
      <div class="card-achado">

        <div class="numero">02</div>

        <h3>
          TRAÇADOS MONUMENTAIS
        </h3>

        <p>
          Seis grandes estruturas territoriais foram identificadas
          na região de Porto Seguro,
          algumas superiores em escala
          ao próprio aeroporto internacional da cidade.
        </p>

        <span class="link">
          cartografia em desenvolvimento
        </span>

      </div>

      <!-- MISSA -->
      <div class="card-achado">

        <div class="numero">03</div>

        <h3>
          PROTOCOLO MISSA
        </h3>

        <p>
          O projeto integra o aplicativo MISSA,
          modelo operacional de implantação
          de museus da imagem e do som
          em pequenas cidades do Brasil.
        </p>

        <span class="link">
          ecossistema audiovisual territorial
        </span>

      </div>

    </div>

  </section>

  <!-- GALERIA -->
  <section class="galeria">

    <div class="titulo-area">

      <h2>
        CAMPO VISUAL
      </h2>

      <p>
        fotografia arqueológica • litoral ancestral • estruturas territoriais
      </p>

    </div>

    <div class="grid-imagens">

      <img src="/imagens/mis-costa/costa1.jpg" alt="Costa do Descobrimento" />
      <img src="/imagens/mis-costa/costa2.jpg" alt="Caraíva" />
      <img src="/imagens/mis-costa/costa3.jpg" alt="Paleoembarcações" />
      <img src="/imagens/mis-costa/costa4.jpg" alt="Traçados Monumentais" />
      <img src="/imagens/mis-costa/costa5.jpg" alt="Porto Seguro" />
      <img src="/imagens/mis-costa/costa6.jpg" alt="Litoral Sul da Bahia" />

    </div>

  </section>

  <!-- INVESTIMENTO -->
  <section class="investimento">

    <div class="box">

      <h2>
        INFRAESTRUTURA CULTURAL ESTRATÉGICA
      </h2>

      <p>
        O MIS Costa do Descobrimento
        busca parceiros institucionais,
        investidores e redes internacionais
        interessados em:
      </p>

      <div class="vetores">

        <span>arqueologia</span>
        <span>turismo científico</span>
        <span>economia criativa</span>
        <span>preservação territorial</span>
        <span>museologia digital</span>
        <span>documentação audiovisual</span>
        <span>educação científica</span>
        <span>patrimônio cultural</span>

      </div>

    </div>

  </section>

  <!-- REDES -->
  <section class="redes">

    <a
      href="https://www.facebook.com/misportoseguro"
      target="_blank"
      class="rede"
    >
      FACEBOOK
    </a>

    <a
      href="https://www.youtube.com/channel/UCQsFwGROnhX2ISGtXR9LUBg"
      target="_blank"
      class="rede"
    >
      YOUTUBE
    </a>


  </section>

  <!-- RODAPÉ -->
  <footer class="rodape">

    <a href="javascript:history.back()" class="voltar">
      ← voltar
    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV
      </span>

      <p>
        arqueologia visual • vetorialética • audiovisual • memória territorial
      </p>

    </div>

  </footer>

</main>

</BaseLayout>

<style>

/* BASE */

.campo{
  position:relative;
  min-height:100vh;
  overflow:hidden;
  background:black;
  color:white;
}

/* PLAYER */

.player-cinema{
  position:fixed;
  top:90px;
  left:20px;

  width:250px;
  height:140px;

  z-index:50;

  overflow:hidden;
  border-radius:16px;

  border:1px solid rgba(255,255,255,0.08);

  opacity:0.7;
  transition:0.4s;
}

.player-cinema:hover{
  opacity:1;
  transform:scale(1.02);
}

.player-cinema iframe{
  width:100%;
  height:100%;
  border:none;
}

/* BG */

.bg{
  position:fixed;
  inset:0;

  background:
    radial-gradient(circle at center,
    rgba(12,45,70,0.22),
    rgba(0,0,0,0.95)),
    url('/texturas/estrelas.png');

  z-index:-3;
}

.overlay{
  position:fixed;
  inset:0;

  background:
    linear-gradient(
      180deg,
      rgba(0,0,0,0.4),
      rgba(0,0,0,0.92)
    );

  z-index:-2;
}

/* HERO */

.hero{
  min-height:100vh;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  text-align:center;

  padding:2rem;
}

.assinatura{
  color:#9cc8d9;

  letter-spacing:4px;
  font-size:0.7rem;

  text-transform:uppercase;

  margin-bottom:1rem;
}

.hero h1{
  font-size:clamp(3rem,8vw,6rem);

  letter-spacing:10px;

  max-width:1100px;

  color:#f5f1df;

  text-shadow:
    0 0 40px rgba(120,180,220,0.15);
}

.linha{
  width:180px;
  height:1px;

  margin:2rem 0;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(170,220,255,0.9),
      transparent
    );
}

.manifesto{
  max-width:900px;

  line-height:1.9;

  color:#a9b9c0;

  letter-spacing:2px;
}

/* INTRO */

.intro{
  display:grid;
  grid-template-columns:1.2fr 0.8fr;

  gap:2rem;

  padding:4rem 8%;
}

.texto,
.janela,
.card-achado,
.box{
  background:
    linear-gradient(
      145deg,
      rgba(10,20,30,0.72),
      rgba(0,0,0,0.9)
    );

  border:1px solid rgba(255,255,255,0.05);

  backdrop-filter:blur(12px);

  border-radius:24px;
}

.texto{
  padding:2rem;
}

.texto h2{
  color:#f5f1df;
  margin-bottom:1.5rem;
  letter-spacing:2px;
}

.texto p{
  color:#b8c2c7;
  line-height:1.9;
  margin-bottom:1.2rem;
}

/* PAINEL */

.painel{
  display:flex;
  flex-direction:column;
  gap:1.5rem;
}

.janela{
  padding:1.7rem;
}

.janela span{
  display:block;

  color:#7aa5b8;

  margin-bottom:0.7rem;

  text-transform:uppercase;
  letter-spacing:2px;
  font-size:0.7rem;
}

.janela strong{
  color:#f5f1df;
  line-height:1.7;
}

/* ACHADOS */

.achados{
  padding:6rem 8%;
}

.titulo-area{
  text-align:center;
  margin-bottom:3rem;
}

.titulo-area h2{
  color:#f5f1df;
  letter-spacing:5px;
  margin-bottom:1rem;
}

.titulo-area p{
  color:#7d97a3;
}

.grid-achados{
  display:grid;
  grid-template-columns:
    repeat(auto-fit,minmax(280px,1fr));

  gap:2rem;
}

.card-achado{
  padding:2rem;

  text-decoration:none;

  transition:0.4s;

  position:relative;

  overflow:hidden;
}

.card-achado:hover{
  transform:translateY(-8px);

  border-color:#9cd0e6;
}

.numero{
  font-size:3rem;
  color:rgba(170,220,255,0.08);
  margin-bottom:1rem;
}

.card-achado h3{
  color:#f5f1df;
  margin-bottom:1rem;
  letter-spacing:2px;
}

.card-achado p{
  color:#b8c2c7;
  line-height:1.8;
}

.link{
  display:block;
  margin-top:1.5rem;
  color:#9fd8f0;
  font-size:0.8rem;
}

/* GALERIA */

.galeria{
  padding:0 8% 6rem;
}

.grid-imagens{
  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(240px,1fr));

  gap:1rem;
}

.grid-imagens img{
  width:100%;
  height:260px;

  object-fit:cover;

  border-radius:18px;

  filter:
    brightness(0.72)
    contrast(1.05);

  transition:0.5s;

  border:1px solid rgba(255,255,255,0.06);
}

.grid-imagens img:hover{
  transform:scale(1.03);

  filter:
    brightness(1)
    contrast(1.08);
}

/* INVESTIMENTO */

.investimento{
  padding:0 8% 6rem;
}

.box{
  padding:3rem;
  text-align:center;
}

.box h2{
  color:#f5f1df;
  letter-spacing:4px;
  margin-bottom:1.5rem;
}

.box p{
  color:#b8c2c7;
  line-height:1.8;
  max-width:800px;
  margin:0 auto 2rem;
}

/* VETORES */

.vetores{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;

  gap:1rem;
}

.vetores span{
  padding:0.8rem 1.2rem;

  border-radius:999px;

  background:rgba(150,220,255,0.05);

  border:1px solid rgba(150,220,255,0.12);

  color:#bfe9ff;

  font-size:0.75rem;

  letter-spacing:1px;
}

/* REDES */

.redes{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;

  gap:1rem;

  padding:0 8% 6rem;
}

.rede{
  text-decoration:none;

  color:#bfe9ff;

  border:1px solid rgba(150,220,255,0.18);

  padding:1rem 1.5rem;

  border-radius:999px;

  transition:0.4s;
}

.rede:hover{
  background:#9fd8f0;
  color:black;

  transform:translateY(-4px);
}

/* RODAPÉ */

.rodape{
  width:100%;

  padding:3rem 2rem;

  display:flex;
  flex-direction:column;
  align-items:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.05);
}

.voltar{
  text-decoration:none;

  color:#9fd8f0;

  padding:0.9rem 1.6rem;

  border-radius:999px;

  border:1px solid rgba(150,220,255,0.15);

  transition:0.4s;
}

.voltar:hover{
  background:#9fd8f0;
  color:black;
}

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:#f5f1df;

  letter-spacing:4px;

  margin-bottom:0.7rem;

  font-size:0.75rem;
}

.assinatura-final p{
  color:#708690;

  font-size:0.72rem;

  letter-spacing:1px;
}

/* RESPONSIVO */

@media(max-width:900px){

  .intro{
    grid-template-columns:1fr;
  }

}

@media(max-width:700px){

  .player-cinema{
    width:180px;
    height:100px;
  }

}

@media(max-width:500px){

  .hero h1{
    letter-spacing:4px;
  }

  .player-cinema{
    position:relative;

    top:0;
    left:0;

    margin:2rem auto;
  }

}

</style>