---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Vetorialética - Lítika AV">

<main class="vetor">

  <!-- 🎧 PLAYER GLOBAL (TOPO ESQUERDO) -->
  <div class="player-fixo">
    <iframe
      src="https://www.youtube.com/embed/2n3XGGI0Uns?autoplay=1&mute=1&controls=1&loop=1&playlist=2n3XGGI0Uns"
      frameborder="0"
      allow="autoplay"
    ></iframe>
  </div>

  <!-- HERO -->
  <section class="hero">

    <h1>VETORIALÉTICA</h1>

    <p class="sub">
      teoria estrutural de um novo regime físico
    </p>

  </section>

  <!-- MANIFESTO -->
  <section class="manifesto">

    <p class="destaque">
      não é uma interpretação da física.  
      é uma reestruturação do real.
    </p>

    <p>
      a vetorialética propõe que fenômenos não são partículas ou ondas isoladas,  
      mas campos vetoriais de coerência em interação.
    </p>

    <p>
      o universo deixa de ser objeto e passa a ser fluxo estruturado.
    </p>

  </section>

  <!-- GRID DE DESDOBRAMENTOS -->
  <section class="grid">

    <a href="/ia-vetorialetica" class="bloco">
      <h2>NOVA IA</h2>
      <p>inteligência baseada em campos e ressonância</p>
    </a>

    <a href="/resfriamento-urbano" class="bloco">
      <h2>MEGACIDADES</h2>
      <p>estratégias vetoriais de resfriamento e equilíbrio térmico</p>
    </a>

    <a href="/industria-coerencia" class="bloco">
      <h2>INDÚSTRIA</h2>
      <p>engenharia da coerência e produção estruturada</p>
    </a>

    <a href="/prototipos" class="bloco">
      <h2>PROTÓTIPOS</h2>
      <p>dispositivos experimentais vetorialéticos</p>
    </a>

    <a href="/estudos" class="bloco">
      <h2>ESTUDOS</h2>
      <p>modelos matemáticos e simulações</p>
    </a>

    <a href="/publicacoes" class="bloco">
      <h2>PUBLICAÇÕES</h2>
      <p>papers, tratados e formalizações</p>
    </a>

  </section>

  <!-- AUTOR -->
  <section class="autor">

    <p>
      desenvolvida por <strong>Neimar Alves Barroso</strong>  
      no contexto da <span>Lítika AV</span>  
      e do Instituto Física Sem Partículas
    </p>

  </section>

    <!-- RODAPÉ RESSONANTE -->
  <footer class="rodape">

    <a href="javascript:history.back()" class="voltar">
      ← voltar
    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV LTDA.
      </span>

      <p>
        engenharia cultural • audiovisual • vetorialética • arqueologia visual
      </p>

    </div>

  </footer>


</main>

</BaseLayout>

<style>

/* BASE */
.vetor {
  min-height: 100vh;
  padding: 6rem 2rem 4rem;

  background:
    radial-gradient(circle at top, #0f0f0f, #000),
    linear-gradient(180deg, #050505, #000);

  display: flex;
  flex-direction: column;
  align-items: center;
}

/* PLAYER FIXO */
.player-fixo {
  position: fixed;
  top: 90px;
  left: 15px;
  z-index: 999;

  width: 220px;
  height: 124px;

  opacity: 0.5;
  transition: 0.3s;
}

.player-fixo:hover {
  opacity: 1;
}

.player-fixo iframe {
  width: 100%;
  height: 100%;
  border: none;
}

/* HERO */
.hero {
  text-align: center;
  margin-bottom: 3rem;
}

.hero h1 {
  font-size: 3rem;
  letter-spacing: 6px;
}

.sub {
  color: #777;
  font-size: 0.9rem;
}

/* MANIFESTO */
.manifesto {
  max-width: 700px;
  text-align: center;
  margin-bottom: 4rem;
}

.manifesto p {
  color: #888;
  margin-bottom: 1rem;
  line-height: 1.6;
}

.destaque {
  color: #fff;
  font-size: 1.2rem;
}

/* GRID */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.5rem;
  max-width: 1000px;
  width: 100%;
}

/* BLOCOS */
.bloco {
  padding: 1.5rem;

  border: 1px solid #222;
  border-radius: 12px;

  text-decoration: none;
  color: #aaa;

  background: linear-gradient(145deg, #0a0a0a, #050505);

  transition: 0.3s;

  position: relative;
}

/* HALO */
.bloco::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 12px;

  background: radial-gradient(circle, rgba(255,255,255,0.05), transparent);
  opacity: 0;
  transition: 0.3s;
}

.bloco:hover::after {
  opacity: 1;
}

/* HOVER */
.bloco:hover {
  transform: translateY(-5px);
  border-color: white;
  color: white;
}

/* TEXTO */
.bloco h2 {
  margin-bottom: 0.5rem;
  font-size: 1rem;
}

.bloco p {
  font-size: 0.8rem;
  line-height: 1.4;
}

/* AUTOR */
.autor {
  margin-top: 4rem;
  text-align: center;
  font-size: 0.8rem;
  color: #666;
}

.autor span {
  color: #aaa;
}

/* MOBILE */
@media (max-width: 600px) {

  .player-fixo {
    width: 160px;
    height: 90px;
  }

  .hero h1 {
    font-size: 2rem;
  }

}

/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:6rem;
  padding-top:3rem;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

/* BOTÃO VOLTAR */

.voltar{
  text-decoration:none;

  color:#c9a96a;

  border:
    1px solid rgba(214,185,107,0.18);

  padding:0.9rem 1.6rem;

  border-radius:999px;

  letter-spacing:2px;
  font-size:0.75rem;

  transition:0.35s;

  background:
    rgba(214,185,107,0.04);

  backdrop-filter:blur(8px);
}

.voltar:hover{
  background:#d6b96b;
  color:black;

  transform:translateY(-3px);
}

/* ASSINATURA */

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:#f5e6c8;

  letter-spacing:4px;

  font-size:0.75rem;

  margin-bottom:0.8rem;
}

.assinatura-final p{
  color:#7d7156;

  font-size:0.72rem;

  letter-spacing:1px;
}

</style>