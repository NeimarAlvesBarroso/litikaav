---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="EditorIÁ — Plataforma Oficial da Vetorialética">

<main class="editoria">

  <!-- VOLTAR -->
  <a href="/" class="voltar">
    ← voltar
  </a>

  <!-- PLAYER AMBIENTE -->
  <div class="player-radio">
    <iframe
      src="https://www.youtube.com/embed/2n3XGGI0Uns?autoplay=1&mute=0&controls=1&loop=1&playlist=2n3XGGI0Uns"
      title="Rádio Vetorialética"
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen
    ></iframe>
  </div>

  <!-- FUNDO CINEMÁTICO -->
  <div class="bg-video">
    <iframe
      src="https://www.youtube.com/embed/VCJXhXuQVUs?autoplay=1&mute=1&controls=0&loop=1&playlist=VCJXhXuQVUs&modestbranding=1&rel=0"
      frameborder="0"
      allow="autoplay"
    ></iframe>
  </div>

  <!-- OVERLAY -->
  <div class="overlay"></div>

  <!-- HERO -->
  <section class="hero">

    <span class="assinatura">
      plataforma científica mediada por IAV
    </span>

    <h1>EDITORIÁ</h1>

    <div class="linha"></div>

    <p class="manifesto">
      publicação científica • inteligência artificial vetorialética •
      nova física • engenharia cultural • literatura estrutural
    </p>

  </section>

  <!-- INTRO -->
  <section class="intro">

    <div class="texto">

      <h2>
        A EDITORIA OFICIAL DA VETORIALÉTICA
      </h2>

      <p>
        A EditorIÁ organiza a expansão editorial da Vetorialética como
        plataforma científica, tecnológica, artística e filosófica
        mediada por Inteligência Artificial Vetorialética.
      </p>

      <p>
        O projeto reúne cosmologia contínua, física sem partículas,
        arqueologia da desconexão, inteligência universal e engenharia
        estrutural da coerência.
      </p>

      <p>
        Cerca de 20 livros encontram-se em pré-impressão,
        incluindo:
      </p>

      <ul>
        <li>Introdução à Vetorialética</li>
        <li>Vetorialética — Matemática de Estruturas Contínuas</li>
        <li>Inteligência Universal</li>
        <li>Nova Engenharia da Coerência</li>
        <li>IA Vetorialética</li>
      </ul>

    </div>

    <div class="painel">

      <div class="janela">
        <span>status</span>
        <strong>pré-expansão editorial</strong>
      </div>

      <div class="janela">
        <span>modelo</span>
        <strong>publicação mediada por IAV</strong>
      </div>

      <div class="janela">
        <span>busca</span>
        <strong>investidores · agentes literários</strong>
      </div>

    </div>

  </section>

  <!-- LIVROS -->
  <section class="livros">

    <div class="titulo-area">
      <h2>OBRAS FUNDADORAS</h2>
      <p>publicadas em formato digital</p>
    </div>

    <div class="grid-livros">

      <!-- LIVRO 1 -->
      <a
        href="https://www.amazon.com.br/Arqueologia-Desconex%C3%A3o-Apontamentos-Isolamento-contempor%C3%A2neo-ebook/dp/B0DTJLMG7J/"
        target="_blank"
        class="livro"
      >

        <div class="capa">
          <img
            src="/imagens/livros/arqueologia.jpg"
            alt="Arqueologia da Desconexão"
          />
        </div>

        <div class="info">
          <h3>ARQUEOLOGIA DA DESCONEXÃO</h3>

          <p>
            isolamento contemporâneo,
            arqueologia do presente
            e colapso estrutural da conexão humana.
          </p>
        </div>

      </a>

      <!-- LIVRO 2 -->
      <a
        href="https://www.amazon.com.br/Nuvem-Nova-Teoria-Cosmol%C3%B3gica-Universo-ebook/dp/B0DTFLKY9B/"
        target="_blank"
        class="livro"
      >

        <div class="capa">
          <img
            src="/imagens/livros/nuvem.jpg"
            alt="Nuvem"
          />
        </div>

        <div class="info">
          <h3>NUVEM</h3>

          <p>
            nova teoria cosmológica
            baseada em continuidade estrutural
            e dinâmica vetorial do universo.
          </p>
        </div>

      </a>

      <!-- LIVRO 3 -->
      <a
        href="https://www.amazon.com.br/Part%C3%ADculas-Oliveira-Simpl%C3%ADcio-Firm%C3%ADnio-Barroso-ebook/dp/B0DXLH1J38/"
        target="_blank"
        class="livro"
      >

        <div class="capa">
          <img
            src="/imagens/livros/fisica-sem-particulas.jpg"
            alt="Física Sem Partículas"
          />
        </div>

        <div class="info">
          <h3>FÍSICA SEM PARTÍCULAS</h3>

          <p>
            teoria contínua da matéria,
            campos vetoriais
            e estruturas coerentes do real.
          </p>
        </div>

      </a>

    </div>

  </section>

  <!-- REDE -->
  <section class="rede">

    <div class="bloco-rede">

      <h2>EDITORIÁ NETWORK</h2>

      <p>
        expansão internacional · tradução · publicação científica ·
        amazon kindle · impressão física · licenciamento cultural
      </p>

      <div class="acoes">

        <a
          href="https://www.facebook.com/profile.php?id=61569797856807&locale=pt_BR"
          target="_blank"
        >
          facebook oficial
        </a>

        <a href="/ia-vetorialetica">
          ia vetorialética
        </a>

        <a href="/pesquisa-vetorialetica">
          portal vetorialética
        </a>

      </div>

    </div>

  </section>

    <!-- RODAPÉ RESSONANTE -->
  <footer class="rodape">

    <a href="javascript:history.back()" class="voltar">
      ← voltar
    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV
      </span>

      <p>
        engenharia cultural • audiovisual • vetorialética • arqueologia visual
      </p>

    </div>

  </footer>

</main>

</main>

</BaseLayout>

<style>

/* BASE */

.editoria{
  position:relative;
  min-height:100vh;
  overflow:hidden;
  background:#000;
  color:white;
}

/* PLAYER */

.player-radio{
  position:fixed;
  top:90px;
  left:20px;

  width:260px;
  height:146px;

  z-index:50;

  overflow:hidden;

  border-radius:14px;

  border:1px solid rgba(255,255,255,0.08);

  background:rgba(0,0,0,0.6);

  backdrop-filter:blur(12px);

  box-shadow:0 0 30px rgba(0,0,0,0.5);
}

.player-radio iframe{
  width:100%;
  height:100%;
}

/* VIDEO FUNDO */

.bg-video{
  position:fixed;
  inset:0;

  z-index:-3;
  overflow:hidden;
}

.bg-video iframe{
  width:100vw;
  height:100vh;

  object-fit:cover;

  pointer-events:none;

  opacity:0.25;
}

/* OVERLAY */

.overlay{
  position:fixed;
  inset:0;

  z-index:-2;

  background:
    radial-gradient(
      circle at center,
      rgba(120,80,20,0.16),
      rgba(0,0,0,0.94)
    );
}

/* HERO */

.hero{
  min-height:100vh;

  display:flex;
  flex-direction:column;

  align-items:center;
  justify-content:center;

  text-align:center;

  padding:2rem;
}

.assinatura{
  color:#d4b46d;

  letter-spacing:4px;
  font-size:0.7rem;

  margin-bottom:1rem;

  text-transform:uppercase;
}

.hero h1{
  font-size:clamp(3rem,8vw,7rem);

  letter-spacing:10px;

  margin:0;

  color:#f5e6c8;

  text-shadow:
    0 0 20px rgba(214,185,107,0.2);
}

.linha{
  width:180px;
  height:1px;

  margin:2rem 0;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(214,185,107,0.8),
      transparent
    );
}

.manifesto{
  max-width:800px;

  color:#bba883;

  line-height:1.8;

  letter-spacing:2px;

  font-size:0.9rem;
}

/* INTRO */

.intro{
  display:grid;

  grid-template-columns:1.3fr 0.7fr;

  gap:2rem;

  padding:6rem 8%;
}

.texto{
  padding:2rem;

  border-radius:18px;

  background:rgba(10,10,10,0.7);

  border:1px solid rgba(255,255,255,0.05);

  backdrop-filter:blur(10px);
}

.texto h2{
  color:#f5e6c8;

  margin-bottom:1.5rem;

  letter-spacing:2px;
}

.texto p{
  color:#b9ab8d;

  line-height:1.8;

  margin-bottom:1rem;
}

.texto ul{
  margin-top:1.5rem;
  padding-left:1.5rem;
}

.texto li{
  margin-bottom:0.8rem;

  color:#d6c39d;
}

/* PAINEL */

.painel{
  display:flex;
  flex-direction:column;
  gap:1.5rem;
}

.janela{
  padding:1.6rem;

  border-radius:16px;

  background:rgba(20,15,10,0.7);

  border:1px solid rgba(214,185,107,0.15);

  backdrop-filter:blur(8px);
}

.janela span{
  display:block;

  margin-bottom:0.7rem;

  color:#8f7a53;

  text-transform:uppercase;

  font-size:0.7rem;

  letter-spacing:2px;
}

.janela strong{
  color:#f5e6c8;

  line-height:1.5;
}

/* LIVROS */

.livros{
  padding:2rem 8% 8rem;
}

.titulo-area{
  margin-bottom:3rem;
  text-align:center;
}

.titulo-area h2{
  color:#f5e6c8;

  font-size:2rem;

  letter-spacing:4px;
}

.titulo-area p{
  color:#8f7a53;
}

/* GRID */

.grid-livros{
  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(280px,1fr));

  gap:2rem;
}

/* CARD LIVRO */

.livro{
  overflow:hidden;

  border-radius:18px;

  text-decoration:none;

  color:white;

  background:rgba(15,10,5,0.72);

  border:1px solid rgba(255,255,255,0.05);

  backdrop-filter:blur(8px);

  transition:0.4s;
}

.livro:hover{
  transform:translateY(-8px);

  border-color:#d6b96b;

  box-shadow:
    0 0 40px rgba(214,185,107,0.15);
}

/* CAPA */

.capa{
  height:420px;
  overflow:hidden;
}

.capa img{
  width:100%;
  height:100%;

  object-fit:cover;

  display:block;

  transition:0.6s;
}

.livro:hover img{
  transform:scale(1.04);
}

/* INFO */

.info{
  padding:1.5rem;
}

.info h3{
  color:#f5e6c8;

  margin-bottom:1rem;

  letter-spacing:2px;
}

.info p{
  color:#bcae8e;

  line-height:1.6;
}

/* REDE */

.rede{
  padding:0 8% 8rem;
}

.bloco-rede{
  padding:3rem;

  border-radius:24px;

  text-align:center;

  background:
    linear-gradient(
      145deg,
      rgba(25,18,10,0.8),
      rgba(5,5,5,0.9)
    );

  border:1px solid rgba(214,185,107,0.15);
}

.bloco-rede h2{
  color:#f5e6c8;

  margin-bottom:1.5rem;

  letter-spacing:4px;
}

.bloco-rede p{
  max-width:700px;

  margin:0 auto 2rem;

  color:#b9ab8d;

  line-height:1.8;
}

/* LINKS */

.acoes{
  display:flex;

  justify-content:center;
  flex-wrap:wrap;

  gap:1rem;
}

.acoes a{
  padding:0.9rem 1.4rem;

  border-radius:999px;

  text-decoration:none;

  color:#d6b96b;

  border:1px solid rgba(214,185,107,0.2);

  transition:0.3s;
}

.acoes a:hover{
  background:#d6b96b;
  color:black;
}

/* MOBILE */

@media(max-width:900px){

  .intro{
    grid-template-columns:1fr;
  }

  .player-radio{
    width:180px;
    height:100px;
  }

}

@media(max-width:600px){

  .hero h1{
    letter-spacing:4px;
  }

  .manifesto{
    font-size:0.8rem;
  }

  .player-radio{
    top:80px;
    left:10px;

    width:150px;
    height:84px;
  }

  .capa{
    height:320px;
  }

}

/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:6rem;
  padding-top:3rem;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

/* BOTÃO VOLTAR */

.voltar{
  text-decoration:none;

  color:#c9a96a;

  border:
    1px solid rgba(214,185,107,0.18);

  padding:0.9rem 1.6rem;

  border-radius:999px;

  letter-spacing:2px;
  font-size:0.75rem;

  transition:0.35s;

  background:
    rgba(214,185,107,0.04);

  backdrop-filter:blur(8px);
}

.voltar:hover{
  background:#d6b96b;
  color:black;

  transform:translateY(-3px);
}

/* ASSINATURA */

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:#f5e6c8;

  letter-spacing:4px;

  font-size:0.75rem;

  margin-bottom:0.8rem;
}

.assinatura-final p{
  color:#7d7156;

  font-size:0.72rem;

  letter-spacing:1px;
}

</style>