---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="MISSA — Ecossistema de Museus Vetorialéticos">

<main class="missa">

  <!-- VOLTAR -->
  <a href="/" class="voltar">
    ← voltar
  </a>

  <!-- PLAYER -->
  <div class="player-radio">
    <iframe
      src="https://www.youtube.com/embed/2n3XGGI0Uns?autoplay=1&mute=0&controls=1&loop=1&playlist=2n3XGGI0Uns"
      title="MISSA Radio"
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen
    ></iframe>
  </div>

  <!-- VIDEO BACKGROUND -->
  <div class="video-bg">
    <iframe
      src="https://www.youtube.com/embed/XYsjdyzSYK8?autoplay=1&mute=1&controls=0&loop=1&playlist=XYsjdyzSYK8&modestbranding=1&rel=0"
      frameborder="0"
      allow="autoplay"
    ></iframe>
  </div>

  <div class="overlay"></div>

  <!-- HERO -->
  <section class="hero">

    <span class="assinatura">
      aplicativo vetorialético de linguagem aplicada
    </span>

    <h1>MISSA</h1>

    <div class="linha"></div>

    <p class="manifesto">
      museus da imagem e do som como infraestruturas
      de ativação territorial, inteligência cultural,
      arqueologia aplicada e economia do conhecimento.
    </p>

  </section>

  <!-- INTRO -->
  <section class="intro">

    <div class="texto">

      <h2>
        O QUE É O MISSA
      </h2>

      <p>
        MISSA é um ecossistema vetorialético de pós-produção audiovisual,
        museologia aplicada e inteligência territorial voltado à implantação
        de Museus da Imagem e do Som em cidades do interior.
      </p>

      <p>
        Mais do que equipamentos culturais, os projetos MISSA operam
        como estruturas locais de reorganização simbólica, documentação,
        educação científica, formação audiovisual e desenvolvimento econômico.
      </p>

      <p>
        Cada unidade MISSA funciona como:
      </p>

      <ul>
        <li>museu audiovisual territorial;</li>
        <li>laboratório de arqueologia local;</li>
        <li>escola de fotografia e cinema;</li>
        <li>arquivo histórico digital;</li>
        <li>plataforma de turismo científico;</li>
        <li>infraestrutura de formação para jovens e adultos;</li>
        <li>ativo institucional para municípios e investidores.</li>
      </ul>

    </div>

    <div class="painel">

      <div class="janela">
        <span>modelo</span>
        <strong>
          museologia vetorialética aplicada
        </strong>
      </div>

      <div class="janela">
        <span>mercado</span>
        <strong>
          prefeituras · universidades · investidores
        </strong>
      </div>

      <div class="janela">
        <span>estrutura</span>
        <strong>
          audiovisual · arqueologia · memória · turismo
        </strong>
      </div>

    </div>

  </section>

  <!-- IMPACTO -->
  <section class="impacto">

    <div class="bloco-impacto">
      <h2>ATIVAÇÃO TERRITORIAL</h2>

      <p>
        Os equipamentos MISSA transformam memória local
        em ativo econômico, educacional e científico.
      </p>

      <p>
        O modelo conecta audiovisual, patrimônio,
        arqueologia e inteligência cultural
        para gerar novas cadeias produtivas.
      </p>
    </div>

    <div class="bloco-impacto">
      <h2>FORMAÇÃO</h2>

      <p>
        Os museus implementam formação prática em:
      </p>

      <ul>
        <li>fotografia;</li>
        <li>cinema;</li>
        <li>documentação histórica;</li>
        <li>curadoria digital;</li>
        <li>museologia;</li>
        <li>produção cultural.</li>
      </ul>
    </div>

    <div class="bloco-impacto">
      <h2>PESQUISA LOCAL</h2>

      <p>
        Os projetos já revelaram descobertas arqueológicas
        e culturais estratégicas.
      </p>

      <p>
        Entre elas:
      </p>

      <ul>
        <li>as paleoembarcações de Caraíva;</li>
        <li>o maior instrumento musical do mundo em cânion natural;</li>
        <li>cartografias audiovisuais comunitárias;</li>
        <li>mapeamentos culturais do sertão mineiro.</li>
      </ul>
    </div>

  </section>

  <!-- REDE -->
  <section class="rede">

    <div class="titulo">
      <h2>REDE MISSA</h2>
      <p>
        equipamentos em pesquisa, implantação e expansão
      </p>
    </div>

    <div class="grid">

      <!-- SABINOPOLIS -->
      <a
        href="https://www.facebook.com/mis.sabinopolis?locale=pt_BR"
        target="_blank"
        class="card"
      >
        <span class="tag">implantação</span>

        <h3>MIS SABINÓPOLIS</h3>

        <p>
          arqueologia sonora, fotografia territorial,
          documentação da Serra do Espinhaço
          e patrimônio comunitário.
        </p>
      </a>

      <!-- PORTO SEGURO -->
      <a
        href="https://www.facebook.com/misportoseguro"
        target="_blank"
        class="card"
      >
        <span class="tag">arqueologia costeira</span>

        <h3>MIS PORTO SEGURO</h3>

        <p>
          pesquisas sobre paleoembarcações de Caraíva,
          memória costeira e cultura atlântica.
        </p>
      </a>

      <!-- SERTAO -->
      <a
        href="https://www.facebook.com/misertaoveredas?locale=pt_BR"
        target="_blank"
        class="card"
      >
        <span class="tag">sertão</span>

        <h3>MIS SERTÃO VEREDAS</h3>

        <p>
          documentação audiovisual do sertão,
          cultura oral e cartografias simbólicas.
        </p>
      </a>

      <!-- BOEMIA -->
      <a
        href="https://www.facebook.com/museudaboemiabh"
        target="_blank"
        class="card"
      >
        <span class="tag">urbano</span>

        <h3>MUSEU DA BOEMIA</h3>

        <p>
          memória musical, vida noturna,
          antropologia urbana e história cultural de Belo Horizonte.
        </p>
      </a>

      <!-- TAMBOR -->
      <a
        href="https://www.facebook.com/museudotambormineiro/"
        target="_blank"
        class="card"
      >
        <span class="tag">percussão</span>

        <h3>MUSEU DO TAMBOR MINEIRO</h3>

        <p>
          arquivo afro-sonoro,
          ritmos ancestrais e cultura popular brasileira.
        </p>
      </a>

      <!-- PERCUSSAO -->
      <a
        href="https://www.facebook.com/museudotamboredapercussao"
        target="_blank"
        class="card"
      >
        <span class="tag">instrumentos</span>

        <h3>MUSEU DO TAMBOR E DA PERCUSSÃO</h3>

        <p>
          documentação organológica,
          engenharia sonora e arqueologia musical.
        </p>
      </a>

      <!-- ALEGRIA -->
      <a
        href="https://www.facebook.com/profile.php?id=61567559166135"
        target="_blank"
        class="card"
      >
        <span class="tag">experimental</span>

        <h3>MUSEU DA ALEGRIA</h3>

        <p>
          experiências imersivas,
          linguagem afetiva e memória coletiva expandida.
        </p>
      </a>

    </div>

  </section>

  <!-- INVESTIMENTO -->
  <section class="investimento">

    <div class="invest-box">

      <h2>ATIVO ESTRATÉGICO PARA MUNICÍPIOS</h2>

      <p>
        O MISSA propõe um novo modelo de equipamento cultural:
        economicamente ativador, tecnologicamente expansível
        e educacionalmente estruturante.
      </p>

      <p>
        Cada unidade pode operar integrada a:
      </p>

      <div class="chips">

        <span>turismo científico</span>
        <span>economia criativa</span>
        <span>educação pública</span>
        <span>arquivo histórico</span>
        <span>cinema local</span>
        <span>pesquisa arqueológica</span>
        <span>IA vetorialética</span>

      </div>

      <div class="acoes">

        <a href="/contato">
          implantar equipamento
        </a>

        <a href="/mic">
          plataforma MIC
        </a>

        <a href="/pesquisa-vetorialetica">
          teoria vetorialética
        </a>

      </div>

    </div>

  </section>
  <!-- RODAPÉ RESSONANTE -->
  <footer class="rodape">

    <a href="javascript:history.back()" class="voltar">
      ← voltar
    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV
      </span>

      <p>
        engenharia cultural • audiovisual • vetorialética • arqueologia visual
      </p>

    </div>

  </footer>

</main>

</BaseLayout>

<style>

/* BASE */

.missa{
  position:relative;
  min-height:100vh;
  overflow:hidden;
  background:black;
  color:white;
}

/* PLAYER */

.player-radio{
  position:fixed;
  top:90px;
  left:20px;

  width:260px;
  height:146px;

  z-index:50;

  overflow:hidden;

  border-radius:16px;

  border:1px solid rgba(255,255,255,0.08);

  background:rgba(0,0,0,0.65);

  backdrop-filter:blur(10px);
}

.player-radio iframe{
  width:100%;
  height:100%;
}

/* BG */

.video-bg{
  position:fixed;
  inset:0;
  z-index:-3;
}

.video-bg iframe{
  width:100vw;
  height:100vh;

  object-fit:cover;

  opacity:0.22;

  pointer-events:none;
}

.overlay{
  position:fixed;
  inset:0;
  z-index:-2;

  background:
    radial-gradient(circle at center,
    rgba(40,70,120,0.12),
    rgba(0,0,0,0.92));
}

/* HERO */

.hero{
  min-height:100vh;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  text-align:center;

  padding:2rem;
}

.assinatura{
  color:#7ebcff;

  letter-spacing:4px;

  text-transform:uppercase;

  font-size:0.7rem;

  margin-bottom:1rem;
}

.hero h1{
  font-size:clamp(3rem,8vw,7rem);

  letter-spacing:10px;

  color:white;

  text-shadow:
    0 0 40px rgba(120,180,255,0.2);
}

.linha{
  width:180px;
  height:1px;

  margin:2rem 0;

  background:linear-gradient(
    to right,
    transparent,
    rgba(126,188,255,0.9),
    transparent
  );
}

.manifesto{
  max-width:900px;

  color:#a6b6c7;

  line-height:1.9;

  font-size:0.95rem;

  letter-spacing:1px;
}

/* INTRO */

.intro{
  display:grid;
  grid-template-columns:1.2fr 0.8fr;

  gap:2rem;

  padding:6rem 8%;
}

.texto,
.janela,
.bloco-impacto,
.card,
.invest-box{
  background:rgba(10,10,15,0.7);

  border:1px solid rgba(255,255,255,0.06);

  backdrop-filter:blur(12px);

  border-radius:20px;
}

.texto{
  padding:2rem;
}

.texto h2{
  margin-bottom:1.5rem;

  color:#d8ecff;

  letter-spacing:2px;
}

.texto p,
.texto li{
  color:#aab8c8;

  line-height:1.8;
}

.texto ul{
  margin-top:1.5rem;
  padding-left:1.5rem;
}

/* PAINEL */

.painel{
  display:flex;
  flex-direction:column;
  gap:1.5rem;
}

.janela{
  padding:1.6rem;
}

.janela span{
  display:block;

  margin-bottom:0.8rem;

  color:#7eaad8;

  font-size:0.7rem;

  text-transform:uppercase;

  letter-spacing:2px;
}

.janela strong{
  color:white;

  line-height:1.6;
}

/* IMPACTO */

.impacto{
  padding:2rem 8% 6rem;

  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:2rem;
}

.bloco-impacto{
  padding:2rem;
}

.bloco-impacto h2{
  margin-bottom:1rem;

  color:#d9ecff;

  letter-spacing:2px;
}

.bloco-impacto p,
.bloco-impacto li{
  color:#aab8c8;

  line-height:1.8;
}

.bloco-impacto ul{
  margin-top:1rem;
  padding-left:1.2rem;
}

/* REDE */

.rede{
  padding:0 8% 8rem;
}

.titulo{
  text-align:center;
  margin-bottom:3rem;
}

.titulo h2{
  color:#d9ecff;
  letter-spacing:5px;
}

.titulo p{
  color:#6d86a0;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:2rem;
}

/* CARD */

.card{
  padding:2rem;

  text-decoration:none;

  transition:0.4s;
}

.card:hover{
  transform:translateY(-8px);

  border-color:#7ebcff;

  box-shadow:
    0 0 40px rgba(126,188,255,0.12);
}

.tag{
  display:inline-block;

  margin-bottom:1rem;

  padding:0.4rem 0.8rem;

  border-radius:999px;

  background:rgba(126,188,255,0.1);

  color:#8fc6ff;

  font-size:0.7rem;

  letter-spacing:1px;
}

.card h3{
  margin-bottom:1rem;

  color:white;

  letter-spacing:2px;
}

.card p{
  color:#aab8c8;

  line-height:1.7;
}

/* INVESTIMENTO */

.investimento{
  padding:0 8% 8rem;
}

.invest-box{
  padding:3rem;
  text-align:center;
}

.invest-box h2{
  margin-bottom:1.5rem;

  color:#d8ecff;

  letter-spacing:4px;
}

.invest-box p{
  color:#aab8c8;

  line-height:1.9;

  max-width:900px;

  margin:0 auto 1.5rem;
}

/* CHIPS */

.chips{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:1rem;

  margin-top:2rem;
}

.chips span{
  padding:0.8rem 1.2rem;

  border-radius:999px;

  background:rgba(126,188,255,0.08);

  border:1px solid rgba(126,188,255,0.12);

  color:#b9d9ff;

  font-size:0.8rem;
}

/* LINKS */

.acoes{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:1rem;

  margin-top:3rem;
}

.acoes a{
  text-decoration:none;

  color:#8fc6ff;

  border:1px solid rgba(126,188,255,0.2);

  padding:1rem 1.4rem;

  border-radius:999px;

  transition:0.3s;
}

.acoes a:hover{
  background:#8fc6ff;
  color:black;
}

/* MOBILE */

@media(max-width:900px){

  .intro{
    grid-template-columns:1fr;
  }

  .player-radio{
    width:180px;
    height:100px;
  }

}

@media(max-width:600px){

  .hero h1{
    letter-spacing:4px;
  }

  .player-radio{
    width:150px;
    height:84px;

    top:80px;
    left:10px;
  }

}
/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:6rem;
  padding-top:3rem;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

/* BOTÃO VOLTAR */

.voltar{
  text-decoration:none;

  color:#c9a96a;

  border:
    1px solid rgba(214,185,107,0.18);

  padding:0.9rem 1.6rem;

  border-radius:999px;

  letter-spacing:2px;
  font-size:0.75rem;

  transition:0.35s;

  background:
    rgba(214,185,107,0.04);

  backdrop-filter:blur(8px);
}

.voltar:hover{
  background:#d6b96b;
  color:black;

  transform:translateY(-3px);
}

/* ASSINATURA */

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:#f5e6c8;

  letter-spacing:4px;

  font-size:0.75rem;

  margin-bottom:0.8rem;
}

.assinatura-final p{
  color:#7d7156;

  font-size:0.72rem;

  letter-spacing:1px;
}
</style>