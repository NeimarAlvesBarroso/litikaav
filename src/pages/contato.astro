---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contato — Lítika AV">

<main class="campo">

  <!-- VIA LÁCTEA -->
  <div class="via-lactea"></div>

  <!-- GRID ESTELAR -->
  <div class="grid-vetor"></div>

  <!-- PLAYER CINEMA -->
  <div class="player-cinema">

    <iframe
      src="https://www.youtube.com/embed/3lmB_fhLwYg?autoplay=1&mute=1&controls=1&loop=1&playlist=3lmB_fhLwYg"
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen>
    </iframe>

  </div>

  <!-- HERO -->
  <section class="hero">

    <span class="assinatura">
      engenharia cultural • vetorialética • cinema
    </span>

    <h1>CONTATO</h1>

    <div class="linha"></div>

    <p class="sub">
      ativar conexão • fluxo contínuo • articulação territorial
    </p>

  </section>

  <!-- CAMPO CONECTOR -->
  <section class="campo-conexao">

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <!-- TOPO -->
    <a
      href="https://www.facebook.com/neimarab"
      target="_blank"
      class="node topo">

      facebook

    </a>

    <!-- ESQUERDA -->
    <a
      href="https://ufmg.academia.edu/NeimarAlves"
      target="_blank"
      class="node esquerda">

      academia

    </a>

    <!-- DIREITA -->
    <a
      href="/projetos"
      class="node direita">

      projetos

    </a>

    <!-- CENTRO -->
    <div class="nucleo">

      <span>
        LÍTIKA AV
      </span>

    </div>

  </section>

  <!-- TELEFONE -->
  <section class="telefone">

    <a href="tel:+5533999351436">

      55 (33) 99935 1436

    </a>

    <p>
      Neimar Alves Barroso
    </p>

  </section>

  <!-- FLUXO -->
  <section class="fluxo">

    <p class="destaque">
      parcerias • investimento • articulação • pesquisa
    </p>

    <p>
      cada contato é um vetor de ativação.
      a Lítika organiza cinema,
      memória,
      inteligência cultural,
      arqueologia visual
      e sistemas vetorialéticos
      como infraestruturas de futuro.
    </p>

  </section>

  <!-- LINKS -->
  <section class="links">

    <a href="/sobre">
      sobre
    </a>

    <a href="/pesquisa-vetorialetica">
      vetorialética
    </a>

    <a href="/editoria">
      editoriá
    </a>

    <a href="/mic">
      mic
    </a>

    <a href="/missa">
      missa
    </a>

  </section>

  <!-- RODAPÉ -->
  <footer class="rodape">

    <a
      href="javascript:history.back()"
      class="voltar">

      ← voltar

    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV LTDA.
      </span>

      <p>
        audiovisual • vetorialética • arqueologia visual • engenharia cultural
      </p>

    </div>

  </footer>

</main>

</BaseLayout>

<style>

html{
  scroll-behavior:smooth;
}

body{
  cursor:crosshair;
}

/* BASE */

.campo{
  position:relative;

  overflow:hidden;

  min-height:100vh;

  padding:4rem 1.5rem 8rem;

  display:flex;
  flex-direction:column;
  align-items:center;

  background:
    radial-gradient(circle at top,
    rgba(40,20,8,0.5),
    rgba(0,0,0,0.97));

  color:white;
}

/* VIA LÁCTEA */

.via-lactea{
  position:fixed;
  inset:0;

  z-index:-4;

  background:
    radial-gradient(circle at 20% 30%,
    rgba(255,255,255,0.08),
    transparent 20%),

    radial-gradient(circle at 80% 40%,
    rgba(214,185,107,0.08),
    transparent 25%),

    radial-gradient(circle at 50% 80%,
    rgba(255,255,255,0.05),
    transparent 30%);

  filter:blur(40px);

  animation:via 20s linear infinite alternate;
}

/* GRID */

.grid-vetor{
  position:fixed;
  inset:0;

  z-index:-3;

  opacity:0.18;

  background-image:
    linear-gradient(
      rgba(255,255,255,0.03) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,0.03) 1px,
      transparent 1px
    );

  background-size:80px 80px;
}

/* PLAYER */

.player-cinema{
  position:fixed;

  top:90px;
  left:20px;

  width:260px;
  height:150px;

  z-index:50;

  overflow:hidden;

  border-radius:18px;

  border:
    1px solid rgba(255,255,255,0.08);

  background:
    rgba(0,0,0,0.55);

  backdrop-filter:blur(12px);

  transition:0.4s;
}

.player-cinema:hover{
  transform:scale(1.03);

  box-shadow:
    0 0 40px rgba(214,185,107,0.12);
}

.player-cinema iframe{
  width:100%;
  height:100%;
  border:none;
}

/* HERO */

.hero{
  min-height:50vh;

  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;

  text-align:center;
}

.assinatura{
  color:#d6b96b;

  letter-spacing:4px;

  text-transform:uppercase;

  font-size:0.7rem;

  margin-bottom:1rem;
}

.hero h1{
  font-size:clamp(3rem,8vw,6rem);

  letter-spacing:10px;

  color:#f5e6c8;

  margin:0;

  text-shadow:
    0 0 30px rgba(214,185,107,0.18);
}

.linha{
  width:180px;
  height:1px;

  margin:2rem 0;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(214,185,107,0.9),
      transparent
    );
}

.sub{
  color:#9f8d6a;

  letter-spacing:2px;

  max-width:700px;

  line-height:1.8;
}

/* CAMPO */

.campo-conexao{
  position:relative;

  width:420px;
  height:420px;

  margin:3rem 0;
}

/* ORBS */

.orb{
  position:absolute;

  border-radius:50%;

  filter:blur(40px);

  opacity:0.25;
}

.orb-1{
  width:220px;
  height:220px;

  background:#d6b96b;

  top:40px;
  left:50px;

  animation:flutuar 10s ease infinite;
}

.orb-2{
  width:180px;
  height:180px;

  background:#4f6c8d;

  bottom:40px;
  right:60px;

  animation:flutuar 14s ease infinite reverse;
}

/* NODES */

.node{
  position:absolute;

  display:flex;
  align-items:center;
  justify-content:center;

  width:120px;
  height:120px;

  border-radius:50%;

  text-decoration:none;

  color:#c6b48f;

  text-transform:uppercase;

  letter-spacing:2px;

  font-size:0.72rem;

  background:
    rgba(255,255,255,0.03);

  border:
    1px solid rgba(255,255,255,0.08);

  backdrop-filter:blur(14px);

  transition:0.45s;

  overflow:hidden;
}

.node::before{
  content:"";

  position:absolute;
  inset:0;

  background:
    radial-gradient(circle,
    rgba(214,185,107,0.12),
    transparent 70%);

  opacity:0;

  transition:0.4s;
}

.node:hover::before{
  opacity:1;
}

.node:hover{
  transform:scale(1.08);

  color:white;

  border-color:#d6b96b;

  box-shadow:
    0 0 40px rgba(214,185,107,0.14);
}

/* POSIÇÕES */

.topo{
  top:0;
  left:50%;

  transform:translateX(-50%);
}

.esquerda{
  bottom:40px;
  left:0;
}

.direita{
  bottom:40px;
  right:0;
}

/* NÚCLEO */

.nucleo{
  position:absolute;

  top:50%;
  left:50%;

  transform:translate(-50%,-50%);

  width:150px;
  height:150px;

  border-radius:50%;

  display:flex;
  align-items:center;
  justify-content:center;

  background:
    radial-gradient(circle,
    rgba(214,185,107,0.14),
    rgba(255,255,255,0.02));

  border:
    1px solid rgba(214,185,107,0.2);

  backdrop-filter:blur(18px);

  box-shadow:
    0 0 60px rgba(214,185,107,0.12);
}

.nucleo span{
  color:#f5e6c8;

  letter-spacing:4px;

  font-size:0.8rem;
}

/* TELEFONE */

.telefone{
  text-align:center;

  margin-top:1rem;
}

.telefone a{
  text-decoration:none;

  color:#f5e6c8;

  font-size:1.1rem;

  letter-spacing:3px;

  transition:0.3s;
}

.telefone a:hover{
  color:#d6b96b;
}

.telefone p{
  margin-top:0.8rem;

  color:#8f7a53;

  letter-spacing:2px;

  font-size:0.75rem;
}

/* FLUXO */

.fluxo{
  max-width:720px;

  margin-top:4rem;

  text-align:center;
}

.fluxo p{
  color:#a39372;

  line-height:2;

  margin-bottom:1.5rem;
}

.fluxo .destaque{
  color:#f5e6c8;

  font-size:1.15rem;

  letter-spacing:2px;
}

/* LINKS */

.links{
  margin-top:3rem;

  display:flex;
  justify-content:center;
  flex-wrap:wrap;

  gap:1rem;
}

.links a{
  text-decoration:none;

  color:#d6b96b;

  padding:0.9rem 1.5rem;

  border-radius:999px;

  border:
    1px solid rgba(214,185,107,0.18);

  background:
    rgba(214,185,107,0.05);

  transition:0.4s;
}

.links a:hover{
  background:#d6b96b;

  color:black;

  transform:translateY(-3px);
}

/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:6rem;
  padding-top:3rem;

  display:flex;
  flex-direction:column;
  align-items:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

/* VOLTAR */

.voltar{
  text-decoration:none;

  color:#d6b96b;

  padding:1rem 1.8rem;

  border-radius:999px;

  border:
    1px solid rgba(214,185,107,0.18);

  background:
    rgba(214,185,107,0.04);

  letter-spacing:2px;

  transition:0.4s;
}

.voltar:hover{
  background:#d6b96b;

  color:black;

  transform:translateY(-3px);
}

/* ASSINATURA */

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:#f5e6c8;

  letter-spacing:4px;

  margin-bottom:0.8rem;

  font-size:0.75rem;
}

.assinatura-final p{
  color:#7d7156;

  font-size:0.72rem;

  letter-spacing:1px;
}

/* ANIMAÇÕES */

@keyframes flutuar{

  0%{
    transform:translateY(0px);
  }

  50%{
    transform:translateY(-18px);
  }

  100%{
    transform:translateY(0px);
  }

}

@keyframes via{

  0%{
    transform:translateX(-40px);
  }

  100%{
    transform:translateX(40px);
  }

}

/* RESPONSIVO */

@media(max-width:700px){

  .player-cinema{
    width:180px;
    height:100px;
  }

  .campo-conexao{
    transform:scale(0.82);
  }

}

@media(max-width:500px){

  .player-cinema{
    position:relative;

    top:0;
    left:0;

    margin-bottom:2rem;
  }

  .campo-conexao{
    transform:scale(0.68);
  }

  .hero h1{
    letter-spacing:4px;
  }

}

</style>