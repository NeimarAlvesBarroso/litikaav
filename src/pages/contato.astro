---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Parcerias e Investimentos | Lítika AV">

<main class="contato-page">

  <!-- FUNDO -->
  <div class="campo-background" aria-hidden="true">
    <div class="grid"></div>
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
  </div>




  <!-- =====================================================
       HERO
       ===================================================== -->

  <section class="hero">

    <div class="hero-content">

      <div class="eyebrow">
        LÍTIKA AV · PARCERIAS · P&D · INVESTIMENTO
      </div>

      <h1>
        Transformar
        <span>ideias em projetos</span>
      </h1>

      <p class="hero-description">
        A Lítika AV desenvolve projetos que conectam
        tecnologia, cultura, pesquisa, audiovisual,
        arqueologia visual e arquitetura vetorialética.
      </p>

      <div class="hero-actions">

        <a
          href="mailto:neimarab@gmail.com"
          class="button primary"
        >
          iniciar conversa
        </a>

        <a
          href="#proposta"
          class="button secondary"
        >
          conhecer a proposta
        </a>

      </div>

    </div>


    <div class="hero-mark">

      <div class="orbital orbital-1"></div>
      <div class="orbital orbital-2"></div>
      <div class="orbital orbital-3"></div>

      <div class="core">
        <span>◇</span>
        <small>VETOR</small>
      </div>

    </div>

  </section>


  <!-- =====================================================
       PROPOSTA
       ===================================================== -->

  <section
    class="section proposta"
    id="proposta"
  >

    <div class="section-label">
      01 · PROPOSTA
    </div>

    <div class="section-content">

      <h2>
        Uma infraestrutura
        <span>para desenvolver futuro.</span>
      </h2>

      <p class="lead">
        A Lítika AV não é apenas uma produtora audiovisual.
        É uma plataforma de desenvolvimento de projetos
        que articula pesquisa, criação, tecnologia,
        território e inovação.
      </p>

      <p>
        A partir da Vetorialética e de uma trajetória em
        audiovisual, arqueologia visual, memória e cultura,
        desenvolvemos conceitos que podem ser transformados
        em produtos, tecnologias, experiências, plataformas
        e projetos de pesquisa e desenvolvimento.
      </p>

    </div>

  </section>


  <!-- =====================================================
       CAMPOS DE ATUAÇÃO
       ===================================================== -->

  <section class="section campos">

    <div class="section-label">
      02 · CAMPOS DE ATUAÇÃO
    </div>

    <div class="cards">

      <article class="card">

        <span class="card-number">01</span>

        <h3>
          TECNOLOGIA
        </h3>

        <p>
          Desenvolvimento conceitual e pesquisa aplicada
          em arquiteturas vetorialéticas, interfaces,
          sistemas e tecnologias de campo.
        </p>

      </article>


      <article class="card">

        <span class="card-number">02</span>

        <h3>
          INDÚSTRIA
        </h3>

        <p>
          Projetos de P&D orientados à prototipação,
          materiais, design, engenharia e desenvolvimento
          de novas interfaces.
        </p>

      </article>


      <article class="card">

        <span class="card-number">03</span>

        <h3>
          AUDIOVISUAL
        </h3>

        <p>
          Cinema, documentário, memória, comunicação
          científica, patrimônio e construção de narrativas
          para projetos complexos.
        </p>

      </article>


      <article class="card">

        <span class="card-number">04</span>

        <h3>
          PESQUISA
        </h3>

        <p>
          Investigação interdisciplinar envolvendo
          arqueologia visual, cultura, território,
          ciência e sistemas relacionais.
        </p>

      </article>

    </div>

  </section>


  <!-- =====================================================
       INDÚSTRIA DA COERÊNCIA
       ===================================================== -->

  <section class="section industria">

    <div class="industry-visual">

      <div class="industry-ring ring-1"></div>
      <div class="industry-ring ring-2"></div>
      <div class="industry-ring ring-3"></div>

      <div class="industry-core">
        ◇
      </div>

    </div>


    <div class="industry-content">

      <div class="section-label">
        03 · INDÚSTRIA DA COERÊNCIA
      </div>

      <h2>
        Projetos que podem
        atravessar a fronteira
        entre pesquisa e indústria.
      </h2>

      <p>
        A Indústria da Coerência organiza projetos de
        desenvolvimento que partem de perguntas científicas,
        culturais ou tecnológicas e procuram transformá-las
        em arquiteturas concretas.
      </p>

      <a
        href="/industria-coerencia/"
        class="text-link"
      >
        conhecer a Indústria da Coerência →
      </a>

    </div>

  </section>


  <!-- =====================================================
       PROJETOS
       ===================================================== -->

  <section class="section projetos">

    <div class="section-label">
      04 · OPORTUNIDADES DE DESENVOLVIMENTO
    </div>

    <div class="project-list">


      <a
        href="/industria-coerencia/calcados-vetorialeticos/"
        class="project"
      >

        <div class="project-index">
          01
        </div>

        <div class="project-main">

          <h3>
            CALÇADOS VETORIALÉTICOS
          </h3>

          <p>
            Arquitetura de P&D para investigação da interface
            entre corpo, calçado, superfície e ambiente.
          </p>

        </div>

        <div class="project-status">
          P&D
        </div>

      </a>


      <a
        href="/mic"
        class="project"
      >

        <div class="project-index">
          02
        </div>

        <div class="project-main">

          <h3>
            MUSEU DA ILUSTRAÇÃO CIENTÍFICA
          </h3>

          <p>
            Plataforma cultural dedicada à preservação,
            pesquisa e valorização da ilustração científica
            como patrimônio.
          </p>

        </div>

        <div class="project-status">
          CULTURA
        </div>

      </a>


      <a
        href="/missa"
        class="project"
      >

        <div class="project-index">
          03
        </div>

        <div class="project-main">

          <h3>
            MISSA
          </h3>

          <p>
            Arquitetura audiovisual e museológica para
            documentação e memória de territórios e
            municípios.
          </p>

        </div>

        <div class="project-status">
          AUDIOVISUAL
        </div>

      </a>


      <a
        href="/pesquisa-vetorialetica"
        class="project"
      >

        <div class="project-index">
          04
        </div>

        <div class="project-main">

          <h3>
            VETORIALETICA
          </h3>

          <p>
            Programa de investigação sobre relação,
            campo, percepção, ressonância e sistemas
            não particulocêntricos.
          </p>

        </div>

        <div class="project-status">
          PESQUISA
        </div>

      </a>


    </div>

  </section>


  <!-- =====================================================
       MODELO DE PARCERIA
       ===================================================== -->

  <section class="section parceria">

    <div class="section-label">
      05 · MODELO DE PARCERIA
    </div>

    <div class="partnership-grid">

      <div>

        <h2>
          Desenvolvimento
          <span>em conjunto.</span>
        </h2>

        <p>
          A proposta é conectar a capacidade conceitual e
          criativa da Lítika AV às competências técnicas,
          industriais, laboratoriais e financeiras de parceiros.
        </p>

      </div>


      <div class="partnership-items">

        <div>
          <strong>
            P&D
          </strong>

          <span>
            pesquisa e desenvolvimento
          </span>
        </div>


        <div>
          <strong>
            PROTOTIPAÇÃO
          </strong>

          <span>
            transformação de conceitos em modelos
          </span>
        </div>


        <div>
          <strong>
            CO-DESENVOLVIMENTO
          </strong>

          <span>
            trabalho conjunto com empresas e laboratórios
          </span>
        </div>


        <div>
          <strong>
            PROPRIEDADE INTELECTUAL
          </strong>

          <span>
            avaliação e desenvolvimento de ativos de PI
          </span>
        </div>


        <div>
          <strong>
            LICENCIAMENTO
          </strong>

          <span>
            possibilidades futuras de exploração comercial
          </span>
        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       O QUE ESTÁ SENDO BUSCADO
       ===================================================== -->

  <section class="section busca">

    <div class="section-label">
      06 · PARCEIROS
    </div>

    <h2>
      Procuramos parceiros
      capazes de transformar
      pesquisa em escala.
    </h2>

    <div class="partner-types">

      <div>
        <span>01</span>
        <strong>INDÚSTRIAS</strong>
        <p>
          empresas interessadas em novos produtos,
          materiais, processos e tecnologias.
        </p>
      </div>


      <div>
        <span>02</span>
        <strong>LABORATÓRIOS</strong>
        <p>
          instituições para ensaios, validação,
          pesquisa aplicada e desenvolvimento técnico.
        </p>
      </div>


      <div>
        <span>03</span>
        <strong>INVESTIDORES</strong>
        <p>
          capital para desenvolvimento de projetos,
          prototipação e estruturação de novos negócios.
        </p>
      </div>


      <div>
        <span>04</span>
        <strong>INSTITUIÇÕES</strong>
        <p>
          universidades, centros de pesquisa,
          museus e organizações interessadas em inovação.
        </p>
      </div>

    </div>

  </section>


  <!-- =====================================================
       NOTA SOBRE PROPRIEDADE INTELECTUAL
       ===================================================== -->

  <section class="ip-notice">

    <div class="ip-symbol">
      ◇
    </div>

    <div>

      <span>
        PROPRIEDADE INTELECTUAL
      </span>

      <p>
        Os projetos apresentados encontram-se em diferentes
        estágios de desenvolvimento. Elementos técnicos,
        desenhos, métodos e arquiteturas potencialmente
        protegíveis deverão ser avaliados individualmente,
        inclusive quanto à anterioridade, novidade,
        patenteabilidade e liberdade de operação.
      </p>

    </div>

  </section>


  <!-- =====================================================
       CONTATO
       ===================================================== -->

  <section class="contact">

    <div class="contact-label">
      07 · CONTATO
    </div>

    <h2>
      Vamos desenvolver
      <span>o próximo projeto?</span>
    </h2>

    <p>
      Para parcerias industriais, investimento,
      pesquisa aplicada, desenvolvimento tecnológico
      ou projetos culturais, contacte-nos:
      
    
    </p>

    
   NEIMAR ALVES BARROSO
    <div class="contact-actions">

      <a
        href="mailto:neimarab@gmail.com"
        class="contact-email"
      >
        neimarab@gmail.com
      </a>

      <a
        href="tel:+5533999351436"
        class="contact-phone"
      >
        +55 33 99935-1436
      </a>

    </div>

  </section>


  <!-- =====================================================
       LINKS
       ===================================================== -->

  <section class="quick-links">

    <a href="/sobre">
      sobre
    </a>

    <a href="/projetos">
      projetos
    </a>

    <a href="/pesquisa-vetorialetica">
      vetorialética
    </a>

    <a href="/industria-coerencia">
      indústria da coerência
    </a>

  </section>


  <!-- =====================================================
       FOOTER
       ===================================================== -->

  <footer class="footer">

    <div>

      <strong>
        LÍTIKA AV
      </strong>

      <p>
        audiovisual · pesquisa · tecnologia ·
        engenharia cultural
      </p>

    </div>


    <a href="/">
      ← voltar ao início
    </a>

  </footer>

</main>


<style>

/* =========================================================
   BASE
   ========================================================= */

:global(html) {
  scroll-behavior: smooth;
}

:global(body) {
  margin: 0;
  background: #050505;
  color: #eee8d8;
  font-family:
    Inter,
    Helvetica,
    Arial,
    sans-serif;
}

:global(*) {
  box-sizing: border-box;
}

.contato-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}


/* =========================================================
   FUNDO
   ========================================================= */

.campo-background {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;

  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(214,185,107,0.09),
      transparent 35%
    ),
    #050505;
}

.grid {
  position: absolute;
  inset: 0;

  opacity: 0.18;

  background-image:
    linear-gradient(
      rgba(214,185,107,0.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(214,185,107,0.035) 1px,
      transparent 1px
    );

  background-size: 80px 80px;
}

.glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
}

.glow-1 {
  width: 500px;
  height: 500px;

  top: -250px;
  left: -150px;

  background: rgba(214,185,107,0.06);
}

.glow-2 {
  width: 500px;
  height: 500px;

  right: -200px;
  bottom: 10%;

  background: rgba(50,70,80,0.06);
}


/* =========================================================
   HEADER
   ========================================================= */

.header {
  position: relative;
  z-index: 5;

  width: min(1180px, 90%);
  margin: 0 auto;

  padding: 30px 0;

  display: flex;
  justify-content: space-between;
  align-items: center;

  border-bottom:
    1px solid rgba(255,255,255,0.06);
}

.logo {
  color: #f5e6c8;

  text-decoration: none;

  font-size: 0.78rem;
  font-weight: 700;

  letter-spacing: 0.25em;
}

.header nav {
  display: flex;
  gap: 30px;
}

.header nav a {
  color: #817968;

  text-decoration: none;

  font-size: 0.68rem;

  text-transform: uppercase;

  letter-spacing: 0.12em;

  transition: color 0.25s ease;
}

.header nav a:hover {
  color: #d6b96b;
}


/* =========================================================
   HERO
   ========================================================= */

.hero {
  position: relative;
  z-index: 2;

  width: min(1180px, 90%);
  min-height: 78vh;

  margin: 0 auto;

  display: grid;

  grid-template-columns:
    minmax(0, 1.15fr)
    minmax(320px, 0.85fr);

  gap: 80px;

  align-items: center;
}

.hero-content {
  max-width: 760px;
}

.eyebrow {
  color: #d6b96b;

  font-size: 0.65rem;
  font-weight: 700;

  letter-spacing: 0.2em;

  margin-bottom: 30px;
}

.hero h1 {
  margin: 0;

  color: #f5e6c8;

  font-size: clamp(4rem, 8vw, 8.5rem);

  line-height: 0.88;

  letter-spacing: -0.07em;
}

.hero h1 span {
  display: block;
  color: #d6b96b;
}

.hero-description {
  max-width: 650px;

  margin: 45px 0 35px;

  color: #9e9687;

  font-size: 1.1rem;

  line-height: 1.8;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.button {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 48px;

  padding: 0 24px;

  border-radius: 999px;

  text-decoration: none;

  font-size: 0.7rem;

  text-transform: uppercase;

  letter-spacing: 0.12em;

  transition:
    transform 0.25s ease,
    background 0.25s ease,
    color 0.25s ease;
}

.button.primary {
  color: #050505;

  background: #d6b96b;
}

.button.secondary {
  color: #d6b96b;

  border:
    1px solid rgba(214,185,107,0.25);

  background:
    rgba(214,185,107,0.04);
}

.button:hover {
  transform: translateY(-2px);
}


/* =========================================================
   HERO — MARCA
   ========================================================= */

.hero-mark {
  position: relative;

  width: min(420px, 100%);
  aspect-ratio: 1;

  margin: auto;
}

.core {
  position: absolute;

  top: 50%;
  left: 50%;

  width: 130px;
  height: 130px;

  transform: translate(-50%, -50%);

  display: flex;
  flex-direction: column;

  justify-content: center;
  align-items: center;

  border:
    1px solid rgba(214,185,107,0.3);

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(214,185,107,0.13),
      rgba(0,0,0,0.4)
    );

  box-shadow:
    0 0 80px rgba(214,185,107,0.08);
}

.core span {
  color: #d6b96b;
  font-size: 2.5rem;
}

.core small {
  margin-top: 5px;

  color: #84765c;

  font-size: 0.55rem;

  letter-spacing: 0.2em;
}

.orbital {
  position: absolute;

  top: 50%;
  left: 50%;

  border:
    1px solid rgba(214,185,107,0.15);

  border-radius: 50%;

  transform: translate(-50%, -50%) rotate(25deg);
}

.orbital-1 {
  width: 75%;
  height: 35%;
}

.orbital-2 {
  width: 85%;
  height: 48%;

  transform:
    translate(-50%, -50%)
    rotate(-35deg);
}

.orbital-3 {
  width: 60%;
  height: 85%;

  transform:
    translate(-50%, -50%)
    rotate(65deg);
}


/* =========================================================
   SEÇÕES
   ========================================================= */

.section {
  position: relative;
  z-index: 2;

  width: min(1180px, 90%);

  margin: 0 auto;

  padding: 130px 0;

  border-top:
    1px solid rgba(255,255,255,0.07);
}

.section-label,
.contact-label {
  margin-bottom: 45px;

  color: #d6b96b;

  font-size: 0.62rem;

  font-weight: 700;

  letter-spacing: 0.2em;
}

.section-content {
  max-width: 900px;
}

.section h2 {
  margin: 0 0 40px;

  max-width: 950px;

  color: #f5e6c8;

  font-size: clamp(2.8rem, 6vw, 6rem);

  line-height: 0.95;

  letter-spacing: -0.06em;
}

.section h2 span {
  color: #d6b96b;
}

.section p {
  color: #999183;

  font-size: 1rem;

  line-height: 1.85;
}

.lead {
  color: #e5ddca !important;

  font-size: 1.35rem !important;

  line-height: 1.55 !important;

  max-width: 820px;
}


/* =========================================================
   CARDS
   ========================================================= */

.cards {
  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 1px;

  background:
    rgba(255,255,255,0.08);

  border:
    1px solid rgba(255,255,255,0.08);
}

.card {
  min-height: 310px;

  padding: 30px;

  background: #080808;
}

.card-number {
  color: #d6b96b;

  font-size: 0.62rem;

  letter-spacing: 0.15em;
}

.card h3 {
  margin: 80px 0 18px;

  color: #eee8d8;

  font-size: 0.8rem;

  letter-spacing: 0.15em;
}

.card p {
  margin: 0;

  color: #777267;

  font-size: 0.78rem;

  line-height: 1.7;
}


/* =========================================================
   INDÚSTRIA
   ========================================================= */

.industria {
  display: grid;

  grid-template-columns:
    0.8fr
    1.2fr;

  gap: 100px;

  align-items: center;
}

.industry-visual {
  position: relative;

  width: min(420px, 100%);

  aspect-ratio: 1;

  margin: auto;
}

.industry-ring {
  position: absolute;

  top: 50%;
  left: 50%;

  border:
    1px solid rgba(214,185,107,0.18);

  border-radius: 50%;

  transform: translate(-50%, -50%);
}

.ring-1 {
  width: 45%;
  height: 45%;
}

.ring-2 {
  width: 70%;
  height: 70%;
}

.ring-3 {
  width: 95%;
  height: 95%;
}

.industry-core {
  position: absolute;

  top: 50%;
  left: 50%;

  width: 90px;
  height: 90px;

  transform: translate(-50%, -50%);

  display: flex;

  align-items: center;
  justify-content: center;

  color: #d6b96b;

  font-size: 2.5rem;

  border:
    1px solid rgba(214,185,107,0.35);

  border-radius: 50%;

  background:
    rgba(214,185,107,0.04);
}

.industry-content h2 {
  font-size: clamp(2.5rem, 5vw, 5rem);
}

.text-link {
  display: inline-block;

  margin-top: 25px;

  color: #d6b96b;

  text-decoration: none;

  font-size: 0.72rem;

  letter-spacing: 0.08em;
}


/* =========================================================
   PROJETOS
   ========================================================= */

.project-list {
  border-top:
    1px solid rgba(255,255,255,0.08);
}

.project {
  display: grid;

  grid-template-columns: 80px 1fr auto;

  gap: 30px;

  align-items: center;

  padding: 32px 10px;

  border-bottom:
    1px solid rgba(255,255,255,0.08);

  text-decoration: none;

  transition:
    background 0.3s ease,
    padding 0.3s ease;
}

.project:hover {
  padding-left: 20px;

  background:
    rgba(214,185,107,0.035);
}

.project-index {
  color: #d6b96b;

  font-size: 0.65rem;
}

.project-main h3 {
  margin: 0 0 8px;

  color: #eee8d8;

  font-size: 0.9rem;

  letter-spacing: 0.1em;
}

.project-main p {
  margin: 0;

  max-width: 650px;

  color: #777267;

  font-size: 0.8rem;
}

.project-status {
  color: #84775d;

  font-size: 0.58rem;

  letter-spacing: 0.14em;
}


/* =========================================================
   PARCERIA
   ========================================================= */

.partnership-grid {
  display: grid;

  grid-template-columns:
    1fr
    1fr;

  gap: 100px;
}

.partnership-items {
  border-top:
    1px solid rgba(255,255,255,0.08);
}

.partnership-items > div {
  display: flex;

  flex-direction: column;

  gap: 7px;

  padding: 22px 0;

  border-bottom:
