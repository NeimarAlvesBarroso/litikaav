---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="MUTAM — Museu do Tambor Mineiro">

<main class="campo">

  <!-- PLAYER RESSONANTE -->
  <div class="player-cinema">

    <iframe
      src="https://www.youtube.com/embed/BwH67-iwMto?autoplay=1&mute=1&controls=1&loop=1&playlist=BwH67-iwMto"
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen>
    </iframe>

  </div>

  <!-- FUNDO -->
  <div class="bg"></div>

  <!-- HERO -->
  <section class="hero">

    <span class="assinatura">
      rede missa • arqueologia sonora • memória vibracional
    </span>

    <h1>
      MUTAM
    </h1>

    <div class="linha"></div>

    <p class="sub">
      museu do tambor mineiro
    </p>

  </section>

  <!-- INTRO -->
  <section class="intro">

    <div class="texto">

      <h2>
        O SOM COMO INFRAESTRUTURA CULTURAL
      </h2>

      <p>
        O MUTAM — Museu do Tambor Mineiro —
        nasce como um núcleo de documentação,
        preservação e ativação das culturas
        percussivas de Minas Gerais,
        integrando arqueologia sonora,
        audiovisual,
        memória territorial
        e tecnologias vetorialéticas.
      </p>

      <p>
        O projeto propõe a criação de uma plataforma
        cultural permanente dedicada aos tambores,
        congados,
        cortejos,
        ritmos afro-brasileiros,
        tecnologias vibracionais
        e sistemas ancestrais de comunicação coletiva.
      </p>

      <p>
        Inserido no ecossistema MIC • MISSA • LÍTIKA AV,
        o MUTAM busca estruturar
        um grande repositório audiovisual e museológico
        sobre a inteligência sonora brasileira.
      </p>

    </div>

    <!-- PAINEL -->
    <div class="painel">

      <div class="janela">

        <span>território</span>

        <strong>
          minas gerais • brasil • diáspora africana
        </strong>

      </div>

      <div class="janela">

        <span>estrutura</span>

        <strong>
          museu audiovisual,
          documentação sonora
          e arqueologia vibracional
        </strong>

      </div>

      <div class="janela">

        <span>projeção</span>

        <strong>
          patrimônio cultural,
          turismo,
          educação
          e inteligência sonora
        </strong>

      </div>

    </div>

  </section>

  <!-- CALAMÉ -->
  <section class="calame">

    <div class="calame-box">

      <h2>
        CALAMÉ
      </h2>

      <span>
        possível maior instrumento musical do mundo
      </span>

      <p>
        Uma das hipóteses arqueológicas mais singulares
        desenvolvidas no âmbito das pesquisas
        do arqueólogo e documentarista
        Neimar Alves Barroso
        aponta para a possível identificação
        do maior instrumento musical do planeta,
        localizado no distrito de Quilombo,
        em Sabinópolis, Minas Gerais.
      </p>

      <p>
        Batizado de <strong>Calamé</strong>,
        o fenômeno sonoro teria emergido
        a partir de um furo de sondagem
        realizado em um antigo cânion,
        durante tentativas interrompidas
        de implantação de uma barragem hidrelétrica.
      </p>

      <p>
        Desde que descoberto, quando tocado como um tambor, o monumento produz ressonâncias acústicas
        naturais de grande intensidade,
        transformando-se em um possível
        instrumento geológico de escala monumental,
        conectando engenharia,
        arqueologia,
        acústica
        e paisagem sonora.
      </p>

      <p>
        O estudo integra o campo da arqueologia sonora vetorialética,
        propondo novas leituras sobre
        vibração,
        território
        e inteligência material da paisagem.
      </p>

    </div>

  </section>

  <!-- CAMADAS -->
  <section class="camadas">

    <div class="titulo">

      <h2>
        CAMPO RÍTMICO
      </h2>

      <p>
        tecnologias ancestrais do som
      </p>

    </div>

    <div class="grid-camadas">

      <div class="bloco">

        <h3>
          CONGADOS
        </h3>

        <p>
          guardas tradicionais,
          espiritualidade,
          ancestralidade
          e sincronização coletiva.
        </p>

      </div>

      <div class="bloco">

        <h3>
          TAMBOR MINEIRO
        </h3>

        <p>
          estudo das matrizes sonoras,
          ritmos tradicionais
          e tecnologias vibracionais.
        </p>

      </div>

      <div class="bloco">

        <h3>
          ARQUEOLOGIA SONORA
        </h3>

        <p>
          investigação dos sons
          produzidos por estruturas,
          territórios
          e paisagens naturais.
        </p>

      </div>

      <div class="bloco">

        <h3>
          AUDIOVISUAL
        </h3>

        <p>
          documentação fotográfica,
          cinema,
          acervo digital
          e museologia expandida.
        </p>

      </div>

    </div>

  </section>

  <!-- MANIFESTO -->
  <section class="manifesto">

    <div class="manifesto-box">

      <h2>
        O TAMBOR COMO TECNOLOGIA
      </h2>

      <p>
        O tambor não é apenas instrumento musical.
        É tecnologia ancestral de comunicação,
        sincronização social,
        memória coletiva
        e organização territorial.
      </p>

      <p>
        O MUTAM propõe transformar
        esta inteligência sonora
        em infraestrutura cultural,
        educacional,
        turística
        e científica.
      </p>

    </div>

  </section>

  <!-- REDES -->
  <section class="redes">

    <a
      href="https://www.facebook.com/museudotambormineiro"
      target="_blank"
      class="rede">

      FACEBOOK

    </a>

    <a
      href="https://www.youtube.com/channel/UCwQRhpgossnGp4d7cx9EpuA"
      target="_blank"
      class="rede">

      YOUTUBE

    </a>

    <a href="/projetos" class="rede">
      PROJETOS
    </a>

  </section>

  <!-- FLUXO -->
  <section class="fluxo">

    <p class="destaque">
      vibração • território • ancestralidade • memória
    </p>

    <p>
      O MUTAM articula cultura,
      arqueologia,
      cinema,
      música,
      patrimônio imaterial
      e inteligência vetorialética
      em um ecossistema permanente
      dedicado às tecnologias sonoras brasileiras.
    </p>

  </section>

  <!-- RODAPÉ -->
  <footer class="rodape">

    <a href="javascript:history.back()" class="voltar-rodape">
      ← voltar
    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV.
      </span>

      <p>
        engenharia cultural • audiovisual • vetorialética • arqueologia sonora
      </p>

    </div>

  </footer>

</main>

</BaseLayout>

<style>

/* BASE */

.campo{
  position:relative;

  min-height:100vh;

  overflow:hidden;

  padding:4rem 1.5rem 8rem;

  background:black;

  display:flex;
  flex-direction:column;
  align-items:center;
}

/* FUNDO */

.bg{
  position:fixed;
  inset:0;

  z-index:-5;

  background:
    radial-gradient(circle at top,
    rgba(120,45,15,0.32),
    rgba(0,0,0,0.96)),
    linear-gradient(180deg,#050505,#000);
}

/* PLAYER */

.player-cinema{
  position:fixed;

  top:90px;
  left:20px;

  width:270px;
  height:155px;

  z-index:50;

  overflow:hidden;

  border-radius:18px;

  border:
    1px solid rgba(255,255,255,0.08);

  background:
    rgba(0,0,0,0.65);

  backdrop-filter:blur(12px);

  transition:0.4s;
}

.player-cinema:hover{
  transform:scale(1.02);
}

.player-cinema iframe{
  width:100%;
  height:100%;
  border:none;
}

/* HERO */

.hero{
  min-height:70vh;

  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;

  text-align:center;

  max-width:1000px;
}

.assinatura{
  color:#d7a56a;

  font-size:0.72rem;

  letter-spacing:4px;

  text-transform:uppercase;

  margin-bottom:1rem;
}

.hero h1{
  font-size:clamp(3rem,8vw,6rem);

  color:#f5e0c7;

  letter-spacing:10px;

  margin:0;

  text-shadow:
    0 0 35px rgba(255,150,80,0.18);
}

.linha{
  width:180px;
  height:1px;

  margin:2rem 0;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(255,180,100,0.95),
      transparent
    );
}

.sub{
  color:#b58f67;

  letter-spacing:3px;
}

/* INTRO */

.intro{
  width:100%;
  max-width:1200px;

  display:grid;

  grid-template-columns:1.2fr 0.8fr;

  gap:2rem;
}

.texto,
.janela,
.bloco,
.calame-box,
.manifesto-box{

  background:
    linear-gradient(
      145deg,
      rgba(35,18,8,0.72),
      rgba(5,5,5,0.92)
    );

  border:
    1px solid rgba(255,255,255,0.05);

  backdrop-filter:blur(10px);

  border-radius:24px;
}

.texto{
  padding:2.2rem;
}

.texto h2{
  color:#f5e0c7;

  margin-bottom:1.5rem;

  letter-spacing:2px;
}

.texto p{
  color:#d0b090;

  line-height:1.9;

  margin-bottom:1.3rem;
}

/* PAINEL */

.painel{
  display:flex;
  flex-direction:column;
  gap:1.5rem;
}

.janela{
  padding:1.8rem;
}

.janela span{
  display:block;

  margin-bottom:0.8rem;

  color:#d39a5f;

  font-size:0.7rem;

  letter-spacing:2px;

  text-transform:uppercase;
}

.janela strong{
  color:#f5e0c7;

  line-height:1.8;
}

/* CALAMÉ */

.calame{
  width:100%;
  max-width:1100px;

  margin-top:6rem;
}

.calame-box{
  padding:3rem;
}

.calame-box h2{
  color:#f5e0c7;

  letter-spacing:5px;

  margin-bottom:1rem;
}

.calame-box span{
  display:block;

  margin-bottom:2rem;

  color:#d39a5f;

  letter-spacing:2px;

  font-size:0.75rem;

  text-transform:uppercase;
}

.calame-box p{
  color:#cfb08d;

  line-height:1.9;

  margin-bottom:1.4rem;
}

/* CAMADAS */

.camadas{
  width:100%;
  max-width:1200px;

  margin-top:7rem;
}

.titulo{
  text-align:center;

  margin-bottom:3rem;
}

.titulo h2{
  color:#f5e0c7;

  letter-spacing:5px;

  margin-bottom:1rem;
}

.titulo p{
  color:#b58f67;
}

.grid-camadas{
  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(240px,1fr));

  gap:1.5rem;
}

.bloco{
  padding:2rem;

  transition:0.4s;
}

.bloco:hover{
  transform:translateY(-8px);

  border-color:#ffb067;
}

.bloco h3{
  color:#f5e0c7;

  margin-bottom:1rem;

  letter-spacing:2px;
}

.bloco p{
  color:#d0b090;

  line-height:1.8;
}

/* MANIFESTO */

.manifesto{
  width:100%;
  max-width:1000px;

  margin-top:7rem;
}

.manifesto-box{
  padding:3rem;

  text-align:center;
}

.manifesto-box h2{
  color:#f5e0c7;

  margin-bottom:2rem;

  letter-spacing:4px;
}

.manifesto-box p{
  color:#d0b090;

  line-height:1.9;

  max-width:800px;

  margin:0 auto 1.5rem;
}

/* REDES */

.redes{
  margin-top:6rem;

  display:flex;
  gap:1.5rem;
  flex-wrap:wrap;

  justify-content:center;
}

.rede{
  text-decoration:none;

  padding:1rem 1.6rem;

  border-radius:999px;

  color:#f5e0c7;

  border:
    1px solid rgba(255,180,100,0.16);

  background:
    rgba(255,180,100,0.05);

  letter-spacing:2px;

  font-size:0.72rem;

  transition:0.35s;
}

.rede:hover{
  background:#ffb067;

  color:black;

  transform:translateY(-3px);
}

/* FLUXO */

.fluxo{
  max-width:900px;

  margin-top:6rem;

  text-align:center;
}

.fluxo p{
  color:#c79c72;

  line-height:1.9;

  margin-bottom:1.5rem;
}

.fluxo .destaque{
  color:#f5e0c7;

  font-size:1.3rem;
}

/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:7rem;
  padding-top:3rem;
  padding-bottom:2rem;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

.voltar-rodape{

  text-decoration:none;

  color:#ffb067;

  font-size:0.74rem;

  letter-spacing:2px;
  text-transform:uppercase;

  padding:1rem 1.7rem;

  border-radius:999px;

  background:
    linear-gradient(
      145deg,
      rgba(255,180,100,0.08),
      rgba(0,0,0,0.55)
    );

  border:
    1px solid rgba(255,180,100,0.22);

  transition:0.4s ease;
}

.voltar-rodape:hover{

  background:#ffb067;

  color:black;

  transform:
    translateY(-4px)
    scale(1.03);
}

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:#f5e0c7;

  font-size:0.76rem;

  letter-spacing:4px;

  margin-bottom:0.8rem;
}

.assinatura-final p{

  color:#9d7754;

  font-size:0.72rem;

  letter-spacing:1px;

  line-height:1.7;
}

/* RESPONSIVO */

@media(max-width:900px){

  .intro{
    grid-template-columns:1fr;
  }

}

@media(max-width:700px){

  .player-cinema{
    width:180px;
    height:100px;
  }

}

@media(max-width:500px){

  .player-cinema{
    position:relative;

    top:0;
    left:0;

    margin-bottom:2rem;
  }

  .hero h1{
    letter-spacing:4px;
  }

}

</style>