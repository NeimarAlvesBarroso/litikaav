---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="MUTAM — Museu do Tambor e da Percussão">

<main class="campo">

  <!-- PLAYER -->
  <div class="player-cinema">
    <iframe
      src="https://www.youtube.com/embed/BLKHnyXy2ss?autoplay=1&mute=1&controls=1&loop=1&playlist=BLKHnyXy2ss"
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen>
    </iframe>
  </div>

  <!-- FUNDO -->
  <div class="bg"></div>

  <!-- HERO -->
  <section class="hero">

    <span class="assinatura">
      rede vetorialética de memória sonora
    </span>

    <h1>MUTAMBO</h1>

    <div class="linha"></div>

    <p class="sub">
      museu do tambor e da percussão
    </p>

  </section>

  <!-- MANIFESTO -->
  <section class="manifesto">

    <div class="texto">

      <h2>
        A PERCUSSÃO COMO GESTO FUNDAMENTAL
      </h2>

      <p>
        O MUTAM — Museu do Tambor e da Percussão —
        é um projeto voltado à documentação,
        investigação e preservação da história
        da musicalidade humana e não humana,
        compreendendo a percussão como
        estrutura primordial do som.
      </p>

      <p>
        A hipótese central do projeto afirma:
        sem percussão não há som,
        não há música,
        não há ritmo,
        não há linguagem vibracional.
      </p>

      <p>
        Das batidas ancestrais sobre troncos,
        pedras e tambores rituais,
        até as pulsações eletrônicas contemporâneas,
        a percussão emerge como
        gesto central da organização sonora.
      </p>

      <p>
        O MUTAM investiga as culturas do ritmo,
        os instrumentos históricos,
        as musicalidades indígenas,
        africanas, populares e experimentais,
        bem como os sons naturais:
        rios, ventos, oceanos,
        vibrações geológicas,
        ressonâncias minerais
        e arquiteturas acústicas monumentais.
      </p>

    </div>

    <div class="painel">

      <div class="janela">
        <span>hipótese estrutural</span>

        <strong>
          toda musicalidade nasce
          de um evento percussivo
        </strong>
      </div>

      <div class="janela">
        <span>campo de pesquisa</span>

        <strong>
          tambores · ruídos · ressonância ·
          ritmo · arqueologia sonora
        </strong>
      </div>

      <div class="janela">
        <span>escala</span>

        <strong>
          dos menores gestos corporais
          aos maiores instrumentos naturais
          do planeta
        </strong>
      </div>

    </div>

  </section>

  <!-- DESTAQUES -->
  <section class="estrutura">

    <div class="titulo">

      <h2>
        GEOLOGIA DO SOM
      </h2>

      <p>
        o ritmo está em tudo
      </p>

    </div>

    <div class="campo-grid">

      <div class="bloco destaque">

        <h2>CALAMÉ</h2>

        <p>
          Pesquisa desenvolvida pelo arqueólogo
          Neimar Alves Barroso
          sobre o possível maior instrumento
          musical do mundo:
          um gigantesco sistema ressonante
          localizado em Sabinópolis,
          Minas Gerais.
        </p>

        <p>
          O instrumento teria surgido a partir
          de um furo de sondagem
          realizado em um antigo canteiro
          de obras abandonado após tentativas
          de construção de uma barragem
          hidrelétrica.
        </p>

      </div>

      <div class="bloco">

        <h2>RITMO NATURAL</h2>

        <p>
          Marulhar dos rios,
          impacto das chuvas,
          vibração tectônica,
          pulsações biológicas,
          ventos e cavernas
          são compreendidos como
          expressões percussivas naturais.
        </p>

      </div>

      <div class="bloco">

        <h2>ARQUEOLOGIA SONORA</h2>

        <p>
          O museu propõe
          catalogação de instrumentos,
          culturas rítmicas,
          tecnologias acústicas
          e paisagens sonoras
          ancestrais e contemporâneas.
        </p>

      </div>

      <div class="bloco">

        <h2>ACERVO GLOBAL</h2>

        <p>
          O projeto pretende constituir
          um dos maiores arquivos digitais
          sobre percussão,
          musicalidade e culturas do ritmo
          já organizados no Brasil.
        </p>

      </div>

    </div>

  </section>

  <!-- REDES -->
  <section class="redes">

    <h2>
      REDES DO PROJETO
    </h2>

    <div class="links">

      <a
        href="https://www.facebook.com/museudotamboredapercussa"
        target="_blank">

        FACEBOOK

      </a>

      <a
        href="https://www.youtube.com/channel/UCn_1zDH-aa2KaPAlO9dkVSQ?view_as=subscriber"
        target="_blank">

        YOUTUBE

      </a>

    </div>

  </section>

  <!-- VISÃO -->
  <section class="visao">

    <div class="manifesto-box">

      <h2>
        O SOM COMO INFRAESTRUTURA
      </h2>

      <p>
        O MUTAM propõe uma nova compreensão
        da música como fenômeno contínuo,
        territorial e ecológico.
      </p>

      <p>
        Mais do que um museu tradicional,
        o projeto busca consolidar
        um ecossistema de documentação,
        educação,
        pesquisa acústica,
        inteligência cultural
        e preservação da memória sonora.
      </p>

    </div>

  </section>

  <!-- RODAPÉ -->
  <footer class="rodape">

    <a href="javascript:history.back()" class="voltar">
      ← voltar
    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV.
      </span>

      <p>
        engenharia cultural • arqueologia sonora • audiovisual • vetorialética
      </p>

    </div>

  </footer>

</main>

</BaseLayout>

<style>

/* BASE */

.campo{
  position:relative;

  min-height:100vh;

  overflow:hidden;

  padding:4rem 1.5rem 8rem;

  background:black;

  display:flex;
  flex-direction:column;
  align-items:center;
}

/* BG */

.bg{
  position:fixed;
  inset:0;

  z-index:-3;

  background:
    radial-gradient(circle at top,
    rgba(120,60,15,0.25),
    rgba(0,0,0,0.95)),
    linear-gradient(180deg,#040404,#000);
}

/* PLAYER */

.player-cinema{
  position:fixed;

  top:90px;
  left:20px;

  width:260px;
  height:150px;

  z-index:50;

  overflow:hidden;

  border-radius:16px;

  border:
    1px solid rgba(255,255,255,0.08);

  background:
    rgba(0,0,0,0.7);

  backdrop-filter:blur(10px);

  transition:0.4s;
}

.player-cinema:hover{
  transform:scale(1.03);
}

.player-cinema iframe{
  width:100%;
  height:100%;
  border:none;
}

/* HERO */

.hero{
  min-height:65vh;

  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;

  text-align:center;

  max-width:1000px;
}

.assinatura{
  color:#d8aa67;

  font-size:0.72rem;

  letter-spacing:4px;

  text-transform:uppercase;

  margin-bottom:1rem;
}

.hero h1{
  font-size:clamp(3rem,8vw,6rem);

  letter-spacing:10px;

  color:#f6e6cb;

  margin:0;

  text-shadow:
    0 0 30px rgba(214,185,107,0.18);
}

.linha{
  width:200px;
  height:1px;

  margin:2rem 0;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(214,185,107,0.9),
      transparent
    );
}

.sub{
  color:#98815f;

  letter-spacing:3px;

  line-height:1.8;
}

/* MANIFESTO */

.manifesto{
  width:100%;
  max-width:1200px;

  display:grid;
  grid-template-columns:1.2fr 0.8fr;

  gap:2rem;
}

.texto,
.janela,
.bloco,
.manifesto-box{
  background:
    linear-gradient(
      145deg,
      rgba(20,12,5,0.75),
      rgba(5,5,5,0.92)
    );

  border:
    1px solid rgba(255,255,255,0.05);

  border-radius:24px;

  backdrop-filter:blur(10px);
}

.texto{
  padding:2.5rem;
}

.texto h2{
  color:#f5e6c8;

  margin-bottom:1.5rem;

  letter-spacing:2px;
}

.texto p{
  color:#c2b49a;

  line-height:1.95;

  margin-bottom:1.4rem;
}

/* PAINEL */

.painel{
  display:flex;
  flex-direction:column;
  gap:1.5rem;
}

.janela{
  padding:1.8rem;
}

.janela span{
  display:block;

  margin-bottom:0.8rem;

  color:#b18b55;

  font-size:0.7rem;

  letter-spacing:2px;

  text-transform:uppercase;
}

.janela strong{
  color:#f5e6c8;

  line-height:1.7;
}

/* ESTRUTURA */

.estrutura{
  width:100%;
  max-width:1200px;

  margin-top:6rem;
}

.titulo{
  text-align:center;

  margin-bottom:3rem;
}

.titulo h2{
  color:#f5e6c8;

  letter-spacing:5px;

  margin-bottom:1rem;
}

.titulo p{
  color:#9b835d;
}

/* GRID */

.campo-grid{
  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(240px,1fr));

  gap:1.5rem;
}

/* BLOCOS */

.bloco{
  padding:2rem;

  transition:0.4s;
}

.bloco:hover{
  transform:translateY(-8px);

  border-color:#d6b96b;
}

.bloco h2{
  color:#f5e6c8;

  margin-bottom:1rem;

  letter-spacing:2px;
}

.bloco p{
  color:#bcae93;

  line-height:1.8;
}

.destaque{
  grid-column:span 2;

  border:
    1px solid rgba(214,185,107,0.18);
}

/* REDES */

.redes{
  width:100%;

  max-width:1000px;

  margin-top:6rem;

  text-align:center;
}

.redes h2{
  color:#f5e6c8;

  letter-spacing:4px;

  margin-bottom:2rem;
}

.links{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;

  gap:1.5rem;
}

.links a{
  text-decoration:none;

  padding:1rem 1.6rem;

  border-radius:999px;

  background:
    rgba(214,185,107,0.06);

  border:
    1px solid rgba(214,185,107,0.16);

  color:#d9c08d;

  letter-spacing:2px;

  font-size:0.78rem;

  transition:0.35s;
}

.links a:hover{
  background:#d6b96b;

  color:black;

  transform:translateY(-4px);
}

/* VISÃO */

.visao{
  width:100%;
  max-width:1000px;

  margin-top:6rem;
}

.manifesto-box{
  padding:3rem;

  text-align:center;
}

.manifesto-box h2{
  color:#f5e6c8;

  margin-bottom:2rem;

  letter-spacing:4px;
}

.manifesto-box p{
  color:#b8ab8f;

  line-height:1.9;

  max-width:820px;

  margin:0 auto 1.5rem;
}

/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:6rem;
  padding-top:3rem;

  display:flex;
  flex-direction:column;
  align-items:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

/* VOLTAR */

.voltar{
  text-decoration:none;

  color:#d6b96b;

  border:
    1px solid rgba(214,185,107,0.18);

  padding:0.9rem 1.6rem;

  border-radius:999px;

  letter-spacing:2px;

  font-size:0.75rem;

  transition:0.35s;

  background:
    rgba(214,185,107,0.04);

  backdrop-filter:blur(8px);
}

.voltar:hover{
  background:#d6b96b;

  color:black;

  transform:translateY(-3px);
}

/* ASSINATURA */

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:#f5e6c8;

  letter-spacing:4px;

  font-size:0.75rem;

  margin-bottom:0.8rem;
}

.assinatura-final p{
  color:#7d7156;

  font-size:0.72rem;

  letter-spacing:1px;
}

/* RESPONSIVO */

@media(max-width:900px){

  .manifesto{
    grid-template-columns:1fr;
  }

  .destaque{
    grid-column:span 1;
  }

}

@media(max-width:700px){

  .player-cinema{
    width:180px;
    height:100px;
  }

}

@media(max-width:500px){

  .hero h1{
    letter-spacing:4px;
  }

  .player-cinema{
    position:relative;

    top:0;
    left:0;

    margin-bottom:2rem;
  }

}

</style>