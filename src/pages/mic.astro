---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="MIC — Museu da Ilustração Científica">

<main class="mic">

  <!-- BOTÃO FLUTUANTE -->
  <a href="javascript:history.back()" class="voltar-flutuante">
    ← voltar
  </a>
  <!-- VOLTAR -->
  <a href="/" class="voltar">
    ← voltar
  </a>

  <!-- PLAYER -->
  <div class="player-radio">
    <iframe
      src="https://www.youtube.com/embed/woPdy9O1z2A?autoplay=1&mute=0&controls=1&loop=1&playlist=woPdy9O1z2A"
      title="MIC Rádio"
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen
    ></iframe>
  </div>

  <!-- FUNDO -->
  <div class="bg-video">
    <iframe
      src="https://www.youtube.com/embed/VCJXhXuQVUs?autoplay=1&mute=1&controls=0&loop=1&playlist=VCJXhXuQVUs&modestbranding=1&rel=0"
      frameborder="0"
      allow="autoplay"
    ></iframe>
  </div>

  <!-- OVERLAY -->
  <div class="overlay"></div>

  <!-- HERO -->
  <section class="hero">

    <span class="assinatura">
      arqueologia visual · museologia crítica · ciência da imagem
    </span>

    <h1>MIC</h1>

    <div class="linha"></div>

    <p class="manifesto">
      Museu da Ilustração Científica —
      uma infraestrutura vetorialética de preservação,
      curadoria e reativação dos vetores imagéticos
      do conhecimento humano.
    </p>

  </section>

  <!-- INTRO -->
  <section class="intro">

    <div class="texto">

      <h2>O QUE É O MIC</h2>

      <p>
        O Museu da Ilustração Científica (MIC) é um projeto
        de museologia crítica, arqueologia visual e curadoria científica
        voltado à documentação das imagens, modelos,
        diagramas, sons e representações produzidas
        pela humanidade para explicar o mundo.
      </p>

      <p>
        O projeto nasce a partir das entrevistas realizadas
        com Marcello Guimarães Mello para o documentário
        Carta 7, tornando-se posteriormente um dos
        núcleos fundadores da Vetorialética.
      </p>

      <p>
        O MIC entende que toda civilização produz imagens
        para organizar a realidade.
      </p>

      <p>
        Assim, mapas, desenhos anatômicos, modelos astronômicos,
        reconstruções arqueológicas, ilustrações botânicas,
        fotografias técnicas, infográficos e simulações digitais
        tornam-se documentos ativos da história do conhecimento.
      </p>

    </div>

    <div class="painel">

      <div class="janela">
        <span>natureza</span>
        <strong>museu expandido da cultura científica visual</strong>
      </div>

      <div class="janela">
        <span>estado</span>
        <strong>plataforma em desenvolvimento internacional</strong>
      </div>

      <div class="janela">
        <span>objetivo</span>
        <strong>preservação + educação + arqueologia visual</strong>
      </div>

    </div>

  </section>

  <!-- GALERIAS -->
  <section class="estrutura">

    <div class="titulo-area">
      <h2>ESTRUTURA CONCEITUAL</h2>
      <p>o museu como ecossistema vetorialético</p>
    </div>

    <div class="grid">

      <div class="card destaque">
        <h3>GALERIA ZERO</h3>
        <p>
          Curadoria inaugural voltada à Antártida,
          reunindo ilustrações científicas, registros
          históricos, cartografias e imagens do continente gelado.
        </p>
      </div>

      <div class="card">
        <h3>RESERVA TÉCNICA A–Z</h3>
        <p>
          Arquivo enciclopédico mundial da ilustração científica,
          organizado por áreas do saber, técnicas,
          territórios e períodos históricos.
        </p>
      </div>

      <div class="card">
        <h3>GALERIA DE ILUSTRADORES</h3>
        <p>
          Catálogo internacional de ilustradores científicos,
          arqueólogos gráficos, naturalistas,
          modeladores e desenhistas anatômicos.
        </p>
      </div>

      <div class="card">
        <h3>MEMORIAIS</h3>
        <p>
          Núcleos territoriais e comunitários
          integrando arqueologia, museologia
          e preservação audiovisual.
        </p>
      </div>

      <div class="card">
        <h3>MOSTRA INSCRIÇÕES</h3>
        <p>
          Festival internacional de arqueologia visual,
          audiovisual científico e documentação simbólica.
        </p>
      </div>

      <div class="card">
        <h3>MISSA</h3>
        <p>
          Plataforma derivada do MIC para implantação
          de equipamentos digitais inspirados
          em museus da imagem e do som
          em pequenos municípios.
        </p>
      </div>

    </div>

  </section>

  <!-- VETORIALÉTICA -->
  <section class="vetorialetica">

    <div class="bloco-vetor">

      <h2>MIC + VETORIALÉTICA</h2>

      <p>
        Na perspectiva vetorialética,
        uma imagem científica não é apenas representação:
        ela funciona como vetor organizador da percepção humana.
      </p>

      <p>
        Diagramas moldam civilizações.
        Modelos reorganizam ciência.
        Imagens alteram sociedades.
      </p>

      <p class="frase">
        o MIC é um museu dos vetores visuais da humanidade.
      </p>

    </div>

  </section>

  <!-- REDE -->
  <section class="rede">

    <div class="titulo-area">
      <h2>REDE DE CURADORIA</h2>
      <p>infraestrutura em expansão</p>
    </div>

    <div class="links-grid">

      <a
        href="https://www.facebook.com/groups/1150549225138533?locale=pt_BR"
        target="_blank"
        class="link-card"
      >
        <span>facebook</span>
        <strong>comunidade de pesquisa e pré-curadoria</strong>
      </a>

      <a
        href="https://museudailustracao.blogspot.com/"
        target="_blank"
        class="link-card"
      >
        <span>blog</span>
        <strong>arquivo textual e documentação histórica</strong>
      </a>

      <a
        href="https://www.youtube.com/@museudailustracao"
        target="_blank"
        class="link-card"
      >
        <span>youtube</span>
        <strong>audiovisual científico e arqueologia visual</strong>
      </a>

      <a
        href="https://mic.miraheze.org/wiki/Main_Page"
        target="_blank"
        class="link-card destaque-link"
      >
        <span>wiki</span>
        <strong>principal espaço de curadoria e expansão enciclopédica</strong>
      </a>

    </div>

  </section>

  <!-- FUTURO -->
  <section class="futuro">

    <div class="futuro-box">

      <h2>VISÃO DE LONGO PRAZO</h2>

      <p>
        O MIC busca evoluir como:
      </p>

      <ul>
        <li>enciclopédia visual científica internacional</li>
        <li>infraestrutura de preservação audiovisual</li>
        <li>museu digital expandido</li>
        <li>plataforma educacional global</li>
        <li>arquivo arqueológico imagético</li>
        <li>rede de memoriais comunitários</li>
        <li>ecossistema vetorialético de cultura científica</li>
      </ul>

      <div class="acoes">

        <a href="/pesquisa-vetorialetica">
          portal vetorialética
        </a>

        <a href="/editoria">
          editoriá
        </a>

        <a href="/ia-vetorialetica">
          ia vetorialética
        </a>

      </div>

    </div>

  </section>

    <!-- RODAPÉ RESSONANTE -->
  <footer class="rodape">

    <a href="javascript:history.back()" class="voltar">
      ← voltar
    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV
      </span>

      <p>
        engenharia cultural • audiovisual • vetorialética • arqueologia visual
      </p>

    </div>

  </footer>


</main>

</BaseLayout>

<style>

/* BASE */

.mic{
  position:relative;
  min-height:100vh;
  overflow:hidden;
  background:#000;
  color:white;
}

/* PLAYER */

.player-radio{
  position:fixed;
  top:90px;
  left:20px;

  width:260px;
  height:146px;

  z-index:60;

  overflow:hidden;

  border-radius:16px;

  border:1px solid rgba(255,255,255,0.08);

  background:rgba(0,0,0,0.7);

  backdrop-filter:blur(10px);

  box-shadow:
    0 0 30px rgba(0,0,0,0.5);
}

.player-radio iframe{
  width:100%;
  height:100%;
}

/* BG */

.bg-video{
  position:fixed;
  inset:0;
  z-index:-3;
  overflow:hidden;
}

.bg-video iframe{
  width:100vw;
  height:100vh;

  object-fit:cover;

  opacity:0.22;

  pointer-events:none;
}

/* OVERLAY */

.overlay{
  position:fixed;
  inset:0;
  z-index:-2;

  background:
    radial-gradient(circle at center,
    rgba(70,120,140,0.15),
    rgba(0,0,0,0.94));
}

/* HERO */

.hero{
  min-height:100vh;

  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;

  text-align:center;

  padding:2rem;
}

.assinatura{
  color:#7db5c7;

  letter-spacing:4px;
  text-transform:uppercase;

  font-size:0.7rem;

  margin-bottom:1rem;
}

.hero h1{
  font-size:clamp(4rem,10vw,8rem);

  letter-spacing:14px;

  color:#d7edf5;

  margin:0;

  text-shadow:
    0 0 30px rgba(120,200,255,0.15);
}

.linha{
  width:180px;
  height:1px;

  margin:2rem 0;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(160,220,255,0.8),
      transparent
    );
}

.manifesto{
  max-width:900px;

  color:#b9d4de;

  line-height:1.9;
  letter-spacing:2px;

  font-size:0.95rem;
}

/* INTRO */

.intro{
  display:grid;
  grid-template-columns:1.4fr 0.6fr;

  gap:2rem;

  padding:6rem 8%;
}

.texto{
  padding:2rem;

  border-radius:24px;

  background:rgba(5,10,15,0.75);

  border:1px solid rgba(255,255,255,0.06);

  backdrop-filter:blur(12px);
}

.texto h2{
  color:#d7edf5;
  margin-bottom:1.5rem;
  letter-spacing:3px;
}

.texto p{
  color:#b5cdd6;
  line-height:1.9;
  margin-bottom:1.2rem;
}

/* PAINEL */

.painel{
  display:flex;
  flex-direction:column;
  gap:1.5rem;
}

.janela{
  padding:1.6rem;

  border-radius:18px;

  background:rgba(10,15,20,0.75);

  border:1px solid rgba(120,200,255,0.1);

  backdrop-filter:blur(10px);
}

.janela span{
  display:block;

  margin-bottom:0.8rem;

  color:#7db5c7;

  text-transform:uppercase;

  letter-spacing:2px;

  font-size:0.7rem;
}

.janela strong{
  color:#dceff5;
  line-height:1.6;
}

/* TITULO */

.titulo-area{
  text-align:center;
  margin-bottom:3rem;
}

.titulo-area h2{
  color:#d7edf5;
  letter-spacing:5px;
  font-size:2rem;
}

.titulo-area p{
  color:#7da0ab;
}

/* GRID */

.estrutura{
  padding:2rem 8% 8rem;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:2rem;
}

.card{
  padding:2rem;

  border-radius:20px;

  background:
    linear-gradient(
      145deg,
      rgba(10,20,30,0.75),
      rgba(5,5,10,0.92)
    );

  border:1px solid rgba(255,255,255,0.06);

  transition:0.4s;
}

.card:hover{
  transform:translateY(-8px);

  border-color:#8fd9f0;

  box-shadow:
    0 0 40px rgba(100,180,255,0.12);
}

.card h3{
  color:#d7edf5;
  margin-bottom:1rem;
  letter-spacing:2px;
}

.card p{
  color:#acc8d0;
  line-height:1.7;
}

.destaque{
  border-color:rgba(120,220,255,0.25);
}

/* VETOR */

.vetorialetica{
  padding:0 8% 8rem;
}

.bloco-vetor{
  padding:4rem;

  border-radius:28px;

  background:
    radial-gradient(circle at top,
    rgba(60,120,160,0.18),
    rgba(0,0,0,0.92));

  border:1px solid rgba(160,220,255,0.12);

  text-align:center;
}

.bloco-vetor h2{
  color:#d7edf5;
  margin-bottom:2rem;
  letter-spacing:5px;
}

.bloco-vetor p{
  max-width:900px;

  margin:0 auto 1.5rem;

  color:#bdd6de;

  line-height:1.9;
}

.frase{
  color:#9fe7ff !important;

  font-size:1.2rem;

  letter-spacing:3px;
}

/* REDE */

.rede{
  padding:0 8% 8rem;
}

.links-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:2rem;
}

.link-card{
  text-decoration:none;

  padding:2rem;

  border-radius:22px;

  background:rgba(8,12,18,0.82);

  border:1px solid rgba(255,255,255,0.06);

  transition:0.4s;
}

.link-card:hover{
  transform:translateY(-8px);

  border-color:#9fe7ff;
}

.link-card span{
  display:block;

  margin-bottom:1rem;

  text-transform:uppercase;

  letter-spacing:3px;

  color:#7db5c7;

  font-size:0.7rem;
}

.link-card strong{
  color:#e5f6fb;
  line-height:1.6;
}

.destaque-link{
  border-color:rgba(159,231,255,0.25);
}

/* FUTURO */

.futuro{
  padding:0 8% 8rem;
}

.futuro-box{
  padding:4rem;

  border-radius:30px;

  background:
    linear-gradient(
      145deg,
      rgba(8,20,30,0.92),
      rgba(0,0,0,0.95)
    );

  border:1px solid rgba(120,220,255,0.12);

  text-align:center;
}

.futuro-box h2{
  color:#d7edf5;
  margin-bottom:2rem;
  letter-spacing:5px;
}

.futuro-box p{
  color:#a8c4cf;
  margin-bottom:2rem;
}

.futuro-box ul{
  list-style:none;
  padding:0;

  max-width:700px;
  margin:0 auto 3rem;
}

.futuro-box li{
  padding:0.8rem 0;

  color:#c8e4ed;

  border-bottom:1px solid rgba(255,255,255,0.05);
}

/* LINKS */

.acoes{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:1rem;
}

.acoes a{
  text-decoration:none;

  padding:0.9rem 1.4rem;

  border-radius:999px;

  border:1px solid rgba(160,220,255,0.15);

  color:#9fe7ff;

  transition:0.3s;
}

.acoes a:hover{
  background:#9fe7ff;
  color:black;
}

/* MOBILE */

@media(max-width:900px){

  .intro{
    grid-template-columns:1fr;
  }

  .player-radio{
    width:180px;
    height:100px;
  }

}

@media(max-width:600px){

  .hero h1{
    letter-spacing:5px;
  }

  .manifesto{
    font-size:0.85rem;
  }

  .player-radio{
    width:150px;
    height:84px;

    top:80px;
    left:10px;
  }

  .bloco-vetor,
  .futuro-box{
    padding:2rem;
  }

}
/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:6rem;
  padding-top:3rem;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

/* BOTÃO VOLTAR */

.voltar{
  text-decoration:none;

  color:#c9a96a;

  border:
    1px solid rgba(214,185,107,0.18);

  padding:0.9rem 1.6rem;

  border-radius:999px;

  letter-spacing:2px;
  font-size:0.75rem;

  transition:0.35s;

  background:
    rgba(214,185,107,0.04);

  backdrop-filter:blur(8px);
}

.voltar:hover{
  background:#d6b96b;
  color:black;

  transform:translateY(-3px);
}

/* ASSINATURA */

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:#f5e6c8;

  letter-spacing:4px;

  font-size:0.75rem;

  margin-bottom:0.8rem;
}

.assinatura-final p{
  color:#7d7156;

  font-size:0.72rem;

  letter-spacing:1px;
}
/* BOTÃO VOLTAR FLUTUANTE */

.voltar-flutuante{
  position:fixed;

  top:92px;
  right:24px;

  z-index:120;

  text-decoration:none;

  color:#d6b96b;

  font-size:0.74rem;
  letter-spacing:2px;
  text-transform:uppercase;

  padding:0.85rem 1.3rem;

  border-radius:999px;

  background:
    rgba(0,0,0,0.55);

  border:
    1px solid rgba(214,185,107,0.22);

  backdrop-filter:blur(12px);

  box-shadow:
    0 0 25px rgba(214,185,107,0.08);

  transition:0.35s ease;
}

/* HOVER */

.voltar-flutuante:hover{

  background:#d6b96b;
  color:black;

  transform:
    translateY(-2px)
    scale(1.03);

  box-shadow:
    0 0 35px rgba(214,185,107,0.25);
}

/* MOBILE */

@media(max-width:700px){

  .voltar-flutuante{
    top:200px;
    right:14px;

    font-size:0.68rem;

    padding:0.7rem 1rem;
  }

}

@media(max-width:500px){

  .voltar-flutuante{

    position:relative;

    top:0;
    right:0;

    margin-bottom:2rem;

    align-self:center;
  }

}
</style>