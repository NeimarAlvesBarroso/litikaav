---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sobre — Lítika AV">

<main class="campo">



  <!-- PLAYER CINEMA -->
  <div class="player-cinema">
    <iframe
      src="https://www.youtube.com/embed/woPdy9O1z2A?autoplay=1&mute=1&controls=1&loop=1&playlist=woPdy9O1z2A"
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen>
    </iframe>
  </div>

  <!-- FUNDO -->
  <div class="bg"></div>

  <!-- NÚCLEO -->
  <section class="core">

    <span class="assinatura">
      companhia vetorial de ativos culturais
    </span>

    <h1>LÍTIKA AV</h1>

    <div class="linha"></div>

    <p class="sub">
      cinema • arqueologia • fotografia • ciência • inteligência cultural
    </p>

  </section>

  <!-- BIO -->
  <section class="bio">

    <div class="texto">

      <h2>
        UMA COMPANHIA DE ATIVOS CULTURAIS
      </h2>

      <p>
        A Lítika AV é a empresa do pesquisador, documentarista
        e articulador cultural Neimar Alves Barroso,
        desenvolvida a partir de mais de duas décadas de atuação
        nos campos do audiovisual, fotografia,
        arqueologia urbana e documentação cultural.
      </p>

      <p>
        A trajetória inicia-se na Universidade Federal de Minas Gerais,
        no contexto do projeto Santíssimo Agostim,
        expandindo-se posteriormente para documentários,
        mostras, festivais, curadorias e sistemas culturais experimentais.
      </p>

      <p>
        A Lítika opera em todas as etapas do audiovisual:
      </p>

      <div class="camadas">

        <span>pesquisa</span>
        <span>roteiro</span>
        <span>fotografia</span>
        <span>documentário</span>
        <span>finalização</span>
        <span>curadoria</span>
        <span>memória</span>
        <span>plataformas digitais</span>

      </div>

    </div>

    <div class="painel">

      <div class="janela">
        <span>trajetória</span>
        <strong>
          +20 anos em audiovisual,
          arqueologia e documentação cultural
        </strong>
      </div>

      <div class="janela">
        <span>campo</span>
        <strong>
          cinema autoral · festivais · mostras · museologia
        </strong>
      </div>

      <div class="janela">
        <span>estrutura</span>
        <strong>
          criação de ativos científicos,
          culturais e tecnológicos
        </strong>
      </div>

    </div>

  </section>

  <!-- ESTRUTURA -->
  <section class="estrutura">

    <div class="titulo">
      <h2>ESTRUTURA RESSONANTE</h2>

      <p>
        não é uma produtora convencional.
        é um ecossistema de organização cultural.
      </p>
    </div>

    <div class="campo-grid">

      <!-- VETORIALETICA -->
      <a href="/pesquisa-vetorialetica" class="bloco destaque">

        <h2>VETORIALÉTICA</h2>

        <p>
          teoria estrutural contínua voltada
          à reorganização científica,
          tecnológica e imagética do real.
        </p>

      </a>

      <!-- EDITORIA -->
      <a href="/editoria" class="bloco forte">

        <h2>EDITORIÁ</h2>

        <p>
          plataforma editorial mediada por IA vetorialética
          para publicação científica e expansão internacional.
        </p>

      </a>

      <!-- MIC -->
      <a href="/mic" class="bloco forte">

        <h2>MIC</h2>

        <p>
          museologia crítica,
          arqueologia visual
          e ilustração científica.
        </p>

      </a>

      <!-- MISSA -->
      <a href="/missa" class="bloco forte">

        <h2>MISSA</h2>

        <p>
          ecossistema audiovisual para implantação
          de museus da imagem e do som
          em cidades do interior.
        </p>

      </a>

    </div>

  </section>

  <!-- FLUXO -->
  <section class="fluxo">

    <p class="destaque">
      conhecimento convertido em ativo.
    </p>

    <p>
      A Lítika desenvolve estruturas audiovisuais,
      sistemas curatoriais, plataformas educacionais,
      teorias científicas e arquiteturas simbólicas
      voltadas ao futuro da cultura e da inteligência.
    </p>

    <p>
      Seu modelo de atuação integra:
    </p>

    <div class="vetores">

      <span>arqueologia</span>
      <span>ciência</span>
      <span>imagem</span>
      <span>território</span>
      <span>memória</span>
      <span>IA</span>
      <span>cinema</span>
      <span>museologia</span>
      <span>engenharia cultural</span>

    </div>

  </section>

  <!-- VISÃO -->
  <section class="visao">

    <div class="manifesto-box">

      <h2>
        CINEMA COMO INFRAESTRUTURA
      </h2>

      <p>
        A Lítika entende o audiovisual não apenas
        como linguagem artística,
        mas como tecnologia de organização social,
        memória coletiva e engenharia simbólica.
      </p>

      <p>
        Filmes, museus, livros, plataformas
        e sistemas digitais tornam-se ativos estruturantes
        capazes de reorganizar territórios,
        economias criativas e campos científicos.
      </p>

    </div>

  </section>

    <!-- RODAPÉ RESSONANTE -->
  <footer class="rodape">

    <a href="javascript:history.back()" class="voltar">
      ← voltar
    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV
      </span>

      <p>
        engenharia cultural • audiovisual • vetorialética • arqueologia visual
      </p>

    </div>

  </footer>

</main>

</main>

</BaseLayout>

<style>

/* BASE */

.campo{
  position:relative;
  min-height:100vh;

  overflow:hidden;

  padding:4rem 1.5rem 8rem;

  background:black;

  display:flex;
  flex-direction:column;
  align-items:center;
}

/* BOTÃO VOLTAR */

.voltar{
  position:fixed;
  top:92px;
  right:24px;

  z-index:60;

  text-decoration:none;

  color:#d6b96b;

  font-size:0.75rem;
  letter-spacing:2px;
  text-transform:uppercase;

  padding:0.8rem 1.2rem;

  border-radius:999px;

  background:rgba(0,0,0,0.55);

  border:1px solid rgba(214,185,107,0.22);

  backdrop-filter:blur(12px);

  transition:0.35s;
}

.voltar:hover{
  background:#d6b96b;
  color:black;

  transform:translateY(-2px);
}

/* BG */

.bg{
  position:fixed;
  inset:0;

  z-index:-3;

  background:
    radial-gradient(circle at top,
    rgba(70,45,12,0.45),
    rgba(0,0,0,0.96)),
    linear-gradient(180deg,#050505,#000);
}

/* PLAYER */

.player-cinema{
  position:fixed;
  top:90px;
  left:20px;

  width:260px;
  height:150px;

  z-index:50;

  overflow:hidden;

  border-radius:12px;

  border:1px solid rgba(255,255,255,0.08);

  background:rgba(0,0,0,0.65);

  backdrop-filter:blur(10px);

  transition:0.4s;
}

.player-cinema:hover{
  transform:scale(1.02);
  opacity:1;
}

.player-cinema iframe{
  width:100%;
  height:100%;
  border:none;
}

/* CORE */

.core{
  min-height:70vh;

  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;

  text-align:center;

  max-width:1000px;
}

.assinatura{
  color:#c9a96a;

  font-size:0.7rem;

  letter-spacing:4px;

  text-transform:uppercase;

  margin-bottom:1rem;
}

.core h1{
  font-size:clamp(3rem,8vw,6rem);

  letter-spacing:10px;

  color:#f5e6c8;

  margin:0;

  text-shadow:
    0 0 30px rgba(214,185,107,0.18);
}

.linha{
  width:180px;
  height:1px;

  margin:2rem 0;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(214,185,107,0.9),
      transparent
    );
}

.sub{
  color:#8a7d5a;

  letter-spacing:2px;

  max-width:700px;

  line-height:1.8;
}

/* BIO */

.bio{
  width:100%;
  max-width:1200px;

  display:grid;
  grid-template-columns:1.2fr 0.8fr;

  gap:2rem;

  margin-top:2rem;
}

.texto,
.janela,
.bloco,
.manifesto-box{
  background:
    linear-gradient(
      145deg,
      rgba(25,18,10,0.75),
      rgba(5,5,5,0.9)
    );

  border:1px solid rgba(255,255,255,0.05);

  backdrop-filter:blur(10px);

  border-radius:20px;
}

.texto{
  padding:2rem;
}

.texto h2{
  color:#f5e6c8;

  margin-bottom:1.5rem;

  letter-spacing:2px;
}

.texto p{
  color:#b7ab90;

  line-height:1.9;

  margin-bottom:1.3rem;
}

/* CAMADAS */

.camadas{
  display:flex;
  flex-wrap:wrap;
  gap:0.8rem;

  margin-top:2rem;
}

.camadas span{
  padding:0.7rem 1rem;

  border-radius:999px;

  background:rgba(214,185,107,0.08);

  border:1px solid rgba(214,185,107,0.15);

  color:#e4c88b;

  font-size:0.75rem;

  letter-spacing:1px;
}

/* PAINEL */

.painel{
  display:flex;
  flex-direction:column;
  gap:1.5rem;
}

.janela{
  padding:1.7rem;
}

.janela span{
  display:block;

  margin-bottom:0.7rem;

  color:#8f7a53;

  text-transform:uppercase;

  font-size:0.7rem;

  letter-spacing:2px;
}

.janela strong{
  color:#f5e6c8;

  line-height:1.7;
}

/* ESTRUTURA */

.estrutura{
  width:100%;
  max-width:1200px;

  margin-top:7rem;
}

.titulo{
  text-align:center;

  margin-bottom:3rem;
}

.titulo h2{
  color:#f5e6c8;

  letter-spacing:5px;

  margin-bottom:1rem;
}

.titulo p{
  color:#8a7d5a;
}

/* GRID */

.campo-grid{
  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(240px,1fr));

  gap:1.5rem;
}

/* BLOCOS */

.bloco{
  position:relative;

  padding:2rem;

  overflow:hidden;

  text-decoration:none;

  transition:0.4s;
}

.bloco::before{
  content:"";

  position:absolute;
  inset:0;

  background:
    radial-gradient(circle at top left,
    rgba(255,255,255,0.05),
    transparent);

  opacity:0;

  transition:0.4s;
}

.bloco:hover::before{
  opacity:1;
}

.bloco:hover{
  transform:translateY(-8px);

  border-color:#d6b96b;
}

.bloco h2{
  color:#f5e6c8;

  margin-bottom:1rem;

  letter-spacing:2px;
}

.bloco p{
  color:#b7ab90;

  line-height:1.7;
}

.destaque{
  grid-column:span 2;

  border-color:#d6b96b;
}

/* FLUXO */

.fluxo{
  max-width:900px;

  margin-top:6rem;

  text-align:center;
}

.fluxo p{
  color:#9e9071;

  line-height:1.9;

  margin-bottom:1.5rem;
}

.fluxo .destaque{
  color:#f5e6c8;

  font-size:1.3rem;

  background:none;

  border:none;
}

/* VETORES */

.vetores{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;

  gap:1rem;

  margin-top:2rem;
}

.vetores span{
  padding:0.8rem 1.2rem;

  border-radius:999px;

  border:1px solid rgba(214,185,107,0.12);

  background:rgba(214,185,107,0.06);

  color:#d8c194;

  font-size:0.75rem;

  letter-spacing:1px;
}

/* VISÃO */

.visao{
  width:100%;
  max-width:1000px;

  margin-top:6rem;
}

.manifesto-box{
  padding:3rem;

  text-align:center;
}

.manifesto-box h2{
  color:#f5e6c8;

  letter-spacing:4px;

  margin-bottom:2rem;
}

.manifesto-box p{
  color:#b7ab90;

  line-height:1.9;

  max-width:800px;

  margin:0 auto 1.5rem;
}

/* RESPONSIVO */

@media(max-width:900px){

  .bio{
    grid-template-columns:1fr;
  }

  .destaque{
    grid-column:span 1;
  }

}

@media(max-width:700px){

  .player-cinema{
    width:180px;
    height:100px;
  }

  .voltar{
    top:200px;
    right:14px;
  }

}

@media(max-width:500px){

  .core h1{
    letter-spacing:4px;
  }

  .player-cinema{
    position:relative;

    top:0;
    left:0;

    margin-bottom:2rem;
  }

  .voltar{
    position:relative;

    top:0;
    right:0;

    margin-bottom:2rem;
  }

}

/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:6rem;
  padding-top:3rem;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

/* BOTÃO VOLTAR */

.voltar{
  text-decoration:none;

  color:#c9a96a;

  border:
    1px solid rgba(214,185,107,0.18);

  padding:0.9rem 1.6rem;

  border-radius:999px;

  letter-spacing:2px;
  font-size:0.75rem;

  transition:0.35s;

  background:
    rgba(214,185,107,0.04);

  backdrop-filter:blur(8px);
}

.voltar:hover{
  background:#d6b96b;
  color:black;

  transform:translateY(-3px);
}

/* ASSINATURA */

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:#f5e6c8;

  letter-spacing:4px;

  font-size:0.75rem;

  margin-bottom:0.8rem;
}

.assinatura-final p{
  color:#7d7156;

  font-size:0.72rem;

  letter-spacing:1px;
}

</style>