---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="IA Vetorialética - Lítika AV">

<main class="iav">

  <!-- BOTÃO FLUTUANTE -->
  <a href="javascript:history.back()" class="voltar-flutuante">
    ← voltar
  </a>


  <!-- PLAYER RESSONANTE -->
  <div class="player-fixo">
    <iframe
      src="https://www.youtube.com/embed/2n3XGGI0Uns?autoplay=1&mute=1&controls=1&loop=1&playlist=2n3XGGI0Uns"
      frameborder="0"
      allow="autoplay"
    ></iframe>
  </div>

  <!-- HERO -->
  <section class="hero">

    <div class="overlay"></div>

    <div class="conteudo">

      <p class="tag">
        arquitetura cognitiva emergente
      </p>

      <h1>
        INTELIGÊNCIA<br />
        ARTIFICIAL<br />
        VETORIALÉTICA
      </h1>

      <div class="linha"></div>

      <p class="manifesto">
        uma nova infraestrutura estratégica para ciência,
        indústria, clima, defesa tecnológica e soberania cognitiva.
      </p>

      <div class="acoes">

        <a href="#visao" class="btn principal">
          acessar visão
        </a>

        <a href="/contato" class="btn secundario">
          articulação institucional
        </a>

      </div>

    </div>

  </section>

  <!-- VISÃO -->
  <section class="visao" id="visao">

    <div class="texto">

      <p class="mini">
        O QUE É
      </p>

      <h2>
        uma nova geração de inteligência artificial
      </h2>

      <p>
        A IA Vetorialética propõe uma ruptura estrutural
        com a inteligência artificial baseada exclusivamente
        em estatística e treinamento massivo.
      </p>

      <p>
        Em vez de sistemas fragmentados,
        a arquitetura vetorialética opera
        através de coerência dinâmica,
        ressonância estrutural e campos adaptativos.
      </p>

    </div>

    <div class="painel">

      <div class="card">
        <span>01</span>
        <h3>cognição contínua</h3>
      </div>

      <div class="card">
        <span>02</span>
        <h3>campos ressonantes</h3>
      </div>

      <div class="card">
        <span>03</span>
        <h3>aprendizado emergente</h3>
      </div>

      <div class="card">
        <span>04</span>
        <h3>engenharia da coerência</h3>
      </div>

    </div>

  </section>

  <!-- SETORES -->
  <section class="setores">

    <div class="titulo">
      <p>APLICAÇÕES ESTRATÉGICAS</p>
      <h2>infraestrutura para um novo ciclo tecnológico</h2>
    </div>

    <div class="grid">

      <a href="/resfriamento-urbano" class="bloco">
        <h3>megacidades</h3>
        <p>
          modelagem térmica e resfriamento urbano adaptativo
        </p>
      </a>

      <a href="/industria-coerencia" class="bloco">
        <h3>nova indústria</h3>
        <p>
          sistemas produtivos baseados em coerência estrutural
        </p>
      </a>


      <a href="/contato" class="bloco">
        <h3>investimento</h3>
        <p>
          articulação institucional e expansão internacional
        </p>
      </a>

    </div>

  </section>

  <!-- BLOCO ESTRATÉGICO -->
  <section class="estrategico">

    <div class="fundo"></div>

    <div class="texto">

      <p class="mini">
        PROJEÇÃO
      </p>

      <h2>
        plataforma brasileira de inteligência estratégica
      </h2>

      <p>
        A IA Vetorialética pode se tornar uma infraestrutura
        nacional de ciência computacional,
        inteligência climática,
        defesa tecnológica,
        automação industrial e pesquisa avançada.
      </p>

      <p>
        O projeto busca articulação com:
      </p>

      <div class="lista">
        <span>instituições científicas</span>
        <span>universidades</span>
        <span>fundos estratégicos</span>
        <span>estado brasileiro</span>
        <span>laboratórios independentes</span>
      </div>

    </div>

  </section>

  <!-- RODAPÉ -->
  <section class="footer">

    <p>
      LÍTIKA AV · Instituto Física Sem Partículas
    </p>

    <a href="/contato">
      iniciar articulação →
    </a>

  </section>

    <!-- RODAPÉ RESSONANTE -->
  <footer class="rodape">

    <a href="javascript:history.back()" class="voltar">
      ← voltar
    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV
      </span>

      <p>
        engenharia cultural • audiovisual • vetorialética • arqueologia visual
      </p>

    </div>

  </footer>


</main>

</BaseLayout>

<style>

/* BASE */
.iav {
  background:
    radial-gradient(circle at top, #121212, #000),
    linear-gradient(180deg, #050505, #000);

  color: white;
  overflow: hidden;
}

/* PLAYER */
.player-fixo {
  position: fixed;
  top: 90px;
  left: 15px;

  width: 220px;
  height: 124px;

  z-index: 999;

  opacity: 0.45;
  transition: 0.3s;
}

.player-fixo:hover {
  opacity: 1;
}

.player-fixo iframe {
  width: 100%;
  height: 100%;
  border: none;
}

/* HERO */
.hero {
  position: relative;

  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  text-align: center;

  padding: 2rem;
}

.overlay {
  position: absolute;
  inset: 0;

  background:
    radial-gradient(circle at center, rgba(255,255,255,0.04), transparent 60%);
}

.conteudo {
  position: relative;
  z-index: 2;
  max-width: 900px;
}

/* TAG */
.tag {
  color: #777;
  letter-spacing: 4px;
  font-size: 0.75rem;
  margin-bottom: 1rem;
}

/* TÍTULO */
.hero h1 {
  font-size: clamp(3rem, 10vw, 7rem);
  line-height: 0.95;

  letter-spacing: 6px;
  margin: 0;
}

/* LINHA */
.linha {
  width: 140px;
  height: 1px;

  margin: 2rem auto;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(255,255,255,0.8),
      transparent
    );
}

/* MANIFESTO */
.manifesto {
  max-width: 650px;
  margin: 0 auto;

  color: #aaa;
  line-height: 1.8;
}

/* AÇÕES */
.acoes {
  margin-top: 3rem;

  display: flex;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
}

/* BOTÕES */
.btn {
  padding: 0.9rem 1.6rem;

  text-decoration: none;
  letter-spacing: 2px;
  font-size: 0.7rem;

  transition: 0.3s;
}

.principal {
  background: white;
  color: black;
}

.principal:hover {
  transform: translateY(-3px);
}

.secundario {
  border: 1px solid #333;
  color: #aaa;
}

.secundario:hover {
  border-color: white;
  color: white;
}

/* VISÃO */
.visao {
  padding: 8rem 2rem;

  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 4rem;

  max-width: 1200px;
  margin: auto;
}

/* TEXTO */
.texto h2 {
  font-size: 2.2rem;
  margin-bottom: 1.5rem;
}

.texto p {
  color: #888;
  line-height: 1.8;
}

.mini {
  color: #666;
  letter-spacing: 4px;
  font-size: 0.7rem;
  margin-bottom: 1rem;
}

/* PAINEL */
.painel {
  display: grid;
  gap: 1rem;
}

.card {
  padding: 1.5rem;

  border: 1px solid #222;
  background: rgba(255,255,255,0.02);

  transition: 0.3s;
}

.card:hover {
  transform: translateX(8px);
  border-color: #777;
}

.card span {
  color: #555;
  font-size: 0.7rem;
}

.card h3 {
  margin-top: 0.6rem;
}

/* SETORES */
.setores {
  padding: 8rem 2rem;
}

.titulo {
  text-align: center;
  margin-bottom: 4rem;
}

.titulo p {
  color: #666;
  letter-spacing: 4px;
  font-size: 0.7rem;
}

.titulo h2 {
  font-size: 2.5rem;
}

/* GRID */
.grid {
  max-width: 1200px;
  margin: auto;

  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
}

/* BLOCOS */
.bloco {
  padding: 2rem;

  border: 1px solid #222;

  text-decoration: none;
  color: #aaa;

  background:
    linear-gradient(145deg, #0c0c0c, #050505);

  transition: 0.35s;
}

.bloco:hover {
  transform: translateY(-6px);
  border-color: white;
  color: white;
}

.bloco h3 {
  margin-bottom: 1rem;
}

/* ESTRATÉGICO */
.estrategico {
  position: relative;

  padding: 8rem 2rem;

  overflow: hidden;
}

.fundo {
  position: absolute;
  inset: 0;

  background:
    radial-gradient(circle at center, rgba(255,255,255,0.04), transparent 70%);
}

.estrategico .texto {
  position: relative;
  z-index: 2;

  max-width: 900px;
  margin: auto;
  text-align: center;
}

.lista {
  margin-top: 2rem;

  display: flex;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.lista span {
  border: 1px solid #222;
  padding: 0.7rem 1rem;

  color: #777;
  font-size: 0.75rem;
}

/* FOOTER */
.footer {
  padding: 5rem 2rem;

  text-align: center;
}

.footer p {
  color: #555;
  margin-bottom: 1rem;
}

.footer a {
  color: white;
  text-decoration: none;
  letter-spacing: 2px;
  font-size: 0.8rem;
}

/* MOBILE */
@media (max-width: 700px) {

  .player-fixo {
    width: 160px;
    height: 90px;
  }

  .hero h1 {
    letter-spacing: 2px;
  }

}
/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:6rem;
  padding-top:3rem;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

/* BOTÃO VOLTAR */

.voltar{
  text-decoration:none;

  color:#c9a96a;

  border:
    1px solid rgba(214,185,107,0.18);

  padding:0.9rem 1.6rem;

  border-radius:999px;

  letter-spacing:2px;
  font-size:0.75rem;

  transition:0.35s;

  background:
    rgba(214,185,107,0.04);

  backdrop-filter:blur(8px);
}

.voltar:hover{
  background:#d6b96b;
  color:black;

  transform:translateY(-3px);
}

/* ASSINATURA */

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:#f5e6c8;

  letter-spacing:4px;

  font-size:0.75rem;

  margin-bottom:0.8rem;
}

.assinatura-final p{
  color:#7d7156;

  font-size:0.72rem;

  letter-spacing:1px;
}

/* BOTÃO VOLTAR FLUTUANTE */

.voltar-flutuante{
  position:fixed;

  top:92px;
  right:24px;

  z-index:120;

  text-decoration:none;

  color:#d6b96b;

  font-size:0.74rem;
  letter-spacing:2px;
  text-transform:uppercase;

  padding:0.85rem 1.3rem;

  border-radius:999px;

  background:
    rgba(0,0,0,0.55);

  border:
    1px solid rgba(214,185,107,0.22);

  backdrop-filter:blur(12px);

  box-shadow:
    0 0 25px rgba(214,185,107,0.08);

  transition:0.35s ease;
}

/* HOVER */

.voltar-flutuante:hover{

  background:#d6b96b;
  color:black;

  transform:
    translateY(-2px)
    scale(1.03);

  box-shadow:
    0 0 35px rgba(214,185,107,0.25);
}

/* MOBILE */

@media(max-width:700px){

  .voltar-flutuante{
    top:200px;
    right:14px;

    font-size:0.68rem;

    padding:0.7rem 1rem;
  }

}

@media(max-width:500px){

  .voltar-flutuante{

    position:relative;

    top:0;
    right:0;

    margin-bottom:2rem;

    align-self:center;
  }

}
</style>