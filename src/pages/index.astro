---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Lítika AV">

<main class="cinema">


  <!-- 🎧 PLAYER FIXO (SUPERIOR ESQUERDO) -->
  <div class="player-audio">
    <iframe
      src="https://www.youtube.com/embed/XW5safN9NTY?autoplay=1&controls=1&loop=1&playlist=XW5safN9NTY&modestbranding=1"
      frameborder="0"
      allow="autoplay; encrypted-media"
    ></iframe>
  </div>

  <!-- 🎬 FUNDO VÍDEO -->
  <div class="video-bg">
    <iframe
      src="https://www.youtube.com/embed/VCJXhXuQVUs?autoplay=1&mute=1&controls=0&loop=1&playlist=VCJXhXuQVUs&playsinline=1"
      frameborder="0"
      allow="autoplay; fullscreen"
    ></iframe>
  </div>

  <!-- OVERLAY -->
  <div class="overlay"></div>

  <!-- HERO -->
  <section class="hero">

    <h1>LÍTIKA AV</h1>

    <div class="links">
      <a href="/arqueologia">ARQUEOLOGIA</a>
      <a href="/cinema">CINEMA</a>
      <a href="/pesquisa-vetorialetica">CIÊNCIA VETORIALÉTICA</a>
    </div>

  </section>

  <!-- GRID -->
  <section class="grid">

    <iframe src="https://www.youtube.com/embed/efKWZiEfFkY?mute=1"></iframe>
    <iframe src="https://www.youtube.com/embed/k-Mgv2_VqSY?mute=1"></iframe>
    <iframe src="https://www.youtube.com/embed/VCJXhXuQVUs?mute=1"></iframe>

  </section>

    <!-- RODAPÉ RESSONANTE -->

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV LTDA.
      </span>

      <p>
        engenharia cultural • audiovisual • vetorialética • arqueologia visual
      </p>

    </div>

  </footer>

</main>

</main>

</BaseLayout>

<style>

/* BASE */
.cinema {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* 🎧 PLAYER FIXO */
.player-audio {
  position: fixed;
  top: 80px; /* abaixo do header */
  left: 20px;

  width: 220px;
  height: 124px;

  z-index: 1000;

  opacity: 0.7;
  transition: 0.3s;
}

.player-audio:hover {
  opacity: 1;
}

/* iframe do player */
.player-audio iframe {
  width: 100%;
  height: 100%;
  border: none;

  border-radius: 6px;
}

/* 🎬 VIDEO FUNDO */
.video-bg {
  position: fixed;
  inset: 0;
  z-index: -2;
}

.video-bg iframe {
  width: 100vw;
  height: 100vh;
  object-fit: cover;
  pointer-events: none;
}

/* OVERLAY */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  z-index: -1;
}

/* HERO */
.hero {
  height: 100vh;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  gap: 2rem;
  text-align: center;
}

/* TÍTULO */
.hero h1 {
  font-size: 4rem;
  letter-spacing: 6px;
}

/* LINKS */
.links {
  display: flex;
  gap: 2rem;
}

.links a {
  color: #ccc;
  text-decoration: none;
  font-size: 0.9rem;
  letter-spacing: 2px;
  border-bottom: 1px solid transparent;
  transition: 0.3s;
}

.links a:hover {
  color: white;
  border-color: white;
}

/* GRID */
.grid {
  padding: 4rem 2rem;

  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.5rem;
}

.grid iframe {
  width: 100%;
  height: 200px;
  border: none;

  filter: brightness(0.7);
  transition: 0.4s;
}

.grid iframe:hover {
  filter: brightness(1);
  transform: scale(1.03);
}

/* MOBILE */
@media (max-width: 600px) {

  .hero h1 {
    font-size: 2.2rem;
  }

  .links {
    flex-direction: column;
  }

  /* player menor no mobile */
  .player-audio {
    width: 160px;
    height: 90px;
    top: 70px;
    left: 10px;
  }

}
/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:6rem;
  padding-top:3rem;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

/* BOTÃO VOLTAR */

.voltar{
  text-decoration:none;

  color:#c9a96a;

  border:
    1px solid rgba(214,185,107,0.18);

  padding:0.9rem 1.6rem;

  border-radius:999px;

  letter-spacing:2px;
  font-size:0.75rem;

  transition:0.35s;

  background:
    rgba(214,185,107,0.04);

  backdrop-filter:blur(8px);
}

.voltar:hover{
  background:#d6b96b;
  color:black;

  transform:translateY(-3px);
}

/* ASSINATURA */

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:#f5e6c8;

  letter-spacing:4px;

  font-size:0.75rem;

  margin-bottom:0.8rem;
}

.assinatura-final p{
  color:#7d7156;

  font-size:0.72rem;

  letter-spacing:1px;
}
</style>