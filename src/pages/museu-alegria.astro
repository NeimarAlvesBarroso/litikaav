---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Museu da AlegrIA — MUSIA">

<main class="campo">

  <!-- FUNDO GALÁCTICO -->
  <div class="bg"></div>

  <!-- PLAYER MUSICAL -->
  <div class="player-musical">

    <iframe
      src="https://www.youtube.com/embed/EHlZEcy24q8?autoplay=1&mute=1&controls=1&loop=1&playlist=EHlZEcy24q8"
      title="Museu da Alegria"
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen>
    </iframe>

  </div>

  <!-- PARTÍCULAS -->
  <div class="particulas"></div>

  <!-- HERO -->
  <section class="hero">

    <span class="assinatura">
      rede vetorial de humor e inteligência cultural
    </span>

    <h1>MUSIA</h1>

    <div class="linha"></div>

    <p class="sub">
      museu da alegrIA • museu da piada • museu da gargalhada • museu da pegadinha
    </p>

  </section>

  <!-- MANIFESTO -->
  <section class="manifesto">

    <div class="manifesto-box">

      <h2>
        UM MUSEU PARA RIR DO FUTURO
      </h2>

      <p>
        O Museu da AlegrIA (MUSIA) nasce como um desdobramento
        do ecossistema MIC + MISSA,
        propondo uma nova infraestrutura cultural
        dedicada ao humor,
        às artes da gargalhada
        e à inteligência artificial criativa.
      </p>

      <p>
        O projeto entende o riso como tecnologia social,
        linguagem coletiva
        e mecanismo profundo de reorganização emocional.
      </p>

      <p>
        São Paulo,
        capital da televisão brasileira,
        das artes circenses,
        dos programas humorísticos
        e da cultura popular midiática,
        torna-se o território estratégico
        para implantação do primeiro núcleo MUSIA.
      </p>

    </div>

  </section>

  <!-- GRID -->
  <section class="grid-campo">

    <!-- MUSEU DA PIADA -->
    <a
      href="https://www.youtube.com/@museudapiada"
      target="_blank"
      class="card">

      <span class="tag">CANAL</span>

      <h3>MUSEU DA PIADA</h3>

      <p>
        Acervo contínuo das piadas mais engraçadas do mundo.
        Humor popular,
        oralidade,
        repetição,
        meme e memória coletiva.
      </p>

    </a>

    <!-- GARGALHADA -->
    <a
      href="https://www.youtube.com/@museudagargalhada6707"
      target="_blank"
      class="card">

      <span class="tag">CANAL</span>

      <h3>MUSEU DA GARGALHADA</h3>

      <p>
        Espaço dedicado às gargalhadas mais absurdas,
        escandalosas
        e delirantes da internet.
      </p>

    </a>

    <!-- PEGADINHA -->
    <a
      href="https://www.youtube.com/@museudapegadinha6556"
      target="_blank"
      class="card">

      <span class="tag">CANAL</span>

      <h3>MUSEU DA PEGADINHA</h3>

      <p>
        Humor espontâneo,
        performance urbana,
        improviso
        e experimentação social.
      </p>

    </a>

    <!-- IA -->
    <div class="card destaque">

      <span class="tag">VETORIALETICA</span>

      <h3>ALEGRIA + IA</h3>

      <p>
        O MUSIA pesquisa humor produzido
        por inteligência artificial,
        sistemas narrativos automáticos,
        personagens sintéticos
        e interação homem-máquina mediada pelo riso.
      </p>

    </div>

  </section>

  <!-- FLUXO -->
  <section class="fluxo">

    <p class="destaque">
      rir também é infraestrutura.
    </p>

    <p>
      O MUSIA propõe um novo ativo cultural:
      uma rede internacional dedicada ao humor,
      televisão,
      memes,
      pegadinhas,
      inteligência artificial,
      memória popular
      e economia criativa da alegria.
    </p>

    <div class="vetores">

      <span>humor</span>
      <span>tv</span>
      <span>circo</span>
      <span>IA</span>
      <span>memes</span>
      <span>cultura popular</span>
      <span>arte urbana</span>
      <span>streaming</span>
      <span>internet</span>

    </div>

  </section>

  <!-- INVESTIMENTO -->
  <section class="investimento">

    <div class="invest-box">

      <h2>
        ATIVO CULTURAL ESCALÁVEL
      </h2>

      <p>
        O Museu da AlegrIA é concebido como:
      </p>

      <ul>

        <li>plataforma multimídia de humor</li>

        <li>rede de canais audiovisuais</li>

        <li>museu digital colaborativo</li>

        <li>marca cultural internacional</li>

        <li>espaço para experiências imersivas</li>

        <li>hub criativo para IA humorística</li>

      </ul>

      <p>
        O projeto busca investidores,
        patrocinadores,
        parceiros institucionais
        e agentes culturais interessados
        em inovação criativa,
        entretenimento
        e inteligência emocional aplicada.
      </p>

    </div>

  </section>

  <!-- LINKS -->
  <section class="links">

    <a
      href="https://www.youtube.com/@museudaalegria6132"
      target="_blank">

      Museu da AlegrIA

    </a>

    <a
      href="https://www.youtube.com/@museudagargalhada6707"
      target="_blank">

      Museu da Gargalhada

    </a>

    <a
      href="https://www.youtube.com/@museudapegadinha6556"
      target="_blank">

      Museu da Pegadinha

    </a>

  </section>

  <!-- RODAPÉ -->
  <footer class="rodape">

    <a
      href="javascript:history.back()"
      class="voltar">

      ← voltar

    </a>

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV LTDA.
      </span>

      <p>
        inteligência cultural • humor • audiovisual • vetorialética
      </p>

    </div>

  </footer>

</main>

</BaseLayout>

<style>

/* BASE */

.campo{
  position:relative;

  min-height:100vh;

  overflow:hidden;

  padding:4rem 1.5rem 8rem;

  background:black;

  display:flex;
  flex-direction:column;
  align-items:center;
}

/* BG */

.bg{
  position:fixed;
  inset:0;

  z-index:-5;

  background:
    radial-gradient(circle at top,
    rgba(255,0,150,0.15),
    transparent 30%),

    radial-gradient(circle at bottom,
    rgba(0,180,255,0.12),
    transparent 35%),

    radial-gradient(circle at center,
    rgba(255,255,255,0.04),
    transparent 40%),

    linear-gradient(
      180deg,
      #050505,
      #000
    );
}

/* PLAYER */

.player-musical{
  position:fixed;

  top:90px;
  right:20px;

  width:300px;
  height:170px;

  z-index:50;

  overflow:hidden;

  border-radius:20px;

  background:
    rgba(0,0,0,0.5);

  border:
    1px solid rgba(255,255,255,0.08);

  backdrop-filter:blur(10px);

  box-shadow:
    0 0 40px rgba(255,255,255,0.06);

  transition:0.45s ease;
}

.player-musical:hover{
  transform:scale(1.03);
}

.player-musical iframe{
  width:100%;
  height:100%;
  border:none;
}

/* HERO */

.hero{
  min-height:70vh;

  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;

  text-align:center;

  max-width:1000px;
}

.assinatura{
  color:#ffb7df;

  font-size:0.72rem;

  letter-spacing:4px;

  text-transform:uppercase;

  margin-bottom:1rem;
}

.hero h1{
  font-size:clamp(4rem,10vw,8rem);

  letter-spacing:10px;

  margin:0;

  color:white;

  text-shadow:
    0 0 30px rgba(255,255,255,0.18),
    0 0 80px rgba(255,0,180,0.18);
}

.linha{
  width:220px;
  height:1px;

  margin:2rem 0;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(255,255,255,0.7),
      transparent
    );
}

.sub{
  max-width:700px;

  color:#b9b9b9;

  letter-spacing:2px;

  line-height:1.8;
}

/* BOXES */

.manifesto,
.investimento{
  width:100%;
  max-width:1100px;

  margin-top:4rem;
}

.manifesto-box,
.invest-box{
  padding:3rem;

  border-radius:28px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,0.04),
      rgba(255,255,255,0.01)
    );

  border:
    1px solid rgba(255,255,255,0.06);

  backdrop-filter:blur(10px);
}

.manifesto-box h2,
.invest-box h2{
  color:white;

  margin-bottom:2rem;

  letter-spacing:4px;
}

.manifesto-box p,
.invest-box p,
.invest-box li{
  color:#c9c9c9;

  line-height:1.9;
}

/* GRID */

.grid-campo{
  width:100%;
  max-width:1200px;

  margin-top:5rem;

  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(260px,1fr));

  gap:1.5rem;
}

.card{
  position:relative;

  overflow:hidden;

  padding:2rem;

  border-radius:24px;

  text-decoration:none;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,0.03),
      rgba(255,255,255,0.01)
    );

  border:
    1px solid rgba(255,255,255,0.06);

  transition:0.4s;
}

.card:hover{
  transform:
    translateY(-8px)
    scale(1.02);

  border-color:
    rgba(255,255,255,0.2);
}

.card::before{
  content:"";

  position:absolute;
  inset:0;

  background:
    radial-gradient(circle at top left,
    rgba(255,255,255,0.08),
    transparent);

  opacity:0;

  transition:0.4s;
}

.card:hover::before{
  opacity:1;
}

.card h3{
  color:white;

  margin:1rem 0;
}

.card p{
  color:#bcbcbc;

  line-height:1.8;
}

.tag{
  display:inline-block;

  padding:0.45rem 0.8rem;

  border-radius:999px;

  background:
    rgba(255,255,255,0.06);

  color:#ffb7df;

  font-size:0.7rem;

  letter-spacing:1px;
}

.destaque{
  border-color:
    rgba(255,0,180,0.22);
}

/* FLUXO */

.fluxo{
  max-width:900px;

  margin-top:6rem;

  text-align:center;
}

.fluxo p{
  color:#c4c4c4;

  line-height:1.9;

  margin-bottom:1.5rem;
}

.fluxo .destaque{
  font-size:1.4rem;

  color:white;

  background:none;
}

/* VETORES */

.vetores{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;

  gap:1rem;

  margin-top:2rem;
}

.vetores span{
  padding:0.8rem 1.2rem;

  border-radius:999px;

  background:
    rgba(255,255,255,0.05);

  border:
    1px solid rgba(255,255,255,0.08);

  color:#f2f2f2;

  font-size:0.75rem;

  letter-spacing:1px;
}

/* LINKS */

.links{
  margin-top:5rem;

  display:flex;
  gap:1.5rem;
  flex-wrap:wrap;

  justify-content:center;
}

.links a{
  text-decoration:none;

  padding:1rem 1.6rem;

  border-radius:999px;

  background:
    rgba(255,255,255,0.04);

  border:
    1px solid rgba(255,255,255,0.08);

  color:white;

  transition:0.35s;
}

.links a:hover{
  transform:translateY(-4px);

  background:
    rgba(255,255,255,0.1);
}

/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:7rem;
  padding-top:3rem;

  display:flex;
  flex-direction:column;
  align-items:center;

  gap:2rem;

  border-top:
    1px solid rgba(255,255,255,0.06);
}

.voltar{
  text-decoration:none;

  padding:0.9rem 1.5rem;

  border-radius:999px;

  background:
    rgba(255,255,255,0.04);

  border:
    1px solid rgba(255,255,255,0.08);

  color:white;

  letter-spacing:2px;

  transition:0.35s;
}

.voltar:hover{
  transform:translateY(-3px);

  background:white;
  color:black;
}

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:white;

  letter-spacing:4px;

  font-size:0.75rem;

  margin-bottom:0.7rem;
}

.assinatura-final p{
  color:#8f8f8f;

  font-size:0.72rem;

  letter-spacing:1px;
}

/* RESPONSIVO */

@media(max-width:700px){

  .player-musical{
    width:220px;
    height:124px;
  }

}

@media(max-width:500px){

  .player-musical{
    position:relative;

    top:0;
    right:0;

    margin-bottom:2rem;
  }

  .hero h1{
    letter-spacing:4px;
  }

}

</style>