---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Museu da Boemia BH — Lítika AV">

<main class="campo">

  <!-- BOTÃO FLUTUANTE -->
  <a href="javascript:history.back()" class="voltar-flutuante">
    ← voltar
  </a>

  <!-- PLAYER -->
  <div class="player-cinema">

    <iframe
      src="https://www.youtube.com/embed/IYdOeI-W4CQ?autoplay=1&mute=1&controls=1&loop=1&playlist=IYdOeI-W4CQ"
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen>
    </iframe>

  </div>

  <!-- FUNDO -->
  <div class="bg"></div>

  <!-- HERO -->
  <section class="hero">

    <span class="assinatura">
      rede missa • patrimônio afetivo • economia noturna
    </span>

    <h1>
      MUSEU DA BOEMIA
    </h1>

    <div class="linha"></div>

    <p class="sub">
      memória urbana • bares • música • gastronomia • cultura popular • soberania alimentar
    </p>

  </section>

  <!-- INTRO -->
  <section class="intro">

    <div class="texto">

      <h2>
        CAPITAL MUNDIAL DOS BARES E DA BOEMIA
      </h2>

      <p>
        O Museu da Boemia BH nasce como um desdobramento
        do documentário Carta 7 e da arquitetura cultural
        da rede MISSA, propondo uma reflexão profunda
        sobre a vida noturna como patrimônio histórico,
        econômico, gastronômico e afetivo.
      </p>

      <p>
        Belo Horizonte, reconhecida em legislação municipal
        como capital mundial dos bares e da boemia,
        possui um dos mais sofisticados ecossistemas
        de sociabilidade urbana do Brasil.
      </p>

      <p>
        O projeto organiza esta potência cultural
        como ativo estratégico de memória,
        turismo, inteligência territorial
        e economia criativa.
      </p>

    </div>

    <!-- PAINEL -->
    <div class="painel">

      <div class="janela">

        <span>estrutura</span>

        <strong>
          museu audiovisual colaborativo
          em expansão permanente
        </strong>

      </div>

      <div class="janela">

        <span>estado</span>

        <strong>
          ativo cultural em desenvolvimento,
          documentação histórica consolidada
        </strong>

      </div>

      <div class="janela">

        <span>projeção</span>

        <strong>
          futura sede física integrada
          a gastronomia, música e memória urbana
        </strong>

      </div>

    </div>

  </section>

  <!-- BOEMIA 100 -->
  <section class="bloco-principal">

    <div class="titulo">

      <h2>
        CIRCUITO BOEMIA100
      </h2>

      <p>
        campanha cultural gastronômica permanente
      </p>

    </div>

    <div class="cards">

      <div class="card">

        <h3>
          100 ANOS DO BAR DO ORLANDO
        </h3>

        <p>
          O circuito nasce durante as comemorações
          do centenário do Bar do Orlando,
          símbolo histórico da boemia mineira
          no bairro Santa Tereza.
        </p>

      </div>

      <div class="card">

        <h3>
          DOCUMENTÁRIO EXPANSIVO
        </h3>

        <p>
          Um filme sem fim:
          Boemia100, Boemia101,
          Boemia102...
          cada novo bar,
          uma nova sequência,
          um novo capítulo da memória urbana.
        </p>

      </div>

      <div class="card">

        <h3>
          ECONOMIA CRIATIVA
        </h3>

        <p>
          O projeto integra audiovisual,
          turismo cultural,
          gastronomia,
          souvenires,
          publicidade,
          eventos musicais
          e circulação comercial.
        </p>

      </div>

    </div>

  </section>

  <!-- EIXOS -->
  <section class="eixos">

    <div class="titulo">

      <h2>
        ESTRUTURA DO ATIVO
      </h2>

    </div>

    <div class="grid-eixos">

      <div class="eixo">
        <span>memória urbana</span>
      </div>

      <div class="eixo">
        <span>museologia noturna</span>
      </div>

      <div class="eixo">
        <span>segurança alimentar</span>
      </div>

      <div class="eixo">
        <span>gastronomia cultural</span>
      </div>

      <div class="eixo">
        <span>documentário contínuo</span>
      </div>

      <div class="eixo">
        <span>curadoria boêmia</span>
      </div>

      <div class="eixo">
        <span>publicidade territorial</span>
      </div>

      <div class="eixo">
        <span>economia da noite</span>
      </div>

    </div>

  </section>

  <!-- JURÍDICO -->
  <section class="juridico">

    <div class="manifesto-box">

      <h2>
        UM ATIVO CULTURAL VIVO
      </h2>

      <p>
        O Museu da Boemia BH foi apresentado
        judicialmente como bem cultural imaterial
        passível de reconhecimento econômico,
        propondo uma reflexão inédita
        sobre patrimônio cultural,
        economia criativa
        e sistemas de compensação pública.
      </p>

      <p>
        O projeto converte documentação cultural,
        memória coletiva e inteligência territorial
        em estrutura estratégica de longo prazo.
      </p>

    </div>

  </section>

  <!-- LINKS -->
  <section class="links">

    <a
      href="https://www.facebook.com/museudaboemiabh"
      target="_blank">

      FACEBOOK

    </a>

    <a
      href="https://www.youtube.com/channel/UCjUpVjBgn14Rf6TbYUTkVaA"
      target="_blank">

      YOUTUBE


    </a>

  </section>

  <!-- GALERIA -->
  <section class="galeria">

    <div class="titulo">

      <h2>
        CAMPO VISUAL
      </h2>

    </div>

    <div class="grid-galeria">

      <img src="/imagens/boemia1.jpg" alt="Museu da Boemia" />
      <img src="/imagens/boemia2.jpg" alt="Museu da Boemia" />
      <img src="/imagens/boemia3.jpg" alt="Museu da Boemia" />
      <img src="/imagens/boemia4.jpg" alt="Museu da Boemia" />
      <img src="/imagens/boemia5.jpg" alt="Museu da Boemia" />
      <img src="/imagens/boemia6.jpg" alt="Museu da Boemia" />

    </div>

  </section>

  <!-- FLUXO -->
  <section class="fluxo">

    <p class="destaque">
      um museu da noite brasileira.
    </p>

    <p>
      O Museu da Boemia BH projeta
      Belo Horizonte como laboratório internacional
      de memória afetiva,
      cultura gastronômica,
      soberania alimentar,
      música,
      publicidade territorial
      e inteligência cultural urbana.
    </p>

  </section>

  <!-- RODAPÉ -->
  <footer class="rodape">

    <div class="assinatura-final">

      <span class="empresa">
        LÍTIKA AV
      </span>

      <p>
        engenharia cultural • audiovisual • vetorialética • arqueologia visual
      </p>

    </div>

  </footer>

</main>

</BaseLayout>

<style>

/* BASE */

.campo{
  position:relative;

  min-height:100vh;

  overflow:hidden;

  padding:4rem 1.5rem 8rem;

  background:black;

  display:flex;
  flex-direction:column;
  align-items:center;
}

/* BG */

.bg{
  position:fixed;
  inset:0;

  z-index:-5;

  background:
    radial-gradient(circle at top,
    rgba(120,70,20,0.28),
    rgba(0,0,0,0.95)),
    linear-gradient(180deg,#050505,#000);
}

/* PLAYER */

.player-cinema{
  position:fixed;

  top:90px;
  left:20px;

  width:270px;
  height:155px;

  z-index:50;

  overflow:hidden;

  border-radius:18px;

  border:
    1px solid rgba(255,255,255,0.08);

  background:
    rgba(0,0,0,0.65);

  backdrop-filter:blur(12px);

  box-shadow:
    0 0 40px rgba(214,185,107,0.08);

  transition:0.4s;
}

.player-cinema:hover{
  transform:scale(1.02);
}

.player-cinema iframe{
  width:100%;
  height:100%;
  border:none;
}

/* VOLTAR */

.voltar-flutuante{
  position:fixed;

  top:92px;
  right:24px;

  z-index:120;

  text-decoration:none;

  color:#d6b96b;

  font-size:0.74rem;

  letter-spacing:2px;
  text-transform:uppercase;

  padding:0.85rem 1.3rem;

  border-radius:999px;

  background:
    rgba(0,0,0,0.55);

  border:
    1px solid rgba(214,185,107,0.22);

  backdrop-filter:blur(12px);

  transition:0.35s;
}

.voltar-flutuante:hover{
  background:#d6b96b;
  color:black;

  transform:translateY(-2px);
}

/* HERO */

.hero{
  min-height:70vh;

  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;

  text-align:center;

  max-width:1000px;
}

.assinatura{
  color:#c9a96a;

  font-size:0.72rem;

  letter-spacing:4px;

  text-transform:uppercase;

  margin-bottom:1rem;
}

.hero h1{
  font-size:clamp(3rem,8vw,6rem);

  color:#f5e6c8;

  letter-spacing:8px;

  margin:0;

  text-shadow:
    0 0 35px rgba(214,185,107,0.16);
}

.linha{
  width:180px;
  height:1px;

  margin:2rem 0;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(214,185,107,0.95),
      transparent
    );
}

.sub{
  color:#9d8c65;

  letter-spacing:2px;

  line-height:1.8;
}

/* INTRO */

.intro{
  width:100%;
  max-width:1200px;

  display:grid;

  grid-template-columns:1.2fr 0.8fr;

  gap:2rem;
}

.texto,
.janela,
.card,
.manifesto-box{
  background:
    linear-gradient(
      145deg,
      rgba(30,20,10,0.72),
      rgba(5,5,5,0.92)
    );

  border:
    1px solid rgba(255,255,255,0.05);

  backdrop-filter:blur(10px);

  border-radius:24px;
}

/* TEXTO */

.texto{
  padding:2.2rem;
}

.texto h2{
  color:#f5e6c8;

  margin-bottom:1.5rem;

  letter-spacing:2px;
}

.texto p{
  color:#b8a98c;

  line-height:1.9;

  margin-bottom:1.3rem;
}

/* PAINEL */

.painel{
  display:flex;
  flex-direction:column;
  gap:1.5rem;
}

.janela{
  padding:1.8rem;
}

.janela span{
  display:block;

  margin-bottom:0.8rem;

  color:#8f7a53;

  font-size:0.7rem;

  letter-spacing:2px;

  text-transform:uppercase;
}

.janela strong{
  color:#f5e6c8;

  line-height:1.8;
}

/* BLOCO */

.bloco-principal{
  width:100%;
  max-width:1200px;

  margin-top:7rem;
}

.titulo{
  text-align:center;

  margin-bottom:3rem;
}

.titulo h2{
  color:#f5e6c8;

  letter-spacing:5px;

  margin-bottom:1rem;
}

.titulo p{
  color:#8d7b58;
}

/* CARDS */

.cards{
  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(260px,1fr));

  gap:1.5rem;
}

.card{
  padding:2rem;

  transition:0.4s;
}

.card:hover{
  transform:translateY(-8px);

  border-color:#d6b96b;
}

.card h3{
  color:#f5e6c8;

  margin-bottom:1rem;

  letter-spacing:2px;
}

.card p{
  color:#b8a98c;

  line-height:1.8;
}

/* EIXOS */

.eixos{
  width:100%;
  max-width:1100px;

  margin-top:7rem;
}

.grid-eixos{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;

  gap:1rem;
}

.eixo{
  padding:1rem 1.4rem;

  border-radius:999px;

  border:
    1px solid rgba(214,185,107,0.12);

  background:
    rgba(214,185,107,0.05);

  color:#dcc391;

  font-size:0.75rem;

  letter-spacing:1px;
}

/* JURÍDICO */

.juridico{
  width:100%;
  max-width:1000px;

  margin-top:7rem;
}

.manifesto-box{
  padding:3rem;

  text-align:center;
}

.manifesto-box h2{
  color:#f5e6c8;

  margin-bottom:2rem;

  letter-spacing:4px;
}

.manifesto-box p{
  color:#b7ab90;

  line-height:1.9;

  max-width:800px;

  margin:0 auto 1.5rem;
}

/* LINKS */

.links{
  margin-top:5rem;

  display:flex;
  gap:1.5rem;
  flex-wrap:wrap;

  justify-content:center;
}

.links a{
  text-decoration:none;

  padding:1rem 1.4rem;

  border-radius:999px;

  color:#f5e6c8;

  border:
    1px solid rgba(214,185,107,0.14);

  background:
    rgba(214,185,107,0.05);

  letter-spacing:2px;

  font-size:0.72rem;

  transition:0.35s;
}

.links a:hover{
  background:#d6b96b;
  color:black;

  transform:translateY(-3px);
}

/* GALERIA */

.galeria{
  width:100%;
  max-width:1200px;

  margin-top:7rem;
}

.grid-galeria{
  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(240px,1fr));

  gap:1rem;
}

.grid-galeria img{
  width:100%;
  height:260px;

  object-fit:cover;

  border-radius:18px;

  border:
    1px solid rgba(255,255,255,0.05);

  filter:
    grayscale(100%)
    brightness(0.82);

  transition:0.5s;
}

.grid-galeria img:hover{
  transform:scale(1.03);

  filter:
    grayscale(0%)
    brightness(1);
}

/* FLUXO */

.fluxo{
  max-width:900px;

  margin-top:6rem;

  text-align:center;
}

.fluxo p{
  color:#9f9173;

  line-height:1.9;

  margin-bottom:1.5rem;
}

.fluxo .destaque{
  color:#f5e6c8;

  font-size:1.3rem;
}

/* RODAPÉ */

.rodape{
  width:100%;

  margin-top:6rem;
  padding-top:3rem;

  border-top:
    1px solid rgba(255,255,255,0.06);

  display:flex;
  justify-content:center;
}

.assinatura-final{
  text-align:center;
}

.empresa{
  display:block;

  color:#f5e6c8;

  letter-spacing:4px;

  font-size:0.75rem;

  margin-bottom:0.8rem;
}

.assinatura-final p{
  color:#7d7156;

  font-size:0.72rem;

  letter-spacing:1px;
}

/* RESPONSIVO */

@media(max-width:900px){

  .intro{
    grid-template-columns:1fr;
  }

}

@media(max-width:700px){

  .player-cinema{
    width:180px;
    height:100px;
  }

  .voltar-flutuante{
    top:200px;
    right:14px;
  }

}

@media(max-width:500px){

  .player-cinema{
    position:relative;

    top:0;
    left:0;

    margin-bottom:2rem;
  }

  .voltar-flutuante{
    position:relative;

    top:0;
    right:0;

    margin-bottom:2rem;
  }

  .hero h1{
    letter-spacing:4px;
  }

}

</style>