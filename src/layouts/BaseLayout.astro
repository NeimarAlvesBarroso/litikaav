---
import Header from "../components/Header.astro";

interface Props{
  title?: string;
}

const {
  title = "Lítika AV"
} = Astro.props;
---

<!DOCTYPE html>

<html lang="pt-BR">

<head>

<meta charset="UTF-8" />

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
/>

<title>{title}</title>

<meta
name="description"
content="Lítika AV • Engenharia Cultural • Cinema • Ciência • Vetorialética"
/>

<link rel="icon" href="/favicon.svg" />

<meta
name="theme-color"
content="#000000"
/>

</head>

<body>

<Header />

<main>

<slot />

</main>

<div id="player-global">

<iframe

id="yt-player"

src="https://www.youtube.com/embed/MIj9bgsJgZY?enablejsapi=1&autoplay=1&mute=1&controls=0&loop=1&playlist=MIj9bgsJgZY"

allow="autoplay; encrypted-media"

allowfullscreen>

</iframe>

<button id="play-btn">

ATIVAR SOM

</button>

</div>

<script
src="https://www.youtube.com/iframe_api"
is:inline>
</script>

<script is:inline>

let player;

let ativo=false;

window.onYouTubeIframeAPIReady=function(){

player=new YT.Player("yt-player",{

events:{

onReady:(e)=>{

e.target.mute();

e.target.playVideo();

}

}

});

};

window.addEventListener("DOMContentLoaded",()=>{

const botao=document.getElementById("play-btn");

if(!botao) return;

botao.addEventListener("click",()=>{

if(!player) return;

if(!ativo){

player.unMute();

player.setVolume(60);

player.playVideo();

botao.textContent="SOM ATIVO";

ativo=true;

}else{

player.mute();

botao.textContent="ATIVAR SOM";

ativo=false;

}

});

});

</script>

</body>

</html>

<style is:global>

*{

margin:0;

padding:0;

box-sizing:border-box;

}

html{

scroll-behavior:smooth;

}

body{

background:#000;

color:#fff;

font-family:
Inter,
Segoe UI,
Arial,
sans-serif;

overflow-x:hidden;

}

main{

margin-top:72px;

min-height:100vh;

}

body::before{

content:"";

position:fixed;

inset:0;

pointer-events:none;

background:

radial-gradient(circle at center,
rgba(255,255,255,.03),
transparent 65%);

z-index:-1;

}

#player-global{

position:fixed;

left:20px;

bottom:20px;

display:flex;

flex-direction:column;

gap:10px;

z-index:9999;

opacity:.65;

transition:.35s;

}

#player-global:hover{

opacity:1;

transform:translateY(-2px);

}

#yt-player{

width:0;

height:0;

border:none;

pointer-events:none;

}

#play-btn{

padding:.75rem 1.3rem;

background:rgba(0,0,0,.65);

backdrop-filter:blur(12px);

border:1px solid rgba(255,255,255,.12);

border-radius:999px;

color:#d7b56d;

font-size:.72rem;

letter-spacing:2px;

cursor:pointer;

transition:.35s;

}

#play-btn:hover{

background:#d7b56d;

color:#000;

border-color:#d7b56d;

}

@media(max-width:768px){

main{

margin-top:66px;

}

#player-global{

left:10px;

bottom:10px;

}

#play-btn{

font-size:.65rem;

padding:.65rem 1rem;

}

}

</style>